    "test:all": "bun tools/workspace/cli.ts check",
    "lint": "bun tools/workspace/cli.ts lint",
    "fmt": "bun tools/workspace/cli.ts fmt",
    "format:check": "bun tools/workspace/cli.ts format:check",
    "typecheck": "bun tools/workspace/cli.ts typecheck",
    "workspace:plan": "bun tools/workspace/cli.ts plan",
    "workspace:test": "bun test tools/workspace",
    "workspace:typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@aphrody/runtime-sdk": "catalog:",
