{
  "name": "aphrody-py-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@aphrody/runtime-sdk": "file:.cache/yolo-packages/aphrody-runtime-sdk-0.1.0-c81812ea.tgz"
    }
  },
  "scripts": {
    "build": "bun tools/workspace/cli.ts build",
