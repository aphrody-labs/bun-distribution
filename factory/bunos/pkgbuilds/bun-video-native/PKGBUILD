# Native media adapter of @aphrody/bun-video, linked against system ffmpeg.
pkgname=bun-video-native
pkgver=0.1.0
pkgrel=1
_commit=46709d69939f8f348d06967a371925ce0d8d4fa8
pkgdesc='Bun video native adapter (libav through system ffmpeg)'
arch=('x86_64')
url='https://github.com/aphrody-labs/bun'
license=('MIT')
depends=('ffmpeg' 'glibc' 'gcc-libs')
makedepends=('git' 'rustup' 'clang' 'pkgconf')
options=('!lto' '!debug')
source=("bun::git+https://github.com/aphrody-labs/bun.git#commit=${_commit}"
        "bun-os::git+https://github.com/aphrody-labs/bun-distribution.git#commit=8229a6909216d3d38e7ada42dfc6c471b0237fbc")
sha256sums=('SKIP' 'SKIP')

build() {
  cd bun/packages/bun-video/native
  bash "$srcdir/bun-os/scripts/aphrody/build/rust/cargo-serial.sh" build --release --features libav
}

package() {
  cd bun/packages/bun-video/native
  install -Dm755 target/release/bun-video-native "$pkgdir/usr/lib/bun/bun-video-native"
  install -Dm755 target/release/libbun_video_native.so "$pkgdir/usr/lib/bun/libbun_video_native.so"
  install -Dm644 "$srcdir/bun/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
