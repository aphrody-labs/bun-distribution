{
  "schemaVersion": 1,
  "host": "vps",
  "distribution": "ubuntu",
  "series": "resolute",
  "architecture": "amd64",
  "abi": "gnu",
  "libc": "glibc",
  "minimumFreeBytes": 53687091200,
  "sourcePackages": ["apt", "dpkg", "livecd-rootfs", "ubuntu-meta", "linux"],
  "sourceComponents": ["main"],
  "sourcePockets": ["resolute", "resolute-updates", "resolute-security"],
  "packageBuilder": "sbuild",
  "rootfsBuilder": "live-build",
  "rootfsOverlay": "livecd-rootfs",
  "imageAssembler": "debian-cd",
  "dependencyResolver": "germinate",
  "sourceArchive": "https://archive.ubuntu.com/ubuntu",
  "securityArchive": "https://security.ubuntu.com/ubuntu",
  "keyring": "/usr/share/keyrings/ubuntu-archive-keyring.gpg",
  "jobDeadlineSeconds": 1200,
  "commandTimeoutSeconds": 180,
  "ubuntuImage": "ubuntu:26.04",
  "engineLifetimeSeconds": 21600,
  "toolchainTimeoutSeconds": 1800,
  "sharedHeavyLockRelative": "../locks/heavy.lock",
  "toolchainPackages": [
    "ca-certificates",
    "ubuntu-keyring",
    "apt",
    "dpkg-dev",
    "sbuild",
    "schroot",
    "debootstrap",
    "live-build",
    "livecd-rootfs",
    "germinate",
    "debian-cd",
    "xorriso",
    "squashfs-tools",
    "mtools",
    "dosfstools",
    "qemu-utils",
    "zstd",
    "fakeroot",
    "mmdebstrap",
    "uidmap"
  ],
  "references": [
    "https://ubuntu.com/project/docs/how-ubuntu-is-made/processes/image-builds/",
    "https://ubuntu.com/project/docs/contributors/building/build-packages-locally",
    "https://documentation.ubuntu.com/project/contributors/setup/get-the-source-of-a-package/",
    "https://documentation.ubuntu.com/project/contributors/setup/set-up-for-ubuntu-development/",
    "https://docs.docker.com/reference/cli/dockerd/#run-multiple-daemons"
  ],
  "packageBackend": "unshare",
  "packageUser": "ubuntu"
}
