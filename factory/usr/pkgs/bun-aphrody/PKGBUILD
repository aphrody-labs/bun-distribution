# SPDX-License-Identifier: MIT
# Bun OS runtime: the aphrody-labs/bun 1.4.4 fork (bun:python, Bun Shell) replacing extra/bun.
pkgname=bun-aphrody
pkgver=1.4.4
_tag=native-candidate-20261014-b2bcad9e46
_rev=b2bcad9e46d80efba97fb60ef454abc1ebba9290
pkgrel=1
pkgdesc="Bun OS JavaScript, TypeScript and Python runtime (aphrody-labs/bun fork)"
arch=(x86_64)
url="https://github.com/aphrody-labs/bun"
license=(MIT)
depends=(glibc)
optdepends=('python: CPython for bun:python and `bun app.py` (needs BUN_PYTHON_HOST_LIBRARY)')
provides=("bun=${pkgver}")
conflicts=(bun bun-bin)
replaces=(bun)
options=(!strip !debug)
source=("bun-linux-x64-${_tag}.tar.gz::${url}/releases/download/${_tag}/bun-linux-x64.tar.gz")
sha256sums=('f3b26a658539d7ee33ab049d6c357355b46a492492012c9d1a1db9d59d192b93')

check() {
  [ "$(bun-linux-x64/bun --version)" = "${pkgver}" ]
  bun-linux-x64/bun --revision | grep -q "+${_rev:0:9}"
}

package() {
  install -Dm755 bun-linux-x64/bun "${pkgdir}/usr/bin/bun"
  ln -s bun "${pkgdir}/usr/bin/bunx"
  install -Dm644 bun-linux-x64/LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  install -Dm644 bun-linux-x64/MULLVAD-LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/MULLVAD-LICENSE.md"
  install -Dm644 bun-linux-x64/MULLVAD-THIRD-PARTY.md "${pkgdir}/usr/share/licenses/${pkgname}/MULLVAD-THIRD-PARTY.md"
}
