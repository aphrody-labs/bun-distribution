# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: MIT
# bunos-alpine: minimal hardened Alpine + Bun (musl) for sites, servers and CDN edges.
# Targets: runtime (Bun.serve app server), edge (compiled cache/CDN binary). Multi-arch amd64/arm64.
ARG ALPINE_VERSION

FROM alpine:${ALPINE_VERSION} AS base
RUN apk add --no-cache tini libstdc++ libgcc ca-certificates \
  && addgroup -S -g 10001 bun && adduser -S -D -H -u 10001 -G bun -s /sbin/nologin bun

FROM base AS bun
ARG TARGETARCH
COPY --chmod=755 runtime/${TARGETARCH}/bun /usr/local/bin/bun
COPY runtime/${TARGETARCH}/receipt.json /usr/share/bun-os/runtime.receipt.json
RUN bun --version

FROM bun AS edge-build
WORKDIR /src
COPY app/ ./
RUN bun build --compile --minify --sourcemap=none --target=bun edge.ts --outfile /out/bunos-edge

# Hardened final layer: no package manager, non-root, read-only friendly.
FROM base AS root
RUN rm -rf /sbin/apk /etc/apk /lib/apk /usr/share/apk /var/cache/apk /usr/share/man /usr/share/doc \
  && install -d -o 10001 -g 10001 -m 0750 /app /var/cache/bunos

# Squash into one layer: removing files in a later layer would not shrink the image.
FROM scratch AS hardened
COPY --from=root / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin NODE_ENV=production PORT=8080
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/sbin/tini", "--"]

FROM hardened AS runtime
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --chown=10001:10001 app/server.ts app/healthcheck.ts /app/
USER 10001:10001
WORKDIR /app
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["bun", "/app/healthcheck.ts"]
CMD ["bun", "/app/server.ts"]

FROM hardened AS edge
COPY --from=edge-build /out/bunos-edge /usr/local/bin/bunos-edge
ENV CACHE_DIR=/var/cache/bunos
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD ["/usr/local/bin/bunos-edge", "--health"]
CMD ["/usr/local/bin/bunos-edge"]
