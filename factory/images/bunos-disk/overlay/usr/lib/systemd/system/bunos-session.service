[Unit]
Description=Bun OS session (gamescope console or Hyprland desktop, no display manager)
After=systemd-user-sessions.service systemd-logind.service getty@tty1.service bunos-firstboot.service
Wants=bunos-firstboot.service
Conflicts=getty@tty1.service
[Service]
User=bunos
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_CLASS=user XDG_SESSION_TYPE=wayland
ExecStart=/usr/lib/bun-os/bunos-session-select
Restart=always
RestartSec=3
[Install]
WantedBy=graphical.target
Alias=display-manager.service
