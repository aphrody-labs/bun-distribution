# gamescope-session-plus session definition for Bun OS (loaded by the ChimeraOS wrapper from
# factory/upstream/chimeraos-gamescope-session as `gamescope-session-plus bunos`).
# The Bun Engine library is the only full-screen client. Override per machine in
# /etc/gamescope-session-plus/sessions.d/bunos or ~/.config/gamescope-session-plus/sessions.d/bunos.
CLIENTCMD="bun-engine frontend --session"
