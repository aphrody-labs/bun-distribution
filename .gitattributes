# Bash operators must remain usable on WSL and SSH hosts after checkout.
scripts/**/*.sh text eol=lf
# Lockfiles are generated by bun, cargo and uv: never hand-merged, marked generated for review tools.
bun.lock linguist-generated=true
Cargo.lock linguist-generated=true
py/uv.lock linguist-generated=true
# Binary identity and icon assets.
*.ico binary
*.png binary
*.webp binary
*.icns binary
# PowerShell installers keep CRLF for Windows hosts; shell scripts stay LF (above).
*.ps1 text eol=crlf
