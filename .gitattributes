# Shell scripts retain LF across native, container and SSH checkouts.
*.sh text eol=lf
# Lockfiles are generated by bun, cargo and uv: never hand-merged, marked generated for review tools.
bun.lock linguist-generated=true
Cargo.lock linguist-generated=true
py/uv.lock linguist-generated=true
# Binary identity and icon assets.
*.ico binary
*.png binary
*.webp binary
*.icns binary
# PowerShell accepts LF; keep the repository source convention on every host.
*.ps1 text eol=lf
