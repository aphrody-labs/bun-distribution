  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "typecheck": "bun run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "deploy:vercel:preflight": "bun ../../scripts/rg/vercel-failover.ts preflight",
    "deploy:vercel": "bun ../../scripts/rg/vercel-failover.ts deploy",
    "ops:sync": "bun ../../scripts/ops/repo-sync.ts --repo all --pull --commit --push",
    "ops:sync:check": "bun ../../scripts/ops/repo-sync.ts --repo all --commit --dry-run --json",
    "infra:status": "bun ../../scripts/infra-status.ts status",
    "infra:inventory": "bun ../../scripts/infra-status.ts status --json --deep",
    "infra:plan": "bun ../../scripts/infra-status.ts plan",
    "website:dev": "bun --filter @rosegriffon/website dev",
    "images:compress": "bun scripts/ops/compress-images.ts",
    "cdn:invalidate": "bun ../../scripts/rg/invalidate-cdn.ts",
    "docs:map": "bun scripts/generate-repo-map.ts",
    "docs:bundle": "bun scripts/bundle-llms-docs.ts",
    "docs:check-links": "aphrody-ops docs-links --root .",
    "docs:check": "bun run docs:check-links",
    "docs:lint": "bunx markdownlint-cli2 \"docs/**/*.md\" \"plugins/**/*.md\" \"!docs/reference/**\"",
    "docs:build": "bun run docs:map && bun run docs:bundle && bun run docs:check-links && bun run docs:lint",
    "check:imports": "bun scripts/check-imports.ts",
    "achillea:contract": "bun --filter @rosegriffon/achillea-contract generate",
    "achillea:contract:check": "bun --filter @rosegriffon/achillea-contract check",
    "achillea:verify": "bun --filter @rosegriffon/achillea-types type-check && bun --filter @rosegriffon/achillea-types test && bun --filter @rosegriffon/achillea-core type-check && bun --filter @rosegriffon/achillea-core test && bun --filter @rosegriffon/achillea-client type-check && bun --filter @rosegriffon/achillea-client test && bun --filter @rosegriffon/achillea-contract type-check && bun --filter @rosegriffon/achillea-contract test && bun --filter @rosegriffon/achillea-contract check",
    "inagle:manifest:game-assets": "bun scripts/inagle/pipeline/generate-game-assets-manifest.ts"
  },
