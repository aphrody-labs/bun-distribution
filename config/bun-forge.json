{
  "schemaVersion": 1,
  "description": "bun-forge: builds the aphrody-labs/bun fork from a fresh Linux machine, one temporary checkout per commit of the watched branch. `main` is the fork single line: upstream oven-sh/bun main plus the Aphrody patches (absorbed modules). Embedded into the compiled executable; flags and BUN_FORGE_* variables override it.",
  "repository": "https://github.com/aphrody-labs/bun.git",
  "branch": "main",
  "profile": "release",
  "lto": true,
  "glibcCeiling": "2.39",
  "scratch": {
    "mode": "auto",
    "size": "96G"
  },
  "watch": {
    "intervalSeconds": 120,
    "everyCommit": true,
    "historyDepth": 200
  },
  "toolchain": {
    "llvm": {
      "major": 23,
      "version": "23.1.1",
      "url": "https://github.com/llvm/llvm-project/releases/download/llvmorg-{version}/LLVM-{version}-Linux-{arch}.tar.xz"
    },
    "cmake": {
      "minimum": "3.24.0",
      "version": "3.30.5",
      "url": "https://github.com/Kitware/CMake/releases/download/v{version}/cmake-{version}-linux-{arch}.tar.gz"
    },
    "rustup": {
      "version": "1.28.2",
      "url": "https://static.rust-lang.org/rustup/archive/{version}/{arch}-unknown-linux-gnu/rustup-init"
    },
    "apt": [
      "build-essential",
      "binutils",
      "ca-certificates",
      "ccache",
      "curl",
      "git",
      "golang",
      "libatomic1",
      "libtool",
      "make",
      "nasm",
      "perl",
      "pkg-config",
      "python3",
      "ruby",
      "unzip",
      "xz-utils"
    ],
    "binaries": ["cc", "c++", "make", "perl", "git", "strip", "tar", "xz"]
  }
}
