{
  "schemaVersion": 1,
  "repositoryDiscovery": {
    "superproject": "gitlinks-and-checked-out-repositories",
    "standaloneFallback": "infra-repository",
    "includeUnpinnedLocalCheckouts": true
  },
  "include": ["README.md", "AGENTS.md", "CLAUDE.md", "GEMINI.md", "docs", "scripts", "packages", "apps", "crates", "src", ".github/workflows", "package.json", "Cargo.toml", "pyproject.toml", "bun.lock", "Cargo.lock"],
  "exclude": [".git", "node_modules", "target", ".next", "dist", "build", ".turbo", ".cache", "var", "data", "assets", "public", "vendor", "vendors", "backups", "artifacts", ".env", ".env.*", "*.sqlite", "*.db", "*.dump", "*.sql", "*.pem", "*.key"],
  "outputs": ["repo-summary.json", "capabilities.json", "package-surface.json"],
  "privacy": "metadata-and-public-contracts-only"
}
