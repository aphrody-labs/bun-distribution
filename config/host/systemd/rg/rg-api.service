# rg-api.service — Rose Griffon unified API (Elysia + Kysely). Installed from an
# immutable RG release by scripts/atomic-deploy-rg.sh; never edit on the host.
[Unit]
Description=Rose Griffon unified API (Elysia + Kysely)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/rg/current/apps/bot
EnvironmentFile=/etc/rose-griffon/rg-api.env
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8800
ExecStart=/home/ubuntu/.bun/bin/bun src/index.ts api
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=mixed
ReadWritePaths=/tmp /var/www/rg-storage /var/www/cdn
MemoryHigh=2G
MemoryMax=4G
MemorySwapMax=1G
TasksMax=512
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rg-api

[Install]
WantedBy=multi-user.target
