# rg-storage.service — unified Storage API, reached through /storage/v1/.
# PG* are pinned here (formerly rg/infra/systemd/rg-storage.service.d/pg.conf):
# Bun auto-loads a .env.local from its working directory, whose PGDATABASE would
# otherwise override DATABASE_URL and send every object request to the wrong base.
[Unit]
Description=Rose Griffon unified Storage API (Bun)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/srv/rg/current
EnvironmentFile=/etc/rg-storage.env
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_STORAGE_HOST=127.0.0.1
Environment=RG_STORAGE_PORT=8810
Environment=RG_STORAGE_ROOT=/var/www/rg-storage
Environment=PGHOST=127.0.0.1
Environment=PGPORT=5432
Environment=PGUSER=rg
Environment=PGDATABASE=rg
ExecStart=/home/ubuntu/.bun/bin/bun apps/storage/server.ts
Restart=always
RestartSec=3s
UMask=0077
PrivateDevices=true
ReadWritePaths=/var/www/rg-storage /tmp
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=512M
MemoryMax=1G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rg-storage

[Install]
WantedBy=multi-user.target
