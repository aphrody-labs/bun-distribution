# shenron-cdn-sync — mirrors the public Shenron media of dbfr into /srv/shenron-cdn-src on the
# vps, then publishes the served CDN root /srv/shenron-cdn with scripts/release/cdn-optimize.ts:
# lossless, verified recompression (jpegtran, oxipng/zopflipng, gifsicle, cwebp lossless,
# ffmpeg faststart), brotli/gzip siblings for text and hardlinked duplicates. The mirror is
# never modified, so rsync's size/mtime checks stay exact; the optimizer manifest
# (/srv/shenron-cdn-state/manifest.sqlite) keeps hourly runs incremental.
#
# Pull over WireGuard (dbfr = 10.8.0.3) with the dedicated key /home/ubuntu/.ssh/shenron_cdn_pull:
# dbfr accepts it only from 10.8.0.1 and only as a read-only rsync rooted at /srv/shenron
# (ssh/shenron-cdn-pull.authorized_keys); its host key is pinned in
# /home/ubuntu/.ssh/shenron_cdn_known_hosts (ssh/shenron-cdn-known_hosts).
#
# Scope: wiki media, bot assets and generated public files only. Never databases
# (shared/bot/data), caches, logs or secrets. Deletions on dbfr are mirrored, at most 2000 per
# tree and run, so an emptied or unmounted source cannot wipe the CDN; the optimizer refuses an
# empty mirror and caps its own deletions the same way.
# Release files (site public/ and Next chunks) are seeded per release into the mirror, additive:
#   R=releases/<release-sha>/apps/shenron/site
#   rsync -rlt --safe-links --chmod=D755,F644 -e "$SSH" ubuntu@10.8.0.3:$R/public/ /srv/shenron-cdn-src/site/
#   rsync -rlt --safe-links --chmod=D755,F644 -e "$SSH" ubuntu@10.8.0.3:$R/.next-build/static/ /srv/shenron-cdn-src/_next/static/
#   then start this unit.
#
# Install (vps), from the Aphrody checkout:
#   sudo install -d -o ubuntu -g ubuntu -m 755 /srv/shenron-cdn /srv/shenron-cdn-src /srv/shenron-cdn-state
#   install -m 600 /dev/null ~/.ssh/shenron_cdn_known_hosts && cat config/host/ssh/shenron-cdn-known_hosts > ~/.ssh/shenron_cdn_known_hosts
#   ssh-keygen -t ed25519 -N "" -C shenron-cdn-pull@vps -f ~/.ssh/shenron_cdn_pull   (public half appended on dbfr)
#   tools: config/host/toolchain.json hostTools.vps (apt + cargo-binstall oxipng)
#   bun build --compile --target=bun-linux-x64 scripts/release/cdn-optimize.ts --outfile ~/.local/bin/aphrody-cdn-optimize
#   bun packages/engine/core/src/host/cli.ts compose-unit shenron-cdn-sync.service | sudo tee /etc/systemd/system/shenron-cdn-sync.service >/dev/null
#   bun packages/engine/core/src/host/cli.ts compose-unit shenron-cdn-sync.timer | sudo tee /etc/systemd/system/shenron-cdn-sync.timer >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now shenron-cdn-sync.timer
# Rollback: disable the timer; both trees only hold copies (the served one can be rebuilt with
# `cp -al /srv/shenron-cdn-src/. /srv/shenron-cdn/`).
[Unit]
Description=Shenron CDN: mirror public media from dbfr, publish the optimized tree
Wants=network-online.target
After=network-online.target wg-quick@wg0.service

[Service]
Type=oneshot
Environment="RSYNC_RSH=ssh -i /home/ubuntu/.ssh/shenron_cdn_pull -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/ubuntu/.ssh/shenron_cdn_known_hosts -o ConnectTimeout=10 -o ServerAliveInterval=30"
Environment=PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --delete-after --max-delete=2000 --delay-updates --partial-dir=.rsync-partial --info=stats1 ubuntu@10.8.0.3:shared/site/wiki/ /srv/shenron-cdn-src/wiki/
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --delete-after --max-delete=2000 --delay-updates --partial-dir=.rsync-partial --info=stats1 ubuntu@10.8.0.3:shared/bot/assets/ /srv/shenron-cdn-src/assets/
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --delete-after --max-delete=2000 --delay-updates --partial-dir=.rsync-partial --info=stats1 ubuntu@10.8.0.3:shared/site/public-extra/ /srv/shenron-cdn-src/site-extra/
ExecStart=/home/ubuntu/.local/bin/aphrody-cdn-optimize --src /srv/shenron-cdn-src --out /srv/shenron-cdn --state /srv/shenron-cdn-state/manifest.sqlite --report /srv/shenron-cdn-state/last-report.json --max-delete 2000
# The first optimization recompresses ~31 GiB; later runs only touch changed files.
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=idle
ReadWritePaths=/srv/shenron-cdn /srv/shenron-cdn-src /srv/shenron-cdn-state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-cdn-sync
