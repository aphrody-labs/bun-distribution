# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron Discord gateway container
Requires=docker.service shenron-site-docker.service
After=docker.service shenron-site-docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/shenron/current
EnvironmentFile=/srv/shenron/current/deploy.env
ExecStart=/usr/bin/docker compose -f /srv/shenron/current/compose.yaml up -d --no-build bot
ExecStop=/usr/bin/docker compose -f /srv/shenron/current/compose.yaml stop bot
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
