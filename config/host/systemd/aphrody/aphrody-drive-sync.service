# SPDX-License-Identifier: Apache-2.0
# Native Yolo Google owner and Workspace sync worker, on the VPS independently of WSL.
[Unit]
Description=Private DBFR Drive sync and retrieval on the Aphrody VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/aphrody-lab
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=APHRODY_GOOGLE_DRIVE_AUTH=service-account
Environment=APHRODY_GOOGLE_SERVICE_ACCOUNT_JSON=/home/ubuntu/.aphrody/private/google/aphrody-bot.json
ExecStartPre=/home/ubuntu/.bun/bin/bun -e "import { mkdirSync } from 'node:fs'; mkdirSync('/home/ubuntu/.aphrody/workspaces/dbfr', { recursive: true, mode: 0o700 });"
ExecStart=/home/ubuntu/.bun/bin/bun /srv/aphrody-lab/agent-sync.mjs --config /srv/aphrody-lab/drive-sync-policy.json --apply
TimeoutStartSec=400
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/.bun/bin/bun /home/ubuntu/.local/bin/aphrody
BindReadOnlyPaths=/home/ubuntu/.ssh
BindPaths=/home/ubuntu/.aphrody
ReadWritePaths=/home/ubuntu/.aphrody /srv/aphrody-lab/state
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=512M
MemoryMax=1G
TasksMax=128
Nice=10
StandardOutput=journal
StandardError=journal
