# SPDX-License-Identifier: Apache-2.0
# Aphrody download server (downloads.aphrody.com, aphrody.com): read-only Bun.serve over the published
# release tree. Source: apps/web/downloads/src/server.ts (installed as /srv/aphrody-downloads/app/server.ts).
# Release tree: /srv/aphrody-downloads/releases/<id>, `current` is flipped by scripts/release/publish-downloads.ts.
# Port 8797 is loopback only; nginx (nginx/aphrody/downloads.aphrody.com.conf) is the single public entry.
[Unit]
Description=Aphrody download server (downloads.aphrody.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/aphrody-downloads/app
Environment=DOWNLOADS_ROOT=/srv/aphrody-downloads/current
Environment=DOWNLOADS_PORT=8797
Environment=DOWNLOADS_HOST=127.0.0.1
ExecStart=/home/ubuntu/.bun/bin/bun /srv/aphrody-downloads/app/server.ts
Restart=always
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadOnlyPaths=/srv/aphrody-downloads
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aphrody-downloads

[Install]
WantedBy=multi-user.target
