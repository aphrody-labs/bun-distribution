# Managed by aphrody-infra; dedicated development Discord application.
[Unit]
Description=Aphrody Discord development gateway and HTTP interactions endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/aphrody-discord/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/aphrody-discord.env
ExecStart=/home/ubuntu/.bun/bin/bun /srv/aphrody-discord/current/server.js
Environment=HOME=/srv/aphrody-discord/shared
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
MemoryDenyWriteExecute=false
ReadWritePaths=/srv/aphrody-discord/shared
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aphrody-discord-dev

[Install]
WantedBy=multi-user.target
