# SPDX-License-Identifier: Apache-2.0
# Aphrody A2A 1.0 server (`aphrody a2a serve`): agent card, /ping, /msg, JSON-RPC, HTTP+JSON and SSE over the coord
# mailbox. Catalog entry `aphrody-a2a` (config/service-catalog.json), vps.
# Loopback only: 127.0.0.1:8788, never proxied by nginx, never published (the former public routes of aphrody.com stay
# retired). The agent card announces http://127.0.0.1:8788.
# `aphrody a2a serve` walks up from its working directory to find ai.json: /srv/aphrody/shared/a2a/ai.json is a copy
# of the repository ai.json at the deployed revision (host-plan step), no longer the retired /srv/aphrody/current link.
# State: --coord-dir /srv/aphrody/shared/coord (messages.jsonl, tasks.json), kept across restarts and reinstalls.
# APHRODY_A2A_DRY_RUN=1: a message is recorded and answered but no peer agent CLI (codex, claude, agy) is spawned on
# the host; lifting it is an owner decision. Optional settings (names in config/secrets-contract.json, for example
# APHRODY_A2A_COORD_TOKEN guarding the task API): /etc/aphrody/aphrody-a2a.env, absent by default.
[Unit]
Description=Aphrody A2A server (aphrody a2a serve, 127.0.0.1:8788, loopback only)
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
WorkingDirectory=/srv/aphrody/shared/a2a
Environment=HOME=/srv/aphrody/shared/a2a
Environment=APHRODY_A2A_DRY_RUN=1
Environment=RUST_LOG=aphrody_a2a_coord=info
EnvironmentFile=-/etc/aphrody/aphrody-a2a.env
ExecStart=/home/ubuntu/.local/bin/aphrody a2a serve --bind 127.0.0.1:8788 --coord-dir /srv/aphrody/shared/coord
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

MemoryAccounting=true
MemoryHigh=512M
MemoryMax=1G
TasksMax=256
LimitNOFILE=16384
CPUWeight=50
Nice=5

# Sandbox, on top of the run-as-ubuntu, sandbox-base, sandbox-kernel, net-inet-only and syscall-service drop-ins.
# /home is an empty tmpfs: only the binary is mapped in (read-only); the writable paths are the A2A working
# directory and the coord mailbox.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/.local/bin/aphrody
ReadWritePaths=/srv/aphrody/shared/a2a /srv/aphrody/shared/coord
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/var/lib/lxd -/run/user
ProtectProc=invisible
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aphrody-a2a

[Install]
WantedBy=multi-user.target
