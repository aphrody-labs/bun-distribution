# bot.dragonballfr.com — API publique de Shenron (REST/GraphQL/OpenAPI),
# process unique avec le bot Discord (unité shenron-bot.service, :5006).
# Traduit de shenron/deploy/nginx/bot.dragonballfr.com.conf.
# Route déclarée dans config/nginx-routes.json ("shenron-bot" — anciennement
# "shenron-api", fusionné : voir docs/SHENRON-MIGRATION.md).

upstream shenron_bot {
    server 127.0.0.1:5006;
    keepalive 32;
}

server {
    listen 80;
    server_name bot.dragonballfr.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    server_name bot.dragonballfr.com;

    ssl_certificate     /etc/letsencrypt/live/bot.dragonballfr.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.dragonballfr.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL_botdbfr:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # CORS — site (dragonballfr.com) et clients navigateur (fetch /api/canvas
    # en <img>/JS). Adapter la liste si de nouveaux hôtes front rejoignent le plan.
    set $shenron_cors_origin "";
    if ($http_origin ~* "^https://(dragonballfr\.com|[a-z0-9-]+\.dragonballfr\.com)$") { set $shenron_cors_origin $http_origin; }
    add_header Access-Control-Allow-Origin $shenron_cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;
    add_header Access-Control-Max-Age 86400 always;
    if ($request_method = OPTIONS) { return 204; }

    location ~* "\.(env|git/|aws/|ssh/|sql|bak|old|swp|DS_Store)$" { return 410; }

    access_log /var/log/nginx/bot-dragonballfr-access.log;
    error_log  /var/log/nginx/bot-dragonballfr-error.log warn;
    # 60m : marge au-dessus du plafond applicatif d'upload d'images wiki (50 Mo).
    client_max_body_size 60m;

    # Canvas (Skia) — timeout étendu + cache court.
    location ~ "^/api/canvas/" {
        limit_req zone=rpb_api burst=20 nodelay;
        proxy_pass http://shenron_bot;
        include snippets/proxy-upstream.inc;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_cache_valid 200 60s;
    }

    # Assets statiques (images/fonts/banners) — cache long côté proxy, le bot
    # (Bun.serve) renvoie `no-cache, must-revalidate` inadapté à un cache public.
    location /assets/ {
        proxy_pass http://shenron_bot;
        include snippets/proxy-upstream.inc;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
        proxy_cache shenron_static;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
        proxy_cache_bypass $bypass_user_cache;
        proxy_no_cache $bypass_user_cache;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
        add_header Access-Control-Allow-Origin $shenron_cors_origin always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Playlists et segments HLS générés par le bot, mis en cache avec des TTL distincts.
    location ~ "^/api/hls/[^/]+/master\.m3u8$" {
        limit_req zone=rpb_api burst=20 nodelay;
        proxy_pass http://shenron_bot;
        include snippets/proxy-upstream.inc;
        proxy_set_header Authorization $http_authorization;
        proxy_cache shenron_hls;
        proxy_cache_key "$scheme$host$uri$is_args$args";
        proxy_cache_valid 200 10s;
        proxy_cache_lock on;
        proxy_cache_bypass $bypass_user_cache;
        proxy_no_cache $bypass_user_cache;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "public, max-age=10, stale-while-revalidate=60" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location ~ "^/api/hls/[^/]+/seg$" {
        proxy_pass http://shenron_bot;
        include snippets/proxy-upstream.inc;
        proxy_set_header Authorization $http_authorization;
        proxy_cache shenron_hls;
        proxy_cache_key "$scheme$host$uri$is_args$args";
        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_bypass $bypass_user_cache;
        proxy_no_cache $bypass_user_cache;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "public, max-age=86400, immutable" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Vidéos/médias du wiki, servis directement par nginx (range/streaming)
    # depuis le stockage partagé Shenron (/srv/shenron/shared/site/wiki : hors
    # release, conservé d'une release à l'autre, jamais un chemin maison).
    location ^~ /wiki/ {
        root /srv/shenron/shared/site;
        types {
            video/mp4 mp4;
            image/webp webp;
            image/png png;
            image/jpeg jpg jpeg;
            image/gif gif;
        }
        default_type application/octet-stream;
        # Pas de `always` : le cache-control long ne s'applique qu'aux 2xx/3xx.
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=2592000";
        add_header Access-Control-Allow-Origin $shenron_cors_origin always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Accept-Ranges bytes always;
        try_files $uri =404;
    }

    # Tout le reste → bot (API publique + admin Bearer).
    location / {
        limit_req zone=rpb_api burst=50 nodelay;
        proxy_pass http://shenron_bot;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        include snippets/proxy-client-ip.inc;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }
}
