# dragonballfr.com — site Next.js Shenron, servi par `next start` sous Bun sur
# 127.0.0.1:5011 (unité shenron-site.service). Traduit de
# shenron/deploy/nginx/dragonballfr.com.conf : pas de bascule bleu/vert
# (upstream fixe, la bascule de release est portée par le lien
# `/srv/shenron/current`, pas par un fichier d'upstream généré) ; la page 50x de
# marque et les règles de cache sont conservées.
# Route déclarée dans config/nginx-routes.json ("shenron-site").

upstream shenron_site {
    server 127.0.0.1:5011;
    keepalive 64;
    keepalive_timeout 60s;
    keepalive_requests 1000;
}

# ── apex :80 — ACME + redirection HTTPS ─────────────────────────────────────
server {
    listen 80;
    server_name dragonballfr.com www.dragonballfr.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://dragonballfr.com$request_uri; }
}

# ── www :443 — 301 vers l'apex (canonique) ──────────────────────────────────
server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    server_name www.dragonballfr.com;

    ssl_certificate     /etc/letsencrypt/live/dragonballfr.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dragonballfr.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL_dbfr:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    return 301 https://dragonballfr.com$request_uri;
}

# ── apex :443 — site Next.js ────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    server_name dragonballfr.com;

    ssl_certificate     /etc/letsencrypt/live/dragonballfr.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dragonballfr.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL_dbfr:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/dragonballfr-access.log;
    error_log  /var/log/nginx/dragonballfr-error.log warn;

    # Éditeur wiki-admin (upload images, multipart et base64 dans le JSON).
    client_max_body_size 60m;

    # Sondes scanners → 410 (le site ne sert aucun de ces chemins).
    location ~* "\.(env|git/|aws/|ssh/|sql|bak|old|swp|DS_Store)$" { return 410; }

    # Page d'erreur de marque servie PAR NGINX quand l'upstream est injoignable
    # (redémarrage shenron-site, stall mémoire, timeout) ou en maintenance.
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        root /var/www/shenron;
        internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Retry-After "10" always;
    }

    # Aperçu public de la page de maintenance / déploiement.
    location = /maintenance {
        alias /var/www/shenron/50x.html;
        default_type text/html;
        add_header Cache-Control "no-store" always;
    }

    # Assets buildés immutables — Next pose déjà Cache-Control immutable.
    location /_next/static/ {
        proxy_pass http://shenron_site;
        include snippets/proxy-upstream.inc;
        proxy_buffering on;
        proxy_cache shenron_static;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_bypass $bypass_user_cache;
        proxy_no_cache $bypass_user_cache;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Optimiseur d'images Next (next/image).
    location /_next/image {
        proxy_pass http://shenron_site;
        include snippets/proxy-upstream.inc;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_cache shenron_images;
        proxy_cache_key "$scheme$request_method$host$uri$is_args$args$http_accept";
        proxy_cache_valid 200 7d;
        proxy_cache_lock on;
        proxy_cache_bypass $bypass_user_cache;
        proxy_no_cache $bypass_user_cache;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Routes API + auth Next (better-auth, telemetry, chat LLM streaming…).
    location /api/ {
        limit_req zone=rpb_api burst=30 nodelay;
        proxy_pass http://shenron_site;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        include snippets/proxy-client-ip.inc;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # Pages (SSR/ISR/RSC streaming) → Next. X-Forwarded-Proto https est REQUIS
    # pour que better-auth pose des cookies `Secure` et garde l'OAuth en https.
    location / {
        proxy_pass http://shenron_site;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        include snippets/proxy-client-ip.inc;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    open_file_cache max=10000 inactive=30s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors on;
}
