# cdn.dragonballfr.com — hôte d'assets Shenron, co-localisé avec le site sur le VPS.
#
# Décision (2026-09-23, restauration Shenron) : route Shenron dédiée plutôt que
# réutilisation de rg-cdn. Le site est construit avec
# NEXT_PUBLIC_CDN_URL / NEXT_PUBLIC_SHENRON_ASSETS_URL = https://cdn.dragonballfr.com
# (valeurs inlinées au build), le DNS pointe déjà le VPS et le certificat y
# existe. Route déclarée dans config/nginx-routes.json ("shenron-cdn").
#
# - `/_next/*` réutilise l'upstream `shenron_site` (127.0.0.1:5011) déclaré par
#   nginx/shenron/dragonballfr.com.conf.example et les zones de
#   nginx/shenron/00-shenron-cache.conf.example ;
# - les médias mutables vivent hors release dans le stockage partagé
#   `/srv/shenron/shared/{site/wiki,bot/assets}` (une bascule de release ne
#   perd jamais un upload).

server {
    listen 80;
    server_name cdn.dragonballfr.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen 443 quic;
    http2 on;
    server_name cdn.dragonballfr.com;

    ssl_certificate     /etc/letsencrypt/live/cdn.dragonballfr.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cdn.dragonballfr.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL_cdn_dbfr:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    access_log /var/log/nginx/cdn-dragonballfr-access.log;
    error_log  /var/log/nginx/cdn-dragonballfr-error.log warn;

    location ~* "\.(env|git/|aws/|ssh/|sql|bak|old|swp|DS_Store)$" { return 410; }

    # Wiki uploads, served directly with Range support.
    location ^~ /assets/wiki/ {
        alias /srv/shenron/shared/site/wiki/;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800";
        add_header Access-Control-Allow-Origin "*" always;
        add_header Accept-Ranges bytes always;
    }

    # Bot assets served directly: no Bun load.
    location /assets/ {
        alias /srv/shenron/shared/bot/assets/;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Accept-Ranges bytes always;
    }

    # Clips and illustrations, native Range support.
    location ^~ /wiki/ {
        root /srv/shenron/shared/site;
        types {
            video/mp4 mp4;
            image/webp webp;
            image/png png;
            image/jpeg jpg jpeg;
            image/gif gif;
        }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=604800, stale-while-revalidate=2592000";
        add_header Access-Control-Allow-Origin "*" always;
        add_header Accept-Ranges bytes always;
        try_files $uri =404;
    }

    # Next build chunks: cacheable, no site route exposed.
    location /_next/static/ {
        proxy_pass http://shenron_site;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host dragonballfr.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering on;
        proxy_cache shenron_static;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Next image optimizer: key varies with params and Accept (AVIF/WebP);
    # App Router pages are never cached here.
    location /_next/image {
        proxy_pass http://shenron_site;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host dragonballfr.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_buffering on;
        proxy_cache shenron_images;
        proxy_cache_key "$scheme$request_method$host$uri$is_args$args$http_accept";
        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location = /health { return 200 "cdn ok\n"; }
    location = /api/health {
        proxy_pass http://shenron_site/api/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host dragonballfr.com;
    }
    location / { return 404; }
}
