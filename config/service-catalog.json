{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "supervisor": "systemd",
  "proxy": "nginx",
  "services": [
    {
      "id": "aphrody-fonts-proxy",
      "application": "aphrody-google",
      "kind": "bun-edge-proxy",
      "runtime": "bun",
      "unit": "aphrody-fonts-proxy.service",
      "health": "http://127.0.0.1:8796/health",
      "port": 8796,
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody-cdn/app",
      "publicProxy": "nginx",
      "public": true
    },
    {
      "id": "aphrody-downloads",
      "application": "aphrody",
      "kind": "bun-download-server",
      "runtime": "bun",
      "unit": "aphrody-downloads.service",
      "health": "http://127.0.0.1:8797/health",
      "port": 8797,
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody-downloads/app",
      "releaseRoot": "/srv/aphrody-downloads/releases",
      "publicProxy": "nginx",
      "note": "read-only download site (index, latest.json, SHA256SUMS, install.sh, install.ps1, artifacts): public and unauthenticated by design, it serves published checksummed release files only; published by scripts/release/publish-downloads.ts from config/downloads.json (docs/operations/infra/DOWNLOADS.md)",
      "public": true
    },
    {
      "id": "aphrody-creator",
      "unitSource": "system-package",
      "application": "aphrody",
      "kind": "nginx-static",
      "runtime": "none",
      "unit": "nginx.service",
      "sourceRepo": "aphrody",
      "releaseRoot": "/srv/aphrody-creator/releases",
      "publicProxy": "nginx",
      "note": "static download page of creator-kit (Material 3 page, latest.json, packs) served by nginx from /srv/aphrody-creator/current, no application origin and no unit; public and unauthenticated by design, published by scripts/release/publish-creator.ts (docs/operations/infra/CREATOR.md)",
      "public": true
    },
    {
      "id": "aphrody-llama-gemma4",
      "application": "aphrody",
      "kind": "llama-server-openai",
      "runtime": "native",
      "unit": "aphrody-llama-gemma4.service",
      "health": "http://127.0.0.1:8798/health",
      "port": 8798,
      "capabilities": ["chat"],
      "sourceRepo": "aphrody",
      "workingDirectory": "/home/ubuntu/.aphrody/runtimes/llama-b11415",
      "model": {
        "catalogId": "gemma-4-e2b-it-q4km",
        "alias": "gemma4-e2b",
        "ref": "hf:unsloth/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q4_K_M.gguf@0314792d7f1f7e229411f620751375812bb9faf2",
        "sha256": "740185b21d22ceb83a11c3aa62ad5842ef32c70f6096d756bbee85a1e4ec34b8"
      },
      "note": "Gemma 4 E2B IT preloaded (weights locked in RAM) by upstream llama.cpp b11415, OpenAI-compatible /v1 on loopback only, never proxied by nginx; consumers on the vps (shenron-site, shenron-bot) read APHRODY_AI_CHAT_BASE_URL=http://127.0.0.1:8798/v1 and APHRODY_AI_CHAT_MODEL=gemma4-e2b. Weights pulled by `aphrody model pull gemma-4-e2b-it-q4km`; unit config/host/systemd/aphrody/aphrody-llama-gemma4.service",
      "public": false
    },
    {
      "id": "aphrody-llama-shenron-chat",
      "application": "aphrody",
      "kind": "llama-server-openai",
      "runtime": "native",
      "unit": "aphrody-llama-shenron-chat.service",
      "health": "http://127.0.0.1:8799/health",
      "port": 8799,
      "capabilities": ["chat"],
      "sourceRepo": "aphrody",
      "workingDirectory": "/home/ubuntu/.aphrody/runtimes/llama-b11415",
      "model": {
        "catalogId": "qwen3-4b-instruct-2507-q4km+lora",
        "alias": "shenron-chat-v2",
        "ref": "hf:unsloth/Qwen3-4B-Instruct-2507-GGUF/Qwen3-4B-Instruct-2507-Q4_K_M.gguf@a06e946bb6b655725eafa393f4a9745d460374c9",
        "sha256": "3605803b982cb64aead44f6c1b2ae36e3acdb41d8e46c8a94c6533bc4c67e597"
      },
      "note": "Fine-tuned shenron-chat-v2 (Qwen3-4B-Instruct-2507 Q4_K_M + LoRA GGUF adapter, sha256 aab485357c68fdcbb6d4ba55911632b8228964106047db035e0223e2aecc6107) by upstream llama.cpp b11415, OpenAI-compatible /v1 on loopback only, never proxied by nginx; consumers on the vps read APHRODY_AI_CHAT_BASE_URL=http://127.0.0.1:8799/v1 and APHRODY_AI_CHAT_MODEL=shenron-chat-v2, fallback gemma4 (APHRODY_AI_CHAT_BASE_URL=http://127.0.0.1:8798/v1, APHRODY_AI_CHAT_MODEL=gemma4-e2b). Adapter at /home/ubuntu/.aphrody/models/adapters/shenron-chat-v2/adapter.gguf; unit config/host/systemd/aphrody/aphrody-llama-shenron-chat.service; see docs/operations/infra/LLAMA-MODELS.md",
      "public": false
    },
    {
      "id": "aphrody-discord-dev",
      "application": "aphrody-discord",
      "kind": "discord-interactions-and-gateway",
      "runtime": "bun",
      "unit": "aphrody-discord-dev.service",
      "health": "http://127.0.0.1:4010/healthz",
      "port": 4010,
      "sourceRepo": "aphrody-discord",
      "workingDirectory": "/srv/aphrody-discord/current",
      "releaseRoot": "/srv/aphrody-discord/releases",
      "publicProxy": "nginx",
      "public": true
    },
    {
      "id": "aphrody-site",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-site.service",
      "health": "http://127.0.0.1:8083/healthz",
      "sourceRepo": "aphrody-web",
      "workingDirectory": "/srv/aphrody/current",
      "releaseRoot": "/srv/aphrody/releases",
      "public": true,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-web-api",
      "application": "aphrody",
      "kind": "bun-http",
      "runtime": "bun",
      "unit": "aphrody-web-api.service",
      "health": "http://127.0.0.1:3007/health",
      "sourceRepo": "aphrody-web",
      "workingDirectory": "/srv/aphrody/current",
      "publicProxy": "aphrody-site",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-ai-http",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-ai-http.service",
      "health": "http://127.0.0.1:8789/healthz",
      "port": 8789,
      "capabilities": ["ai-http"],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "publicProxy": "nginx",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25",
      "note": "same server as aphrody-mcp-http (`aphrody-mcp http`). On the vps 127.0.0.1:8789 stays the loopback end of the WSL compute reverse tunnel (aphrody-compute-vps-tunnel), which the Shenron site and bot read: nothing else binds it"
    },
    {
      "id": "aphrody-mcp-http",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-mcp-http.service",
      "health": "http://127.0.0.1:8793/healthz",
      "port": 8793,
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody/shared/agent-workspaces/aphrody",
      "public": false,
      "note": "MCP Streamable HTTP of `aphrody-mcp http` (toolbox build), loopback only and never proxied (the binary refuses a non-loopback bind). /mcp requires `Authorization: Bearer` (APHRODY_MCP_HTTP_TOKEN, generated on the host in /etc/aphrody/aphrody-mcp-http.env, constant-time comparison, 503 without a token); /healthz needs none. Port 8793, not 8789: the vps keeps 8789 for the WSL compute tunnel. Runbook: docs/operations/infra/MCP-A2A.md; unit config/host/systemd/aphrody/aphrody-mcp-http.service"
    },
    {
      "id": "aphrody-shenron-embed",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-shenron-embed.service",
      "health": "http://127.0.0.1:8794/health",
      "port": 8794,
      "capabilities": ["embed"],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-a2a",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-a2a.service",
      "health": "http://127.0.0.1:8788/ping",
      "port": 8788,
      "capabilities": ["a2a"],
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody/shared/agent-workspaces/aphrody",
      "a2a": {
        "registry": "config/a2a-peers.json",
        "peer": "aphrody",
        "rpcPath": "/",
        "agentCardPath": "/.well-known/agent-card.json"
      },
      "public": false,
      "note": "Persistent native A2A service on loopback 8788, authenticated private routes (APHRODY_A2A_COORD_TOKEN), dedicated main checkout and existing Codex authentication. Protocol tasks/results remain in /srv/aphrody/shared/coord/a2a/tasks across client disconnects and service reconstruction; interrupted coding tasks are not replayed on restart. Canonical MCP child is available. Runbook: docs/operations/infra/MCP-A2A.md."
    },
    {
      "id": "shenron-site",
      "application": "shenron",
      "kind": "next-bun-http",
      "runtime": "bun",
      "unit": "shenron-site.service",
      "health": "http://127.0.0.1:5011/api/health",
      "readiness": "http://127.0.0.1:5011/api/health/ready",
      "port": 5011,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current/apps/site",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "Next.js site: /api/health (liveness), /api/health/live (alias) and /api/health/ready (readiness)",
      "public": true
    },
    {
      "id": "shenron-mcp",
      "application": "aphrody",
      "kind": "bun-mcp-http",
      "runtime": "bun",
      "unit": "shenron-mcp.service",
      "health": "http://127.0.0.1:5010/health",
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "releaseRoot": "/srv/aphrody/releases",
      "publicProxy": "nginx",
      "a2a": {
        "registry": "config/a2a-peers.json",
        "peer": "shenron",
        "rpcPath": "/a2a",
        "agentCardPath": "/.well-known/agent-card.json"
      },
      "public": true,
      "status": "retired",
      "retiredAt": "2026-09-25",
      "supersededBy": "shenron-mcp dragonball.* tools in aphrody-labs/shenron (crates/shenron-mcp, served by the Shenron plugin; aphrody-ai d0cb59d deleted apps/shenron-mcp, its systemd unit and mcp.dragonballfr.com vhost template)"
    },
    {
      "id": "shenron-bot",
      "application": "shenron",
      "kind": "discord-bot-and-api",
      "runtime": "bun",
      "unit": "shenron-bot.service",
      "health": "http://127.0.0.1:5006/health",
      "port": 5006,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current/apps/bot",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "single Bun process (discordx + Bun.serve REST/GraphQL/OpenAPI); no separate shenron-api.service, see docs/reference/infra/SHENRON-MIGRATION.md",
      "public": true
    },
    {
      "id": "shenron-mcp-http",
      "application": "shenron",
      "kind": "rust-mcp-http",
      "runtime": "native",
      "unit": "shenron-mcp-http.service",
      "health": "http://127.0.0.1:8790/health",
      "port": 8790,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "crates/shenron-mcp --http 127.0.0.1:8790 --public (read-only tools, the binary default address), shipped in the Shenron release as bin/shenron-mcp; the site relays https://dragonballfr.com/mcp to it through SHENRON_MCP_URL. Supersedes the retired Bun shenron-mcp (5010)",
      "public": false
    },
    {
      "id": "shenron-pg-tunnel",
      "application": "shenron",
      "kind": "ssh-tunnel",
      "runtime": "native",
      "unit": "shenron-pg-tunnel.service",
      "health": "tcp://127.0.0.1:15433",
      "target": "dbfr:127.0.0.1:5432",
      "note": "private PostgreSQL path VPS -> dbfr (shenron_site); 5432 never public, see docs/reference/infra/SHENRON-MIGRATION.md",
      "public": false
    },
    {
      "id": "shenron-redis",
      "unitSource": "system-package",
      "application": "shenron",
      "kind": "cache",
      "runtime": "redis",
      "unit": "redis-server.service",
      "host": "dbfr",
      "health": "tcp://127.0.0.1:16379",
      "target": "dbfr:127.0.0.1:6379",
      "note": "Private Redis for Shenron live RAG qualification; forwarded with shenron-pg-tunnel by the Infra tunnel owner",
      "public": false
    },
    {
      "id": "shenron-backup",
      "application": "shenron",
      "kind": "backup",
      "runtime": "native",
      "unit": "shenron-backup.timer",
      "public": false
    },
    {
      "id": "shenron-neon-pull",
      "application": "shenron",
      "kind": "replica-sync",
      "runtime": "bun",
      "unit": "shenron-neon-pull.timer",
      "note": "every 15 min: apps/bot/scripts/sync-neon-to-sqlite.ts of /srv/shenron/current refreshes /srv/shenron/shared/bot/data/bot.db from PostgreSQL (never empties a table without --allow-empty)",
      "public": false
    },
    {
      "id": "shenron-container-backup",
      "application": "shenron",
      "kind": "backup",
      "runtime": "native",
      "unit": "shenron-container-backup.timer",
      "host": "dbfr",
      "public": false,
      "note": "Daily container-owned PostgreSQL, Redis and live SQLite snapshots, integrity/checksum-verified; protected under /srv/shenron/shared/backups/container."
    },
    {
      "id": "aphrody-mcp-http-dbfr",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-mcp-http-dbfr.service",
      "health": "http://127.0.0.1:8793/healthz",
      "port": 8793,
      "sourceRepo": "aphrody",
      "workingDirectory": "/home/ubuntu/.aphrody",
      "public": false,
      "note": "DBFR canonical native MCP with jobs enabled, protected host-local bearer, loopback127.0.0.1:8793. Private WireGuard projection must bind DBFR address10.200.77.3, never the VPS hub address. Activation requires qualified jobs binary and authentication probes.",
      "host": "dbfr"
    },
    {
      "id": "aphrody-jobs-worker-vps",
      "application": "aphrody",
      "kind": "rust-worker",
      "runtime": "rust",
      "unit": "aphrody-jobs-worker-vps.service",
      "sourceRepo": "aphrody",
      "workingDirectory": "/home/ubuntu/.aphrody",
      "public": false,
      "host": "vps",
      "note": "Persistent local SQLite queue with fenced leases, capability filtering and bounded native web-pipeline/transcribe handlers. Inputs and credentials remain in protected host stores; no training role or network transport is granted."
    },
    {
      "id": "aphrody-jobs-worker-dbfr",
      "application": "aphrody",
      "kind": "rust-worker",
      "runtime": "rust",
      "unit": "aphrody-jobs-worker-dbfr.service",
      "sourceRepo": "aphrody",
      "workingDirectory": "/home/ubuntu/.aphrody",
      "public": false,
      "host": "dbfr",
      "note": "Persistent local SQLite queue with fenced leases, capability filtering and bounded native web-pipeline/transcribe handlers. Inputs and credentials remain in protected host stores; no training role or network transport is granted."
    }
  ],
  "policies": {
    "oneUnitPerWorkload": true,
    "onePublicProxy": true,
    "releasePlanes": {
      "aphrody": {
        "current": "/srv/aphrody/current",
        "adapter": "scripts/release/atomic-deploy-aphrody-stack.sh"
      },
      "shenron": {
        "current": "/srv/shenron/current",
        "adapter": "scripts/release/atomic-deploy-shenron.sh"
      },
      "bundle": {
        "root": "/srv/aphrody-infra",
        "adapter": "scripts/release/atomic-deploy-bundle.sh",
        "order": ["aphrody", "shenron"]
      }
    },
    "applicationRoots": {
      "aphrody-web": "/srv/aphrody/current",
      "aphrody-ai": "/srv/aphrody/current",
      "shenron": "/srv/shenron/current"
    },
    "secrets": "operator-managed-environment-files",
    "retiredUnits": [
      "shenron.service",
      "shenron-site-b.service",
      "shenron-api.service",
      "shenron-mcp.service",
      "shenron-watchdog.service",
      "shenron-watchdog.timer",
      "shenron-clean-vps.service",
      "shenron-clean-vps.timer",
      "shenron-log-watcher.service",
      "shenron-zswap.service",
      "filebrowser.service"
    ],
    "sharedRuntimes": ["bun", "postgresql", "redis", "nginx"],
    "databasePolicy": "postgresql-primary-with-sqlite-local-cache",
    "authPolicy": "one-better-auth-contract-per-public-origin"
  }
}
