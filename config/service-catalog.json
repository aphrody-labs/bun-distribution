{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "supervisor": "systemd",
  "proxy": "nginx",
  "services": [
    {
      "id": "aphrody-discord-dev",
      "application": "aphrody-discord",
      "kind": "discord-interactions-and-gateway",
      "runtime": "bun",
      "unit": "aphrody-discord-dev.service",
      "health": "http://127.0.0.1:4010/healthz",
      "port": 4010,
      "sourceRepo": "aphrody-discord",
      "workingDirectory": "/srv/aphrody-discord/current",
      "releaseRoot": "/srv/aphrody-discord/releases",
      "publicProxy": "nginx",
      "public": true
    },
    {
      "id": "aphrody-site",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-site.service",
      "health": "http://127.0.0.1:8083/healthz",
      "sourceRepo": "aphrody-web",
      "workingDirectory": "/srv/aphrody/current",
      "releaseRoot": "/srv/aphrody/releases",
      "public": true,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-web-api",
      "application": "aphrody",
      "kind": "bun-http",
      "runtime": "bun",
      "unit": "aphrody-web-api.service",
      "health": "http://127.0.0.1:3007/health",
      "sourceRepo": "aphrody-web",
      "workingDirectory": "/srv/aphrody/current",
      "publicProxy": "aphrody-site",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-ai-http",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-ai-http.service",
      "health": "http://127.0.0.1:8789/healthz",
      "port": 8789,
      "capabilities": ["ai-http"],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "publicProxy": "nginx",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-shenron-embed",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-shenron-embed.service",
      "health": "http://127.0.0.1:8794/health",
      "port": 8794,
      "capabilities": ["embed"],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-a2a",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-a2a.service",
      "health": "http://127.0.0.1:8788/ping",
      "port": 8788,
      "capabilities": ["a2a"],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "a2a": {
        "registry": "config/a2a-peers.json",
        "peer": "aphrody",
        "rpcPath": "/api/v1/a2a",
        "agentCardPath": "/.well-known/agent-card.json",
        "publicProxy": "nginx"
      },
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "shenron-site",
      "application": "shenron",
      "kind": "next-bun-http",
      "runtime": "bun",
      "unit": "shenron-site.service",
      "health": "http://127.0.0.1:5011/api/health",
      "readiness": "http://127.0.0.1:5011/api/health/ready",
      "port": 5011,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current/apps/site",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "Next.js site: /api/health (liveness), /api/health/live (alias) and /api/health/ready (readiness)",
      "public": true
    },
    {
      "id": "shenron-mcp",
      "application": "aphrody",
      "kind": "bun-mcp-http",
      "runtime": "bun",
      "unit": "shenron-mcp.service",
      "health": "http://127.0.0.1:5010/health",
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "releaseRoot": "/srv/aphrody/releases",
      "publicProxy": "nginx",
      "a2a": {
        "registry": "config/a2a-peers.json",
        "peer": "shenron",
        "rpcPath": "/a2a",
        "agentCardPath": "/.well-known/agent-card.json"
      },
      "public": true,
      "status": "retired",
      "retiredAt": "2026-09-25",
      "supersededBy": "aphrody-mcp dragonball.* tools (feature dragonball, default; aphrody-ai d0cb59d deleted apps/shenron-mcp, its systemd unit and mcp.dragonballfr.com vhost template); agent skills in ~/plugins/shenron"
    },
    {
      "id": "shenron-bot",
      "application": "shenron",
      "kind": "discord-bot-and-api",
      "runtime": "bun",
      "unit": "shenron-bot.service",
      "health": "http://127.0.0.1:5006/health",
      "port": 5006,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current/apps/bot",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "single Bun process (discordx + Bun.serve REST/GraphQL/OpenAPI); no separate shenron-api.service, see docs/SHENRON-MIGRATION.md",
      "public": true
    },
    {
      "id": "shenron-pg-tunnel",
      "application": "shenron",
      "kind": "ssh-tunnel",
      "runtime": "native",
      "unit": "shenron-pg-tunnel.service",
      "health": "tcp://127.0.0.1:15433",
      "target": "dbfr:127.0.0.1:5432",
      "note": "private PostgreSQL path VPS -> dbfr (shenron_site); 5432 never public, see docs/SHENRON-MIGRATION.md",
      "public": false
    },
    {
      "id": "shenron-redis",
      "unitSource": "system-package",
      "application": "shenron",
      "kind": "cache",
      "runtime": "redis",
      "unit": "redis-server.service",
      "host": "dbfr",
      "health": "tcp://127.0.0.1:16379",
      "target": "dbfr:127.0.0.1:6379",
      "note": "Private Redis for Shenron live RAG qualification; forwarded with shenron-pg-tunnel by the Infra tunnel owner",
      "public": false
    },
    {
      "id": "shenron-backup",
      "application": "shenron",
      "kind": "backup",
      "runtime": "native",
      "unit": "shenron-backup.timer",
      "public": false
    }
  ],
  "policies": {
    "oneUnitPerWorkload": true,
    "onePublicProxy": true,
    "releasePlanes": {
      "aphrody": {
        "current": "/srv/aphrody/current",
        "adapter": "scripts/release/atomic-deploy-aphrody-stack.sh"
      },
      "shenron": {
        "current": "/srv/shenron/current",
        "adapter": "scripts/release/atomic-deploy-shenron.sh"
      },
      "bundle": {
        "root": "/srv/aphrody-infra",
        "adapter": "scripts/release/atomic-deploy-bundle.sh",
        "order": ["aphrody", "shenron"]
      }
    },
    "applicationRoots": {
      "aphrody-web": "/srv/aphrody/current",
      "aphrody-ai": "/srv/aphrody/current",
      "shenron": "/srv/shenron/current"
    },
    "secrets": "operator-managed-environment-files",
    "retiredUnits": [
      "shenron.service",
      "shenron-site-b.service",
      "shenron-api.service",
      "shenron-mcp.service",
      "shenron-watchdog.service",
      "shenron-watchdog.timer",
      "shenron-clean-vps.service",
      "shenron-clean-vps.timer",
      "shenron-log-watcher.service",
      "shenron-zswap.service",
      "filebrowser.service"
    ],
    "sharedRuntimes": ["bun", "postgresql", "redis", "nginx"],
    "databasePolicy": "postgresql-primary-with-sqlite-local-cache",
    "authPolicy": "one-better-auth-contract-per-public-origin"
  }
}
