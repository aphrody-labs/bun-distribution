[Unit]
Description=Aphrody Web CDP engine (Obscura, loopback only)
Documentation=file://%h/aphrody/docs/operations/web/AUTOMATION.md

[Service]
Type=simple
WorkingDirectory=%h/aphrody
# Loopback only. Clients attach through APHRODY_BROWSER_CDP_URL=ws://127.0.0.1:9222/devtools/browser.
# Local fixtures need OBSCURA_ALLOW_PRIVATE_NETWORK=1, which is deliberately NOT set here.
ExecStart=%h/.local/bin/aphrody-web launch --host 127.0.0.1 --port 9222
# Optional, outside the repository: OBSCURA_CDP_TOKEN, OBSCURA_PROXY and other secrets.
EnvironmentFile=-%h/.config/aphrody/web.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
MemoryMax=4G
TasksMax=512
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
