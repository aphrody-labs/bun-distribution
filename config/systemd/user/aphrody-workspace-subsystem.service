# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Aphrody Workspace read-only tools published as a kernel subsystem
After=aphrody-kernel.service
PartOf=aphrody-kernel.service

[Service]
Type=simple
WorkingDirectory=%h/aphrody
ExecStart=%h/.bun/bin/bun %h/aphrody/packages/infra/workspace/src/ops.ts workspace-subsystem --serve
Restart=on-failure
RestartSec=10
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
