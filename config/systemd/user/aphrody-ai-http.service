[Unit]
Description=Aphrody AI HTTP (Shenron /api/v1/shenron, managed llama.cpp chat, loopback only)
Documentation=file://%h/aphrody/docs/plans/ai/native-integration-master.md

[Service]
Type=simple
WorkingDirectory=%h/aphrody
# llama-server, aphrody-llama-daemon and aphrody are resolved from the user bin dir.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Loopback only. Shenron reads APHRODY_AI_HTTP_URL / APHRODY_AI_HTTP_TOKEN from the same file.
ExecStart=%h/.local/bin/aphrody-mcp http --bind 127.0.0.1:8789
# Outside the repository: APHRODY_AI_HTTP_TOKEN, APHRODY_SHENRON_PRODUCTION_READY=1,
# APHRODY_AI_CHAT_MODEL (catalog id; the managed llama-server daemon is planned per GPU),
# optional APHRODY_SHENRON_LLM_FALLBACK=gemini-web.
EnvironmentFile=%h/.aphrody/private/shenron/ai-http.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
TasksMax=1024
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
