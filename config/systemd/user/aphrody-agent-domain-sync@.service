# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Claude Codex agy %i domain session and memory ingestion
ConditionPathExists=/home/aphro/.aphrody/workspaces/%i/AGENTS.md

[Service]
Type=simple
WorkingDirectory=/home/aphro/aphrody
Environment=APHRODY_AGENT_DOMAIN=%i
Environment=APHRODY_PROFILE=%i
Environment=APHRODY_WORKSPACE=/home/aphro/.aphrody/workspaces/%i
ExecStart=/home/aphro/.local/bin/aphrody ai sync-sessions --watch --interval-secs 30 --json --shared-workspace /home/aphro/aphrody
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
