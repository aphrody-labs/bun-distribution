# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Claude Codex agy %i domain session and memory ingestion
ConditionPathExists=%h/.aphrody/workspaces/%i/AGENTS.md

[Service]
Type=simple
WorkingDirectory=%h/aphrody
Environment=APHRODY_AGENT_DOMAIN=%i
Environment=APHRODY_PROFILE=%i
Environment=APHRODY_WORKSPACE=%h/.aphrody/workspaces/%i
ExecStart=%h/.local/bin/aphrody ai sync-sessions --watch --interval-secs 30 --json --shared-workspace %h/aphrody
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
