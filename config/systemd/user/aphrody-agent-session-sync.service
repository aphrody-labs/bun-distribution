[Unit]
Description=Shared Claude Codex agy session and memory ingestion

[Service]
Type=simple
WorkingDirectory=/home/aphro/aphrody
ExecStart=/home/aphro/.local/bin/aphrody ai sync-sessions --watch --interval-secs 30 --json
Restart=on-failure
RestartSec=10
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
