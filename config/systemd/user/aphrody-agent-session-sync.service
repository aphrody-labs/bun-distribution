[Unit]
Description=Aphrody domain native MCP session and memory ingestion

[Service]
Type=simple
WorkingDirectory=%h/aphrody
ExecStart=%h/.bun/bin/bun %h/aphrody/packages/infra/workspace/src/ops.ts agent-sync --domain aphrody --watch --interval-secs 2
Restart=on-failure
RestartSec=10
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
