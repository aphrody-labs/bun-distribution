[Unit]
Description=Claude Codex agy global session mirror without cross-domain memory

[Service]
Type=simple
WorkingDirectory=/home/aphro/aphrody
ExecStart=/home/aphro/.local/bin/aphrody ai sync-sessions --watch --interval-secs 30 --json --no-memory
Restart=on-failure
RestartSec=10
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
