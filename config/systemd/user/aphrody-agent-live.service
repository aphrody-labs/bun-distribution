[Unit]
Description=Aphrody live agent sessions and monorepo metadata
After=aphrody-agent-session-sync.service

[Service]
Type=simple
WorkingDirectory=%h/aphrody
ExecStart=%h/.bun/bin/bun %h/aphrody/packages/infra/workspace/src/ops.ts agent-live --watch --interval-secs 30 --json
Restart=on-failure
RestartSec=10
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
