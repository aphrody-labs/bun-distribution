# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Aphrody source workspace synchronisation
Documentation=file://%h/aphrody/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/aphrody/scripts/source-sync.ts

[Service]
Type=simple
WorkingDirectory=%h/aphrody
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun scripts/source-sync.ts --apply --watch --interval 60 --repo aphrody --repo aphrody-py --repo iecode
Restart=always
RestartSec=10s
Nice=15
CPUQuota=20%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
