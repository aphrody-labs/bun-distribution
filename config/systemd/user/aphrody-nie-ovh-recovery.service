# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Recover NIE data from the OVH VPS automated backup
After=network-online.target
ConditionPathExists=!/home/aphro/recovered/nie-ovh-20260606/DONE

[Service]
Type=simple
WorkingDirectory=/home/aphro/recovered/nie-ovh-20260606
ExecStart=/home/aphro/.bun/bin/bun /home/aphro/recovered/nie-ovh-20260606/recover.mjs
Restart=on-failure
RestartSec=60s
UMask=0077
Environment=HOME=/home/aphro

[Install]
WantedBy=default.target
