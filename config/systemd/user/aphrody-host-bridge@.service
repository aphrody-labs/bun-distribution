# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Aphrody native Hyper-V tunnel to %i
Requires=aphrody-kernel.service
After=aphrody-kernel.service

[Service]
Type=simple
ExecStart=%h/.local/bin/aphrody-host-service --config %h/.config/aphrody/host-bridge/%i.json
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
