# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Regenerate Aphrody generated docs (STATE.md, index, llms.txt, ecosystem, upstreams, dependency inventory); writes the working tree, never commits

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
WorkingDirectory=%h/aphrody
Environment=PATH=%h/.cargo/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun packages/infra/workspace/src/ops.ts docs-gen --root %h/aphrody --deps
