[Unit]
Description=Aphrody update report (tools, Cargo lock, dependency fact sheets); report only, never applies

[Service]
Type=oneshot
WorkingDirectory=%h/aphrody
ExecStart=%h/.bun/bin/bun packages/infra/update/src/cli.ts tools --root %h/aphrody
ExecStart=%h/.bun/bin/bun packages/infra/update/src/cli.ts deps facts --root %h/aphrody
ExecStart=%h/.bun/bin/bun packages/infra/update/src/cli.ts check --root %h/aphrody
