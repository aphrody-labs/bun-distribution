# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Verified resumable backup of dbfr Shenron trained models and datasets
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/aphrody/.env
ConditionPathExists=%h/.aphrody/private/shenron/home/models
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=oneshot
WorkingDirectory=%h/aphrody
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun --env-file=%h/aphrody/.env packages/google/google/src/drive-model-sync.ts
TimeoutStartSec=12h
Restart=on-failure
RestartSec=60s
UMask=0077
Nice=15
NoNewPrivileges=true
PrivateTmp=true

