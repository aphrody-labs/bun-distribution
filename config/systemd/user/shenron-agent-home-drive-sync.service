# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron dbfr read-only native Markdown Drive projection and memory reconciliation
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/aphro/.aphrody/workspaces/dbfr
ConditionPathExists=/home/aphro/aphrody/.env

[Service]
Type=simple
WorkingDirectory=/home/aphro/aphrody
Environment=APHRODY_ROOT=/home/aphro/aphrody
Environment=APHRODY_AGENT_DOMAIN=dbfr
Environment=APHRODY_WORKSPACE=/home/aphro/.aphrody/workspaces/dbfr
Environment=APHRODY_AGENT_HOME=/home/aphro/.aphrody/workspaces/dbfr
Environment=PATH=/home/aphro/.local/bin:/home/aphro/.bun/bin:/home/aphro/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/aphro/.bun/bin/bun packages/infra/workspace/src/agent-home-drive-sync.ts daemon
Restart=on-failure
RestartSec=30s
UMask=0077
Nice=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
