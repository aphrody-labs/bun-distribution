# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron dbfr read-only native Markdown Drive projection and memory reconciliation
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.aphrody/workspaces/dbfr
ConditionPathExists=%h/aphrody/.env

[Service]
Type=simple
WorkingDirectory=%h/aphrody
Environment=APHRODY_ROOT=%h/aphrody
Environment=APHRODY_AGENT_DOMAIN=dbfr
Environment=APHRODY_WORKSPACE=%h/.aphrody/workspaces/dbfr
Environment=APHRODY_AGENT_HOME=%h/.aphrody/workspaces/dbfr
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun packages/infra/workspace/src/agent-home-drive-sync.ts daemon
Restart=on-failure
RestartSec=30s
UMask=0077
Nice=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
