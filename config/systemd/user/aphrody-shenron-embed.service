[Unit]
Description=Aphrody native multilingual E5 embeddings for the Shenron RAG
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/aphrody-embed serve --host 127.0.0.1 --port 8085 --threads 4
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
