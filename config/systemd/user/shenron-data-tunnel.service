[Unit]
Description=Private Shenron PostgreSQL and Redis access through Aphrody Infra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/aphrody
ExecStart=%h/.local/bin/aphrody-ssh tunnel --services shenron-pg-tunnel,shenron-redis
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
