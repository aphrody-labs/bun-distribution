{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"env": {
		"builtin": true,
		"es2024": true
	},
	"globals": {
		"Bun": "readonly"
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.next/**",
		"**/.next-build/**",
		"**/.next-dev/**",
		"**/.turbo/**",
		"**/public/bxc-mirror/**",
		"**/public/bxc-raw/**",
		"**/*.min.js",
		"**/data/**",
		"apps/bot/assets/**",
		"**/storage/**",
		"**/target/**",
		"**/var/**",
		"**/patches/**",
		"**/scratch/**",
		"**/src/_entries.ts",
		"**/src/db/migrations/**",
		"**/drizzle/**"
	]
}
