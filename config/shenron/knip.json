{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": [
		"**/dist/**",
		"**/.next*/**",
		"**/coverage/**",
		"**/node_modules/**",
		"**/test/fixtures/**",
		"**/tests/fixtures/**"
	],
	"ignoreBinaries": ["ffmpeg", "ffprobe"],
	"ignoreDependencies": ["pino-pretty", "tailwindcss"],
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,tsx,mts,cts}"],
			"project": ["scripts/**/*.{ts,tsx,mts,cts}"]
		},
		"apps/bot": {
			"entry": [
				"src/index.ts",
				"src/dashboard/main.tsx",
				"src/commands/**/*.{ts,tsx}",
				"src/events/**/*.{ts,tsx}",
				"src/guards/**/*.{ts,tsx}",
				"src/workers/**/*.{ts,tsx}",
				"src/db/**/*.{ts,tsx}",
				"scripts/**/*.{ts,tsx}"
			],
			"project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
		},
		"apps/site": {
			"entry": ["scripts/**/*.{ts,tsx}"],
			"project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
		},
		"packages/api": {
			"entry": ["scripts/**/*.{ts,tsx,mts,cts}"],
			"project": ["src/**/*.{ts,tsx,mts,cts}", "scripts/**/*.{ts,tsx,mts,cts}", "test/**/*.{ts,tsx,mts,cts}", "tests/**/*.{ts,tsx,mts,cts}"]
		},
		"packages/auth": { "entry": ["scripts/**/*.{ts,tsx,mts,cts}"], "project": ["src/**/*.{ts,tsx,mts,cts}", "scripts/**/*.{ts,tsx,mts,cts}", "test/**/*.{ts,tsx,mts,cts}", "tests/**/*.{ts,tsx,mts,cts}"] },
		"packages/config": { "entry": ["scripts/**/*.{ts,tsx,mts,cts}"], "project": ["src/**/*.{ts,tsx,mts,cts}", "scripts/**/*.{ts,tsx,mts,cts}", "test/**/*.{ts,tsx,mts,cts}", "tests/**/*.{ts,tsx,mts,cts}"] },
		"packages/db": { "entry": ["scripts/**/*.{ts,tsx,mts,cts}"], "project": ["src/**/*.{ts,tsx,mts,cts}", "scripts/**/*.{ts,tsx,mts,cts}", "test/**/*.{ts,tsx,mts,cts}", "tests/**/*.{ts,tsx,mts,cts}"] },
		"packages/images": { "entry": ["scripts/**/*.{ts,tsx,mts,cts}"], "project": ["src/**/*.{ts,tsx,mts,cts}", "scripts/**/*.{ts,tsx,mts,cts}", "test/**/*.{ts,tsx,mts,cts}", "tests/**/*.{ts,tsx,mts,cts}"] },
		"packages/pipeline": {
			"entry": ["scripts/**/*.{ts,tsx,mts,cts}"],
			"project": [
				"src/**/*.{ts,tsx,mts,cts}",
				"scripts/**/*.{ts,tsx,mts,cts}",
				"test/**/*.{ts,tsx,mts,cts}",
				"tests/**/*.{ts,tsx,mts,cts}"
			]
		},
		"packages/ui": { "entry": ["scripts/**/*.{ts,tsx,mts,cts}"], "project": ["src/**/*.{ts,tsx,mts,cts}", "scripts/**/*.{ts,tsx,mts,cts}", "test/**/*.{ts,tsx,mts,cts}", "tests/**/*.{ts,tsx,mts,cts}"] }
	}
}
