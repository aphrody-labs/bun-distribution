  "type": "module",
  "scripts": {
    "pipeline": "bun --filter @shenron/pipeline pipeline",
    "bot:dev": "bun --filter @shenron/bot dev",
    "env:dev": "bun scripts/dev/local-env.ts env --profile=dev",
    "env:prod": "bun scripts/dev/local-env.ts env --profile=prod",
    "env:status": "bun scripts/dev/local-env.ts status",
    "bot:start": "bun --filter @shenron/bot start",
    "bot:build": "bun --filter @shenron/bot build",
    "bot:test": "bun --filter @shenron/bot test",
    "bot:lint": "bun --filter @shenron/bot lint",
    "site:dev": "bun design/aphrody-m3/packages/scripts/sync-assets.ts --to apps/site/public && bun --filter @shenron/site dev",
    "dev:site": "bun run env:dev && bun run site:dev",
    "dev:bot": "bun run env:dev && bun run bot:dev",
    "prod:env": "bun run env:prod",
    "site:build": "bun design/aphrody-m3/packages/scripts/sync-assets.ts --to apps/site/public && bun --filter @shenron/site build",
    "site:start": "bun --filter @shenron/site start",
    "site:artifact": "bun scripts/ops/build-site-external.ts",
    "site:artifact:package": "bun scripts/ops/package-site-artifact.ts",
    "site:migrate": "bun --filter @shenron/site db:migrate",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:all": "bun scripts/test-all.ts",
    "test:ci": "bun scripts/test-all.ts --strict",
    "test:cov": "bun scripts/test-all.ts --coverage --junit",
    "test:live": "bun scripts/test-all.ts --live",
    "workflow:dragon-ball": "bun scripts/workflow.ts",
    "manga:ocr:export": "bun --filter @shenron/bot manga:ocr:export",
    "manga:ocr:run": "bun --filter @shenron/bot manga:ocr:run",
    "manga:ocr:deposit": "bun --filter @shenron/bot manga:ocr:deposit",
    "manga:ocr:materialize": "bun --filter @shenron/bot manga:ocr:materialize",
    "rag:eval": "bun scripts/ops/run-auto-train.ts",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "crawl:frames": "bun scripts/ops/crawl-frames.ts",
    "crawl:dragon-ball-official": "bun scripts/ops/crawl-dragon-ball-official.ts",
    "gcloud:status": "bun scripts/ops/gcloud-manager.ts status",
    "gcloud:sync": "bun scripts/ops/gcloud-manager.ts sync-backups",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "audit:scripts": "aphrody-ops audit-scripts --repo shenron",
    "audit:dead-code": "knip --no-progress --no-config-hints --reporter compact --no-exit-code",
    "audit:dead-code:strict": "knip --no-progress --no-config-hints --reporter compact",
    "audit:architecture": "bun scripts/ops/audit-refonte-architecture.ts",
    "check:catalog": "bun scripts/ops/check-workspace-catalog.ts",
    "deps:audit": "bun audit --audit-level=high",
    "deps:dedupe:check": "bun dedupe --check",
    "audit:architecture:watch": "bun scripts/ops/watch-refonte-architecture.ts",
    "audit:refonte-api": "bun scripts/ops/audit-refonte-api-latency.ts",
    "docs:unify": "bun scripts/docs/unify-markdown.ts",
    "check:packages": "bun scripts/ops/check-workspace-packages.ts"
  },
  "dependencies": {
    "sharp": "catalog:",
    "@shenron/pipeline": "workspace:*"
  },
  "devDependencies": {
    "@next/env": "catalog:",
    "knip": "6.38.0",
    "pg": "catalog:",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsup": "catalog:",
    "turbo": "^2.10.12"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "kysely": "0.28.17"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "comment-overrides": "Une copie UNIQUE de React/Next/@types/react sur tout le monorepo (versions stables align\u00e9es sur le catalog) : un skew casse l\u2019augmentation JSX @pixi/react et les types Base UI."
}
