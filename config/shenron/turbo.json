{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [
		"tsconfig.json",
		"bunfig.toml",
		".oxfmtrc.json",
		".oxlintrc.json",
		"packages/config/tsconfig/*.json"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [
				"dist/**",
				".next/**",
				"!.next/cache/**",
				".next-build/**",
				"!.next-build/cache/**"
			],
			"env": [
				"NODE_ENV",
				"VERCEL_URL",
				"DATABASE_URL",
				"BETTER_AUTH_URL",
				"BETTER_AUTH_SECRET",
				"NEXTAUTH_URL",
				"NEXTAUTH_SECRET",
				"AUTH_URL",
				"AUTH_SECRET",
				"DISCORD_CLIENT_ID",
				"DISCORD_CLIENT_SECRET",
				"AUTH_DISCORD_ID",
				"AUTH_DISCORD_SECRET",
				"DISCORD_PUBLIC_KEY",
				"DISCORD_APPLICATION_ID",
				"SHENRON_API_URL",
				"NEXT_PUBLIC_DISCORD_INVITE_URL",
				"NEXT_PUBLIC_SITE_URL",
				"NEXT_PUBLIC_ADSENSE_CLIENT",
				"NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE",
				"NEXT_PUBLIC_ADSENSE_SLOT_DISPLAY",
				"NEXT_PUBLIC_ADSENSE_SLOT_INFEED",
				"NEXT_PUBLIC_ADSENSE_LAYOUT_KEY_INFEED",
				"NEXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX",
				"DATABASE_POOL_MAX"
			]
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"lint": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "!.next*/**", "!dist/**"],
			"outputs": []
		},
		"lint:fix": {
			"cache": false
		},
		"type-check": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "!.next*/**", "!dist/**"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["transit"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig*.json", "!.next*/**", "!dist/**"],
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		}
	}
}
