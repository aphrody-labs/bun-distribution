{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "es5",
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"ignorePatterns": [
		"**/*.generated.ts",
		"**/dist/**",
		"**/.next/**",
		"**/.next-build/**",
		"**/.turbo/**",
		"**/node_modules/**",
		"**/data/**",
		"**/*.min.js",
		"**/*.compiled.css",
		"**/patches/**",
		"**/scratch/**",
		"**/public/bxc-mirror/**",
		"**/public/bxc-raw/**",
		"KNOWLEDGE_BASE.md",
		"**/src/_entries.ts",
		"**/src/db/migrations/**",
		"**/drizzle/**",
		"apps/bot/assets/**",
		"**/storage/**",
		"**/target/**",
		"**/var/**"
	]
}
