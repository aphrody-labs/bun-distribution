# SPDX-License-Identifier: Apache-2.0

# Cargo outputs at workspace roots. Keep source modules such as
# crates/ai/rag-eval/src/target/ visible to Git.
/target/
/crates/*/*/target/
/packages/*/*/target/
/apps/*/*/target/
**/*.rs.bk

# Bun, TypeScript, and frontend outputs. Package-specific exceptions remain in
# their own .gitignore files (for example, the tracked drive-server dist shell).
/node_modules/
/dist/
/.turbo/
**/node_modules/
**/.turbo/
/apps/*/*/.next/
/packages/*/*/.next/
/apps/*/*/coverage/
/packages/*/*/coverage/
/crates/*/*/coverage/
/apps/*/*/playwright-report/
/apps/*/*/test-results/
/apps/*/*/dist/
/apps/*/dist/
/packages/*/*/dist/
/packages/*/dist/
**/*.tsbuildinfo
/.cache/
/.venv/
**/.cache/
**/.venv/
/build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
/var/runs/
/var/audit/
/var/json/
/var/private/
/var/unification/
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.dump
# Database fixtures are source inputs; generated databases belong in var/.
!**/fixtures/**/*.db
!**/fixtures/**/*.sqlite
!**/fixtures/**/*.sqlite3
!**/fixtures/**/*.dump
/upstream/discord/packages/discordx/coverage/
/apps/shenron/*/node_modules/
/packages/shenron/*/node_modules/
/apps/shenron/*/.next-build/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
!.env.*.example
/secrets/
/cookies/
/.npmrc
.claude/settings.local.json
*.heapsnapshot
*.heapsnapshot.*
*.heapprofile
*.heapprofile.*
*.heaptimeline
*.heaptimeline.*
*.cpuprofile
*.cpuprofile.*
/.coord/
**/.coord/

# Host editor and file-manager state.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vs/

# Generated host native artifacts; staged by the package builder.
/packages/interop/native/native/
# Private imported Shenron state: credentials, trained weights and user data.
/data/shenron/home/

# Translation caches written by test/dev runs
.aphrody-translate-cache.json
.neon
*.db-shm
*.db-wal
/packages/shell/web/pkg/
/crates/shell/tauri-e2e/frontend/pkg/
/crates/shell/tauri-e2e/frontend/index.js
# Python SDK packaging outputs; the source package remains canonical.
/packages/google/antigravity-sdk-python/build/
/packages/google/antigravity-sdk-python/*.egg-info/

# Generated Shenron corpus and historical live audit: retain in local stores.
/data/shenron/rag/massive-training-triplets-full.jsonl
/data/shenron/ops/live-site-assets.json

# Per-machine plugin store written by aphrody-ops plugins (absolute local path)
/.agents/plugins.json
.serena/
