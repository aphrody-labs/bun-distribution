{
  "name": "@rosegriffon/achillea-bot",
  "version": "1.0.1",
  "private": true,
  "description": "Achillea Backend — Bot Discord + API REST + WebSocket pour la plateforme Achillea (Bun + Ts.ED + PostgreSQL/Kysely)",
  "license": "UNLICENSED",
  "main": "build/main.js",
  "scripts": {
    "build": "bun run build:clean && bun run build:compile && bun run build:ranked && bun run install:plugins",
    "build:clean": "bun scripts/clean-build.ts",
    "build:compile": "tsc --project tsconfig.json --skipLibCheck && bun run build:alias",
    "build:ranked": "bun build src/ranked/main.ts --target=bun --format=esm --outdir=build/ranked --sourcemap=external",
    "build:alias": "tsc-alias -p tsconfig.json",
    "build:start": "bun run build && bun run start",
    "install:plugins": "installoop --rootDir=./build/plugins",
    "type:check": "tsc --pretty --skipLibCheck --noEmit",
    "type-check": "tsc --pretty --skipLibCheck --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "clean": "bun scripts/clean-build.ts",
    "start": "NODE_ENV=production bun build/main.js",
    "dev": "NODE_ENV=development bun --watch src/main.ts",
    "i18n": "typesafe-i18n",
    "migration:create:dev": "NODE_ENV=development SKIP_SCHEDULE=1 bunx mikro-orm migration:create",
    "migration:up:dev": "NODE_ENV=development SKIP_SCHEDULE=1 bunx mikro-orm migration:up",
    "migration:down:dev": "NODE_ENV=development SKIP_SCHEDULE=1 bunx mikro-orm migration:down",
    "schema:update:dev": "echo 'schema:update désactivé : utiliser une migration SQL versionnée dans apps/website/sql/migrations' && exit 1",
    "cache:clear:dev": "NODE_ENV=development SKIP_SCHEDULE=1 bunx mikro-orm cache:clear",
    "migration:create:prod": "NODE_ENV=production SKIP_SCHEDULE=1 bunx mikro-orm migration:create",
    "migration:up:prod": "NODE_ENV=production SKIP_SCHEDULE=1 bunx mikro-orm migration:up",
    "migration:down:prod": "NODE_ENV=production SKIP_SCHEDULE=1 bunx mikro-orm migration:down",
    "plugins:install": "installoop --rootDir=./src/plugins",
    "postinstall": "bun run plugins:install",
    "lint": "oxlint --config ../../.oxlintrc.json --allow import/no-cycle .",
    "lint:strict": "oxlint --config ../../.oxlintrc.json --allow import/no-cycle --type-aware .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --allow import/no-cycle --fix .",
    "lint:eslint": "eslint .",
    "test": "bun test --isolate",
    "test:concurrent": "bun test --isolate --concurrent",
    "test:bail": "bun test --isolate --bail=1",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:ci": "bun test --isolate --reporter=junit --reporter-outfile=./bun.xml --bail=10",
    "test:e2e": "bun test tests/e2e/",
    "test:db": "bun test tests/db/",
    "test:unit": "bun test tests/unit/",
    "test:supabase": "bun test tests/supabase/",
    "test:snapshot": "bun test tests/db/ tests/supabase/snapshot.test.ts",
    "elo:backfill-tournaments": "bun scripts/backfill-tournament-elo.ts",
    "elo:backfill-tournaments:apply": "bun scripts/backfill-tournament-elo.ts --apply"
  },
  "dependencies": {
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/discord-sync": "workspace:*",
		"kysely": "catalog:",
    "@rosegriffon/achillea-core": "workspace:*",
    "@rosegriffon/achillea-types": "workspace:*",
    "@rosegriffon/auth": "workspace:*",
    "@aphrody/canvas": "0.1.99",
    "@aphrody/discordx": "^0.1.0",
		"@aphrody/importer": "^0.1.0",
		"@aphrody/utilities": "^0.1.0",
		"@casl/ability": "catalog:",
    "@colyseus/bun-websockets": "^0.17.13",
    "@colyseus/schema": "^4.0.26",
    "@mikro-orm/cli": "^7.1.3",
    "@mikro-orm/core": "^7.1.3",
    "@mikro-orm/decorators": "^7.1.11",
    "@mikro-orm/entity-generator": "^7.1.3",
    "@mikro-orm/migrations": "^7.1.3",
    "@mikro-orm/postgresql": "^7.1.3",
    "@mikro-orm/sql-highlighter": "~1.0.1",
    "@rushstack/node-core-library": "^5.23.1",
    "@tsed/common": "^8.30.0",
    "@tsed/core": "^8.30.0",
    "@tsed/di": "^8.30.0",
    "@tsed/exceptions": "^8.30.0",
    "@tsed/json-mapper": "^8.30.0",
    "@tsed/platform-express": "^8.30.0",
		"@tsed/schema": "^8.30.0",
    "@tsed/swagger": "^8.30.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.1.0",
    "archiver": "^7.0.1",
    "axios": "^1.17.0",
    "blockhash-core": "^0.1.0",
    "body-parser": "^2.2.2",
    "boxen": "~8.0.1",
    "brackets-manager": "^1.11.0",
    "brackets-model": "catalog:",
    "bullmq": "^5.78.0",
    "case": "~1.6.3",
    "chalk": "~5.6.2",
    "chokidar": "~5.0.0",
    "class-transformer": "^0.5.1",
    "colyseus": "^0.17.10",
    "cookie-parser": "^1.4.7",
    "cron": "~4.4.0",
    "cron-validator": "~1.4.0",
    "dayjs": "~1.11.21",
    "discord-api-types": "~0.38.48",
    "discord-logs": "~2.2.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "grapheme-splitter": "^1.0.4",
    "http-proxy-middleware": "^4.0.0",
    "installoop": "^1.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "multer": "^2.1.1",
    "node-os-utils": "~2.0.3",
    "ora": "~9.4.0",
    "pdf-lib": "^1.17.1",
    "pidusage": "~4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "~0.2.2",
    "rxeta": "~1.1.2",
    "rxjs": "catalog:",
    "semver": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "stacktrace-parser": "~0.1.11",
    "swagger-ui-express": "~5.0.1",
    "ts-toolbelt": "^9.6.0",
    "tsyringe": "^4.10.0",
    "typesafe-i18n": "^5.27.1",
		"zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/archiver": "^7.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/bun": "^1.3.14",
    "@types/express": "~5.0.6",
    "@types/node": "~25.9.1",
    "@types/node-os-utils": "~1.3.4",
    "@types/pidusage": "~2.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jiti": "^2.7.0",
    "ncp": "~2.0.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "tsc-alias": "~1.8.17",
    "tsconfig-paths": "~4.2.0",
    "typescript": "catalog:"
  },
  "optionalDependencies": {
    "@aphrody/canvas-linux-arm64-gnu": "0.1.99"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./mikro-orm.config.ts",
      "./build/mikro-orm.config.js"
    ]
  },
  "tscord": {
    "version": "2.4"
  }
}
