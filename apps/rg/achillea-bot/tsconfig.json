{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Preserve",
		"moduleResolution": "Bundler",

		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,

		"outDir": "build",
		"rootDir": "src",

		"strict": true,
		"strictPropertyInitialization": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		// Requis par les décorateurs legacy (mikro-orm/tsed) : ES2022 mettrait
		// useDefineForClassFields=true, ce qui casse la metadata des décorateurs.
		"useDefineForClassFields": false,
		"skipLibCheck": true,

		"types": ["bun"],

		"paths": {
			"@/auth": ["./src/auth"],
			"@/auth/*": ["./src/auth/*"],
			"@/decorators": ["./src/utils/decorators"],
			"@/decorators/*": ["./src/plugins/*/utils/decorators"],

			"@/errors": ["./src/utils/errors"],
			"@/errors/*": ["./src/plugins/*/utils/errors"],

			"@/entities": ["./src/entities"],
			"@/entities/*": ["./src/entities/*", "./src/plugins/*/entities"],

			"@/guards": ["./src/guards"],
			"@/guards/*": ["./src/plugins/*/guards"],

			"@/services": ["./src/services"],
			"@/services/*": ["./src/services/*", "./src/plugins/*/services"],

			"@/i18n": ["./src/i18n"],
			"@/i18n/*": ["./src/plugins/*/i18n"],

			"@/jobs": ["./src/jobs"],
			"@/jobs/*": ["./src/plugins/*/jobs"],

			"@/queues": ["./src/queues"],
			"@/queues/*": ["./src/plugins/*/queues"],

			"@/configs": ["./src/configs"],
			"@/configs/*": ["./src/configs/*", "./src/plugins/*/configs"],

			"@/utils/classes": ["./src/utils/classes"],
			"@/utils/classes/*": ["./src/plugins/*/utils/classes"],

			"@/utils/enums": ["./src/utils/enums"],
			"@/utils/enums/*": ["./src/utils/enums/*", "./src/plugins/*/utils/enums"],

			"@/utils/handlers": ["./src/utils/handlers"],
			"@/utils/handlers/*": ["./src/plugins/*/utils/handlers"],

			"@/utils/functions": ["./src/utils/functions"],
			"@/utils/functions/*": ["./src/utils/functions/*", "./src/plugins/*/utils/functions"],

			"@/utils/interfaces": ["./src/utils/interfaces"],
			"@/utils/interfaces/*": ["./src/plugins/*/utils/interfaces"],

			"@/api/controllers": ["./src/api/controllers"],
			"@/api/controllers/*": ["./src/plugins/*/api/controllers"],

			"@/api/middlewares": ["./src/api/middlewares"],
			"@/api/middlewares/*": ["./src/plugins/*/api/middlewares"],

			"@/api/models/dtos": ["./src/api/models/dtos"],
			"@/api/models/dtos/*": ["./src/plugins/*/api/models/dtos"],

			"@/api/models/interfaces": ["./src/api/models/interfaces"],
			"@/api/models/interfaces/*": ["./src/plugins/*/api/models/interfaces"],

			"@/api/server": ["./src/api/server.ts"],

			"@/env": ["./src/utils/types/environment.ts"]
		}
	},

	"include": ["src", "src/**/*.ts", "src/**/*.json"],
	"exclude": [
		"build",
		"node_modules",
		"tests",
		"scripts",
		"mikro-orm.config.ts",
		"package.json",
		"src/ranked"
	]
}
