{
  "name": "@rosegriffon/bot",
  "version": "1.0.1",
  "private": true,
  "description": "Bot Discord Rose Griffon — slash commands public + admin, sync members, canvas cards",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:bot": "bun src/index.ts bot",
    "start:api": "bun src/index.ts api",
    "start:all": "bun src/index.ts all",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist",
    "compile": "bun build src/entry-standalone.ts --compile --minify --sourcemap --outfile=dist/rg-bot",
    "type-check": "bun --bun tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "bun test src",
    "smoke:admin": "bun src/scripts/smoke-admin.ts",
    "smoke:canvas": "bun src/scripts/smoke-canvas.ts",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/canvas": "workspace:*",
    "@aphrody/discord-kit": "workspace:*",
    "@elysia/eden": "^1.4.10",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@rosegriffon/achillea-client": "workspace:*",
    "@rosegriffon/achillea-core": "workspace:*",
    "@rosegriffon/assets": "workspace:*",
    "@rosegriffon/auth": "workspace:*",
    "@rosegriffon/azalee": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "@rosegriffon/ui": "workspace:*",
    "brackets-manager": "^1.11.0",
    "brackets-model": "catalog:",
    "discord.js": "catalog:",
    "discordx": "catalog:",
    "elysia": "^1.4.28",
    "kysely": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rosegriffon/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
