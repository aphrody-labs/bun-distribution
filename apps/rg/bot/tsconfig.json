{
	"extends": "@rosegriffon/config/tsconfig-bun.json",
	"compilerOptions": {
		"noUncheckedIndexedAccess": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"paths": {
			"@/*": ["./src/*"],
			"@rosegriffon/assets": ["../../packages/assets/src/index.ts"],
			"@rosegriffon/db": ["../../packages/db/src/index.ts"],
			"@rosegriffon/db/*": ["../../packages/db/src/*"],
			"@rosegriffon/types": ["../../packages/types/src/index.ts"],
			"@rosegriffon/types/*": ["../../packages/types/src/*"],
			"@rosegriffon/auth": ["../../packages/auth/src/index.ts"],
			"@rosegriffon/auth/*": ["../../packages/auth/src/*"]
		},
		"outDir": "dist",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"moduleDetection": "force"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
