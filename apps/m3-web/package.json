{
  "name": "@aphrody/m3-web",
  "version": "1.4.4",
  "license": "Apache-2.0",
  "description": "Showcase app of the M3 framework. Built, served and compiled through the yolo CLI (`yolo web build|dev`, `yolo tauri build`), which runs these scripts.",
  "type": "module",
  "scripts": {
    "dev": "bun ../../packages/m3/bin/m3.ts dev",
    "build": "bun ../../packages/m3/bin/m3.ts build",
    "compile": "bun ../../packages/m3/bin/m3.ts compile",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/fonts-sync.ts --quiet && bun test"
  },
  "dependencies": {
    "@aphrody/m3": "workspace:*",
    "@aphrody/m3-front": "workspace:*",
    "@aphrody/m3-tailwind": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
