{
  "name": "@shenron/site",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./lib/wiki-slugs": "./src/lib/wiki-slugs.ts",
    "./lib/databooks-defauts": "./src/lib/databooks-defauts.ts",
    "./scripts/aphrody-corpus": "./scripts/_aphrody-corpus.ts"
  },
  "scripts": {
    "predev": "bun ../../../m3/packages/shenron-ui/scripts/sync-assets.ts --to public",
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack",
    "prebuild": "bun ../../../m3/packages/shenron-ui/scripts/sync-assets.ts --to public",
    "build": "NEXT_DIST_DIR=.next-build next build --turbopack",
    "start": "next start",
    "lint": "oxlint -c .oxlintrc.json",
    "test": "bun test --isolate tests/",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "type-check:tests": "tsc --noEmit -p tsconfig.tests.json",
    "wiki:repair-interviews": "bun scripts/repair-interview-databook-links.ts",
    "manga:populate": "bun scripts/populate-manga-pages.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo \"db:push est interdit : migrations via le runbook aphrody-infra (docs/STACK.md D5)\" >&2 && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
