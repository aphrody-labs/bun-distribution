{
	"$schema": "../../../node_modules/oxlint/configuration_schema.json",
	"extends": ["../../../.oxlintrc.json"],
	"plugins": ["typescript", "unicorn", "oxc", "promise", "import"],
	"ignorePatterns": ["public/**", ".next/**", ".next-build/**", ".next-dev/**"],
	"rules": {
		"no-unused-vars": "warn",
		"no-useless-escape": "warn"
	}
}