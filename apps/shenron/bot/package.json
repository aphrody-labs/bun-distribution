{
  "name": "@shenron/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/rag": "./src/lib/rag.ts",
    "./data/manga-spin-offs-manifest.json": "./data/manga-spin-offs-manifest.json"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun run dashboard:css && bash scripts/build-bundle.sh",
    "dashboard:css": "bash scripts/build-dashboard-css.sh",
    "dashboard:watch": "bunx @tailwindcss/cli --input src/dashboard/styles.css --output src/dashboard/styles.compiled.css --watch",
    "compile": "bun run dashboard:css && bun build src/entry-standalone.ts --compile --minify --sourcemap --outfile=dist/shenron",
    "type-check": "bunx tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test --isolate tests/",
    "ids": "bun scripts/discover-ids.ts",
    "watch-logs": "bun scripts/log-watcher.ts",
    "bg:fetch": "bun scripts/fetch-backgrounds.ts --download",
    "bg:optimize": "bun scripts/optimize-backgrounds.ts",
    "bg:all": "bun scripts/fetch-backgrounds.ts --download && bun scripts/optimize-backgrounds.ts",
    "gen:entries": "bun scripts/gen-entries.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed-wiki": "bun src/db/seed-wiki.ts",
    "db:seed-triggers": "bun src/db/seed-triggers.ts",
    "db:seed-levels": "bun src/db/seed-level-rewards.ts",
    "db:seed-media": "bun src/db/seed-media.ts",
    "db:seed-games": "bun src/db/seed-games.ts",
    "db:seed-manga": "bun src/db/seed-manga.ts",
    "db:seed-xv2-portraits": "bun src/db/seed-xv2-portraits.ts",
    "db:seed-xv2-techniques": "bun src/db/seed-xv2-techniques.ts",
    "db:seed-xv2-characters": "bun src/db/seed-xv2-characters.ts",
    "db:seed-xv2-transformations": "bun src/db/seed-xv2-transformations.ts",
    "db:seed-xv2-char-techniques": "bun src/db/seed-xv2-char-techniques.ts",
    "db:seed-all": "bun src/db/seed-triggers.ts && bun src/db/seed-level-rewards.ts && bun src/db/seed-shop-banners.ts",
    "db:sync-news": "bun scripts/sync-news.ts",
    "db:studio": "bunx drizzle-kit studio",
    "db:push": "bunx drizzle-kit push",
    "db:seed-xv2-char-meta": "bun src/db/seed-xv2-char-meta.ts",
    "db:seed-xv2-all": "bun src/db/seed-xv2-techniques.ts && bun src/db/seed-xv2-characters.ts && bun src/db/seed-xv2-char-meta.ts && bun src/db/seed-xv2-portraits.ts && bun src/db/seed-xv2-transformations.ts && bun src/db/seed-xv2-char-techniques.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@pothos/core": "^4.13.1",
    "@aphrody/discord-kit": "workspace:*",
    "discordx": "catalog:",
    "@discordx/di": "catalog:",
    "@discordx/pagination": "catalog:",
    "@shenron/auth": "workspace:*",
    "@shenron/images": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "dayjs": "^1.11.23",
    "discord.js": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "graphql-yoga": "catalog:",
    "lucide-react": "catalog:",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "sharp": "catalog:",
    "sqlite-vec": "^0.1.9",
    "tsyringe": "catalog:",
    "zod": "catalog:",
    "@shenron/config": "workspace:*",
    "@shenron/db": "workspace:*",
    "@shenron/api": "workspace:*",
    "@shenron/ui": "workspace:*",
    "@shenron/pipeline": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.11",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
