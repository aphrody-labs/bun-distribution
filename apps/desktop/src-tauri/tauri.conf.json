{
  "productName": "Aphrody",
  "version": "0.1.0",
  "identifier": "com.aphrody.bun",
  "build": { "frontendDist": "../dist/web" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aphrody",
        "width": 1240,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": { "aphrody": { "bun": { "sidecar": "aphrody-server", "readyTimeoutMs": 15000 } } },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/aphrody-server"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
