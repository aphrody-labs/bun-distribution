{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The Tauri API (@aphrody/api, crates/tauri/aphrody-tauri-api) is type-checked from its sources with
    // their globals (global.d.ts); its own settings do not enable these stricter yolo options.
    "noUncheckedIndexedAccess": false,
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  },
  "files": ["../../../crates/tauri/aphrody-tauri-api/src/global.d.ts"],
  "include": ["src/**/*", "build.ts"]
}
