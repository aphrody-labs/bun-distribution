{
  "name": "@aphrody/creator-kit",
  "version": "0.2.4",
  "private": true,
  "description": "Small local tools for a content creator: Challonge bot, wiki image fetch, Adobe and disk cleaners, image compression, video translation.",
  "license": "Apache-2.0",
  "bin": {
    "creator-kit": "src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "build:windows": "bun build --compile --target=bun-windows-x64-baseline --windows-icon=assets/creator-kit.ico --windows-title=\"Creator Kit\" --windows-publisher=MAKIT --windows-version=0.2.4.0 src/cli.ts --outfile dist/creator-kit.exe"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
