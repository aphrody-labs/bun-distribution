{
  "extends": "@rosegriffon/config/tsconfig-nextjs.json",
  "compilerOptions": {
    "noImplicitOverride": false,
    "noUncheckedIndexedAccess": false,
    "types": ["google.maps", "bun", "@webgpu/types"],
    "tsBuildInfoFile": ".next/.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*", "./*"],
      "@public/*": ["./public/*"],
      "@iecode/*": ["../../*"],
      "@rosegriffon/assets": ["../../packages/rg-assets/src/index.ts"],
      "@rosegriffon/assets/*": ["../../packages/rg-assets/src/*"],
      "@rosegriffon/db": ["../../packages/rg-db/src/index.ts"],
      "@rosegriffon/db/*": ["../../packages/rg-db/src/*"],
      "@rosegriffon/types": ["../../packages/rg-types/src/index.ts"],
      "@rosegriffon/types/*": ["../../packages/rg-types/src/*"],
      "@rosegriffon/auth": ["../../packages/rg-auth/src/index.ts"],
      "@rosegriffon/auth/*": ["../../packages/rg-auth/src/*"],
      "@rosegriffon/app-shell": ["../../packages/rg-app-shell/src/index.ts"],
      "@rosegriffon/app-shell/*": ["../../packages/rg-app-shell/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "build", "out", "coverage", ".turbo"]
}
