"use client";

import { Alert, AlertDescription, Button, Card, CardContent, CardDescription, CardHeader, CardTitle, Input } from "@rosegriffon/ui";
import { useState } from "react";
import { useProfile } from "@/contexts/profile-context";

import { Skeleton } from "@rosegriffon/ui";

import { AlertCircle, Check, Loader2 } from "lucide-react";

/**
 * Exemple de composant utilisant la synchronisation de profil en temps réel
 */
export function ProfileEditExample() {
  const { profile, isLoading, error, updateProfile } = useProfile();
  const [isUpdating, setIsUpdating] = useState(false);
  const [displayName, setDisplayName] = useState(profile?.display_name || "");
  const [successMessage, setSuccessMessage] = useState("");

  if (isLoading) {
    return (
      <Card className="w-full max-w-md">
        <CardHeader>
          <Skeleton className="h-8 w-48 mb-2" />
          <Skeleton className="h-4 w-full" />
        </CardHeader>
        <CardContent className="space-y-4">
          <Skeleton className="h-10 w-full" />
          <Skeleton className="h-10 w-32" />
        </CardContent>
      </Card>
    );
  }

  if (error) {
    return (
      <Alert variant="destructive">
        <AlertCircle className="h-4 w-4" />
        <AlertDescription>{error}</AlertDescription>
      </Alert>
    );
  }

  if (!profile) {
    return (
      <Alert>
        <AlertCircle className="h-4 w-4" />
        <AlertDescription>Profil non trouvé</AlertDescription>
      </Alert>
    );
  }

  const handleUpdateDisplayName = async () => {
    if (!displayName.trim()) return;

    setIsUpdating(true);
    setSuccessMessage("");

    try {
      const { data, error: updateError } = await updateProfile({
        display_name: displayName,
      });

      if (updateError) {
        console.error("Erreur lors de la mise à jour:", updateError);
        return;
      }

      setSuccessMessage("Profil mis à jour avec succès !");
      setTimeout(() => setSuccessMessage(""), 3000);

      // Le profil sera automatiquement synchronisé via le broadcast
      console.log("[ProfileEditExample] Profil mis à jour:", data);
    } catch (err) {
      console.error("Erreur inattendue:", err);
    } finally {
      setIsUpdating(false);
    }
  };

  return (
    <Card className="w-full max-w-md">
      <CardHeader>
        <CardTitle>Modifier le profil</CardTitle>
        <CardDescription>
          Les modifications sont synchronisées en temps réel via broadcast
        </CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        {successMessage && (
          <Alert className="border-green-500 text-green-700 dark:text-green-400">
            <Check className="h-4 w-4" />
            <AlertDescription>{successMessage}</AlertDescription>
          </Alert>
        )}

        <div className="space-y-2">
          <label className="text-sm font-medium">Nom d'affichage</label>
          <Input
            value={displayName}
            onChange={(e) => setDisplayName(e.target.value)}
            placeholder="Votre nom"
            disabled={isUpdating}
          />
          <p className="text-xs text-muted-foreground">
            Nom actuel: {profile.display_name || "(non défini)"}
          </p>
        </div>

        <div className="space-y-2">
          <label className="text-sm font-medium">Email</label>
          <div className="px-3 py-2 bg-muted rounded-md text-sm">
            {profile.email || "(non défini)"}
          </div>
        </div>

        <Button
          onClick={handleUpdateDisplayName}
          disabled={
            isUpdating ||
            !displayName.trim() ||
            displayName === profile.display_name
          }
          className="w-full"
        >
          {isUpdating && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
          {isUpdating ? "Mise à jour..." : "Mettre à jour"}
        </Button>

        <div className="text-xs text-muted-foreground bg-muted p-3 rounded-md">
          <p className="font-semibold mb-1">💡 Comment ça fonctionne :</p>
          <ul className="space-y-1 list-disc list-inside">
            <li>Modifiez votre nom d'affichage ci-dessus</li>
            <li>La mise à jour est envoyée à Supabase</li>
            <li>Les trigger DB déclenche un événement broadcast</li>
            <li>Tous les onglets/clients reçoivent la mise à jour</li>
            <li>Le profil se met à jour automatiquement</li>
          </ul>
        </div>
      </CardContent>
    </Card>
  );
}