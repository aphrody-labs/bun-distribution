{
  "name": "@rosegriffon/bot",
  "version": "1.4.4",
  "private": false,
  "description": "Bot Discord Rose Griffon — slash commands public + admin, sync members, canvas cards",
  "license": "Apache-2.0",
  "files": [
    ".oxlintrc.json",
    "README.md",
    "src",
    "test",
    "tsconfig.json",
    "vercel.ts"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:bot": "bun src/index.ts bot",
    "start:api": "bun src/index.ts api",
    "start:all": "bun src/index.ts all",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir=dist",
    "compile": "bun build src/entry-standalone.ts --compile --minify --sourcemap --bytecode --format esm --outfile dist/rg-bot",
    "type-check": "bun check --noEmit",
    "lint": "bun lint src",
    "lint:fix": "bun lint --fix src",
    "test": "bun test --preload ./test/setup.ts src test",
    "smoke:admin": "bun src/scripts/smoke-admin.ts",
    "smoke:canvas": "bun src/scripts/smoke-canvas.ts",
    "typecheck": "bun check --noEmit"
  },
  "dependencies": {
    "@aphrody/canvas": "catalog:",
    "@aphrody/discord-kit": "catalog:",
    "@aphrody/paths": "catalog:",
    "@colyseus/bun-websockets": "catalog:",
    "@colyseus/core": "catalog:",
    "@colyseus/schema": "catalog:",
    "@elysia/eden": "catalog:",
    "@elysiajs/cors": "catalog:",
    "@elysiajs/swagger": "catalog:",
    "@rosegriffon/achillea-client": "workspace:*",
    "@rosegriffon/achillea-core": "workspace:*",
    "@rosegriffon/assets": "workspace:*",
    "@rosegriffon/auth": "workspace:*",
    "@rosegriffon/azalee": "workspace:*",
    "@rosegriffon/cron": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "@rosegriffon/ui": "workspace:*",
    "@vercel/functions": "catalog:",
    "brackets-manager": "catalog:",
    "brackets-model": "catalog:",
    "discord.js": "catalog:",
    "discordx": "catalog:",
    "elysia": "catalog:",
    "express": "catalog:",
    "http-proxy-middleware": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rosegriffon/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "@vercel/config": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
