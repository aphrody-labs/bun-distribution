# ─── Discord ──────────────────────────────────────────────────────────────
# Token du bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token
# Client ID (application ID) — pour register slash commands
DISCORD_CLIENT_ID=your-discord-app-client-id
# Optionnel : restreindre l'enregistrement des slash commands à une seule guild (dev)
GUILD_ID=

# ─── Supabase (partagé avec site rosegriffon + azalee) ────────────────────
# URL interne (ex. http://supabase-kong:8000 en réseau Docker, ou URL publique en local)
SUPABASE_INTERNAL_URL=https://<project-ref>.supabase.co
# Service role key — bypass RLS. SECRET. Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# RG PostgreSQL — Supabase Cloud project `rg`. Use the session pooler for
# application traffic (session pooler, port 5432) and retain TLS. Keep it
# separate from the Neon URL below.
RG_DATABASE_URL=
# Neon project `inagle`, database `inagle`, for gameplay/wiki projections.
INAGLE_DATABASE_URL=
# Prefer SUPABASE_SECRET_KEY; this service-role name remains a compatibility alias.
SUPABASE_SECRET_KEY=
# Compatibility for remaining RG scripts only; if needed, use the same RG URL.
DATABASE_URL=

# ─── Site Rose Griffon (proxy API + URLs pour embeds) ────────────────────
# Base URL du site Next (pour `lib/api.ts` → /api/bot/v1/*)
WEBSITE_API_URL=https://rosegriffon.fr
# Base URL pour les liens (embeds, /chronique read, etc.)
WEBSITE_URL=https://rosegriffon.fr
# Bearer token partagé bot ↔ site (Bot-API-Token côté site)
BOT_API_TOKEN=

# ─── Achillea (dashboard communautaire, dépôt et infra séparés) ───────────
# API unifiée (GET /v1/achillea/guilds, /stats et /:id).
ACHILLEA_UNIFIED_API_URL=https://api.rosegriffon.fr/v1/achillea

# ─── Cache Redis (optionnel — fallback in-memory si absent) ───────────────
REDIS_URL=redis://127.0.0.1:6379/1

# ─── Tuning ───────────────────────────────────────────────────────────────
# Intervalle de re-sync complet des membres (ms). Défaut 30 min.
SYNC_INTERVAL_MS=1800000
