{
  "extends": "@aphrody/m3-config/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "customConditions": ["bun"],
    "types": ["bun", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@aphrody/m3-next": ["../../m3-next/src/index.ts"],
      "@aphrody/m3-reader": ["../../m3-reader/src/index.ts"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*", "m3.config.ts"]
}
