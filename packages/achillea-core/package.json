{
  "name": "@rosegriffon/achillea-core",
  "version": "1.4.4",
  "private": false,
  "description": "Logique métier portable (multi-runtime : navigateur, edge Deno/Web, Node, Bun) — Elo, classement, sanctions, licences, votes, validation. Aucune dépendance Discord / ORM / DI.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./access": "./src/access/index.ts",
    "./auth": "./src/auth/index.ts",
    "./brackets": "./src/brackets/index.ts",
    "./casts": "./src/casts/index.ts",
    "./clans": "./src/clans/index.ts",
    "./elo": "./src/elo/index.ts",
    "./enums": "./src/enums/index.ts",
    "./format": "./src/format/index.ts",
    "./http": "./src/http/index.ts",
    "./identity": "./src/identity/index.ts",
    "./labels": "./src/labels/index.ts",
    "./league": "./src/league/index.ts",
    "./licenses": "./src/licenses/index.ts",
    "./names": "./src/names/index.ts",
    "./numbers": "./src/numbers/index.ts",
    "./oauth": "./src/oauth/index.ts",
    "./pagination": "./src/pagination/index.ts",
    "./participants": "./src/participants/index.ts",
    "./presentation": "./src/presentation/index.ts",
    "./ranking": "./src/ranking/index.ts",
    "./ranked": "./src/ranked/index.ts",
    "./reference": "./src/reference/index.ts",
    "./rulesets": "./src/rulesets/index.ts",
    "./sanctions": "./src/sanctions/index.ts",
    "./stats": "./src/stats/index.ts",
    "./tournaments": "./src/tournaments/index.ts",
    "./validation": "./src/validation/index.ts",
    "./votes": "./src/votes/index.ts",
    "./wallet": "./src/wallet/index.ts"
  },
  "scripts": {
    "lint": "bun lint -c ../rg-config/oxlintrc.json -A style -A pedantic -A restriction src tests",
    "lint:fix": "bun lint -c ../rg-config/oxlintrc.json -A style -A pedantic -A restriction --fix src tests",
    "type-check": "bun check --noEmit",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "test": "bun test",
    "typecheck": "bun check --noEmit"
  },
  "dependencies": {
    "@casl/ability": "catalog:",
    "@rosegriffon/achillea-types": "workspace:*",
    "@sindresorhus/transliterate": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  },
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "src",
    "tests",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
