{
  "name": "@aphrody/n2b-shims",
  "private": true,
  "version": "0.6.2",
  "description": "Alias de compatibilité : ré-exporte @aphrody/n2b-core/shims (polyfills Bun-natifs env, fs, path, shell).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./fs": "./src/fs.ts",
    "./path": "./src/path.ts",
    "./shell": "./src/shell.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/n2b-core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "license": "Apache-2.0"
}
