{
  "name": "@aphrody/n2b-types",
  "private": true,
  "version": "0.6.2",
  "description": "TypeScript types auto-générés depuis schema/v2.json. Source de vérité Rust → TS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false,
  "license": "Apache-2.0"
}
