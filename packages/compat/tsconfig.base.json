{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext"
    ],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "@aphrody/n2b-core": [
        "./n2b-client/src/index.ts"
      ],
      "@aphrody/n2b-core/*": [
        "./n2b-client/src/*"
      ],
      "@aphrody/n2b-types": [
        "./n2b-types/src/index.ts"
      ],
      "@aphrody/n2b-plugin": [
        "./n2b-plugin/src/index.ts"
      ],
      "@aphrody/n2b-plugin/*": [
        "./n2b-plugin/src/*"
      ]
    }
  }
}
