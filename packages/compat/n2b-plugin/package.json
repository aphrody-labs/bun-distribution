{
  "name": "@aphrody/n2b-plugin",
  "version": "0.6.2",
  "description": "Plugin Bun (Bun.plugin) pour le scan N2B Rust natif ou CLI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/n2b-types": "workspace:*",
    "@aphrody/n2b-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false
}
