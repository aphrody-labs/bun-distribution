{
  "name": "@aphrody/n2b-core",
  "version": "0.6.2",
  "description": "TypeScript façade thin pour le binaire Rust n2b — wrapper CLI (scan, rules, promptMarkdown).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bunx --bun tsc -b",
    "start": "bun src/start.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "test": "cargo build -p aphrody-n2b && bun test"
  },
  "dependencies": {
    "@aphrody/n2b-types": "workspace:*",
    "@aphrody/n2b-shims": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false
}
