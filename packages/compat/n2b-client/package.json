{
  "name": "@aphrody/n2b-core",
  "private": true,
  "version": "0.6.2",
  "description": "TypeScript façade thin pour le binaire Rust n2b — wrapper CLI (scan, rules, promptMarkdown) et shims Bun-natifs (./shims: env, fs, path, shell).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./shims": "./src/shims/index.ts",
    "./shims/env": "./src/shims/env.ts",
    "./shims/fs": "./src/shims/fs.ts",
    "./shims/path": "./src/shims/path.ts",
    "./shims/shell": "./src/shims/shell.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "start": "bun src/start.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "cargo build -p aphrody-n2b && bun test"
  },
  "dependencies": {
    "@aphrody/n2b-types": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": false
}
