{
  "name": "@aphrody/bun-forge",
  "version": "0.1.1",
  "description": "yolo forge: builds the aphrody-labs/bun fork on a fresh Linux machine, one temporary checkout per commit",
  "license": "Apache-2.0",
  "files": [
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test",
    "format": "oxfmt src test package.json tsconfig.json",
    "format:check": "oxfmt --check src test package.json tsconfig.json"
  },
  "dependencies": {
    "@aphrody/yolo-core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
