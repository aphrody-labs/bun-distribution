{
  "name": "@aphrody/plugins",
  "version": "1.0.1",
  "description": "Compatibility API for the plugin generator owned by @aphrody/yolo-cli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody.git",
    "directory": "packages/engine/plugins"
  },
  "files": [
    "README.md",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generator": "./src/generator.ts",
    "./schema": "./src/schema.ts",
    "./src/*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test ../yolo/test/plugins.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/yolo-cli": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
