{
  "name": "@aphrody/eslint-plugin-m3",
  "version": "3.3.3",
  "private": true,
  "description": "Lint rules for sites consuming material-web (@aphrody/m3-react + Material Symbols) — runs under oxlint (jsPlugins) and ESLint.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "lint",
    "m3",
    "material-design",
    "material-web",
    "oxlint"
  ],
  "homepage": "https://github.com/aphrody-code/material-web/tree/main/packages/eslint-plugin-m3#readme",
  "bugs": {
    "url": "https://github.com/aphrody-code/material-web/issues"
  },
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-code/material-web.git",
    "directory": "packages/eslint-plugin-m3"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "rules/",
    "data/",
    "README.md"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test/run.ts",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "sync-symbols": "bun scripts/sync-symbol-names.ts"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
