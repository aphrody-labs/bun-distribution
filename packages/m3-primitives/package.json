{
  "name": "@aphrody/m3-primitives",
  "version": "3.3.3",
  "private": true,
  "description": "Material Design 3 React primitives: the SpaceUI (@spacedrive/primitives) component set rebuilt on the M3 roles, shape, typescale, state layers and motion of the aphrody design system.",
  "keywords": [
    "material-3",
    "md3",
    "react",
    "spaceui",
    "tailwind"
  ],
  "license": "Apache-2.0 AND MIT",
  "author": "aphrody-code",
  "files": [
    "dist",
    "LICENSE.spaceui"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts build --only $npm_package_name",
    "typecheck": "bun check --noEmit",
    "typecheck:fast": "bun check --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/m3-motion": "workspace:*",
    "@base-ui/react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "motion": "catalog:",
    "react-hook-form": "catalog:",
    "react-resizable-layout": "^0.7.3",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
