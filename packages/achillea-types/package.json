{
  "name": "@rosegriffon/achillea-types",
  "version": "1.4.4",
  "private": false,
  "description": "Contrats d'API partagés (DTO + enums) — source unique pour le bot et le web",
  "license": "Apache-2.0",
  "files": [
    "src",
    "test",
    "tsconfig.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums/index.ts",
    "./enums/*": "./src/enums/*.ts",
    "./domain/*": "./src/domain/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "bun lint -c ../rg-config/oxlintrc.json -A style -A pedantic -A restriction src test",
    "type-check": "bun check --noEmit",
    "test": "bun test test",
    "typecheck": "bun check --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "brackets-model": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
