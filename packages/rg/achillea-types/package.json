{
  "name": "@rosegriffon/achillea-types",
  "version": "1.0.1",
  "private": true,
  "description": "Contrats d'API partagés (DTO + enums) — source unique pour le bot et le web",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums/index.ts",
    "./enums/*": "./src/enums/*.ts",
    "./domain/*": "./src/domain/*.ts"
  },
  "scripts": {
    "lint": "bunx oxlint -c ../config/oxlintrc.json -A style -A pedantic -A restriction src test",
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test test",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "brackets-model": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
