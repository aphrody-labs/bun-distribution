{
  "name": "@rosegriffon/auth",
  "version": "1.0.3",
  "description": "Shared authentication logic and guards for Rose Griffon apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./elysia": "./src/elysia.ts",
    "./achillea-session": "./src/achillea-session.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test src",
    "lint": "bunx oxlint -c ../../.oxlintrc.json src"
  },
  "dependencies": {
    "@better-auth/agent-auth": "0.5.1",
    "@better-auth/api-key": "1.6.28",
    "@better-auth/oauth-provider": "1.6.28",
    "@better-auth/passkey": "1.6.28",
    "@rosegriffon/achillea-core": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "better-auth": "catalog:",
    "nodemailer": "8.0.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/nodemailer": "8.0.0",
    "next": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
