{
	"name": "@rosegriffon/types",
	"version": "1.0.3",
	"description": "Types métier partagés (roles, user, discord) — source unique de vérité bot/azalee/website",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./roles": "./src/roles.ts",
		"./user": "./src/user.ts",
		"./discord": "./src/discord.ts",
		"./discord-hierarchie": "./src/discord-hierarchie.ts",
		"./bot": "./src/bot.ts",
		"./profil": "./src/profil.ts",
		"./experience": "./src/experience.ts",
		"./cron": "./src/cron.ts",
		"./article": "./src/article.ts",
		"./stats": "./src/stats.ts",
		"./visitor": "./src/visitor.ts",
		"./event": "./src/event.ts",
		"./stream": "./src/stream.ts",
		"./team": "./src/team.ts",
		"./instagram": "./src/instagram.ts",
		"./schemas": "./src/schemas.ts"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"test": "bun test src",
		"lint": "bunx oxlint -c ../../.oxlintrc.json src",
		"type-check": "bun --bun ../../node_modules/typescript/bin/tsc --noEmit"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@rosegriffon/config": "workspace:*",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@rosegriffon/db": "^1.0.0"
	}
}
