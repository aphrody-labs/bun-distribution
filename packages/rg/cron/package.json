{
  "name": "@rosegriffon/cron",
  "version": "1.0.1",
  "private": true,
  "description": "Daemon de tâches planifiées (cron) pour la maintenance DB, CDN et API",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "bun test src",
    "start": "bun src/index.ts",
    "qa:website": "bun src/index.ts --run website:qa",
    "build": "bun build src/index.ts --compile --minify --sourcemap --bytecode --format esm --outfile dist/rg-cron",
    "type-check": "bun --bun tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "bunx oxlint -c ../config/oxlintrc.json src",
    "typecheck": "bun --bun tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@aphrody/paths": "workspace:*",
    "@aphrody/agent-browser": "workspace:*",
    "@aphrody/x": "workspace:*",
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@rosegriffon/assets": "workspace:*",
    "@rosegriffon/auth": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/discord-sync": "workspace:*",
    "@rosegriffon/inagle": "catalog:",
    "@rosegriffon/types": "workspace:*",
    "cheerio": "catalog:",
    "discord.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
