{
  "name": "@rosegriffon/achillea-client",
  "version": "1.0.1",
  "private": true,
  "description": "Versioned HTTP client and runtime contracts for the Achillea guild API",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./v1": "./src/v1/index.ts"
  },
  "scripts": {
