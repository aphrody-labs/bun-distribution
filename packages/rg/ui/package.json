{
	"name": "@rosegriffon/ui",
	"version": "1.0.3",
	"description": "Composants shadcn/ui partagés (new-york style, Tailwind v4)",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": "./src/index.ts",
		"./tokens": "./src/tokens.ts",
		"./lib/utils": "./src/lib/utils.ts",
		"./lib/adsense": "./src/lib/adsense.ts",
		"./styles.css": "./src/styles.css",
		"./hooks/*": "./src/hooks/*.ts",
		"./*": "./src/components/*.tsx"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"lint": "bunx oxlint -c ../../.oxlintrc.json src",
		"type-check": "bun --bun ../../node_modules/typescript/bin/tsc --noEmit",
		"test": "bun test test",
		"tokens": "bun scripts/generer-tokens.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "catalog:",
		"@radix-ui/react-accordion": "catalog:",
