{
  "name": "@rosegriffon/inagle",
  "version": "2.0.4",
  "description": "Universal Game Data API for Inazuma Eleven: Victory Road — parsers, types, and tools for IEVR game data",
  "keywords": [
    "cfg-bin",
    "game-data",
    "iecode",
    "ievr",
    "inazuma-eleven",
    "parser",
    "victory-road",
    "zukan"
  ],
  "homepage": "https://azalee.rosegriffon.fr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rose-griffon/rosegriffon.git",
    "directory": "packages/inagle"
  },
  "bin": {
    "inagle": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./asset-manifest": {
      "types": "./src/data/asset-manifest.generated.ts",
      "import": "./src/data/asset-manifest.generated.ts",
      "default": "./src/data/asset-manifest.generated.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.build.json",
    "cli": "bun src/cli.ts",
    "push": "bun src/cli.ts push",
    "import:cfgbin:postgres": "bun scripts/import-cfgbin-postgres.ts",
    "import:passives:postgres": "bun scripts/import-passives-postgres.ts",
    "import:passive-sheets:postgres": "bun scripts/import-passive-sheets-postgres.ts",
    "import:formations:postgres": "bun scripts/import-formations-postgres.ts",
    "import:skill-cutins:postgres": "bun scripts/import-skill-cutins-postgres.ts",
    "import:asset-manifests:postgres": "bun scripts/import-asset-manifests-postgres.ts",
    "import:cross-catalog:postgres": "bun scripts/import-cross-catalog-postgres.ts",
    "import:cpk-index:postgres": "bun scripts/import-cpk-index-postgres.ts",
    "import:game-text:postgres": "bun scripts/import-game-text-postgres.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "bunx oxlint -c ../../.oxlintrc.json -A style -A pedantic -A restriction src",
    "lint:fix": "bunx oxlint -c ../../.oxlintrc.json -A style -A pedantic -A restriction --fix src",
    "type-check": "bun --bun tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@aphrody-code/zukan": "catalog:",
    "@rosegriffon/db": "workspace:*",
    "@leeoniya/ufuzzy": "catalog:",
    "cheerio": "catalog:",
    "commander": "catalog:",
    "dotenv": "catalog:",
    "kuroshiro": "catalog:",
    "kuroshiro-analyzer-kuromoji": "catalog:",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
