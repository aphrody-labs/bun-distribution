{
  "name": "@rosegriffon/patreon-bun-docs",
  "private": true,
  "description": "The documentation site for the @rosegriffon/patreon-bun",
  "bugs": {
    "url": "https://github.com/rose-griffon/rg/issues/"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate:api": "typedoc",
    "docs:dev": "bun run generate:api && vitepress dev",
    "docs:build": "bun run generate:api && vitepress build",
    "docs:preview": "vitepress preview",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rosegriffon/patreon-bun": "workspace:*"
  },
  "devDependencies": {
    "@vueuse/core": "catalog:",
    "msw": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "vitepress": "catalog:",
    "vue": "catalog:",
    "vuetify": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
