{
  "name": "@aphrody/x",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-code/aphrody-web.git",
    "directory": "packages/x"
  },
  "bugs": {
    "url": "https://github.com/aphrody-code/aphrody-web/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Headless X (Twitter) client in pure TypeScript for Bun. Cookie-auth GraphQL + REST, no API key. Includes local For You algo (x-algorithm port), full stealth, store, and X function tools (XTools, x_* JSON Schema definitions) for Grok or any tool-calling model.",
  "keywords": [
    "aphrody",
    "bun",
    "x",
    "twitter",
    "client",
    "graphql",
    "headless",
    "aphrody-web"
  ],
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "bun test",
    "catalog:sync": "bun ../../apps/bxc/scripts/sync-x-catalog.ts",
    "coverage": "bun ../../apps/bxc/scripts/x-coverage.ts",
    "recon": "bun ../../apps/bxc/scripts/x-premium-recon.ts --profile max"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.4"
  },
  "peerDependencies": {}
}
