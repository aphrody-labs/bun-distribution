{
  "name": "@aphrody/agent-browser",
  "version": "1.0.0-canary",
  "description": "Aphrody Web Bun client: CDP browser automation (agent-browser), engine lifecycle, web service client (fetch, scrape, crawl, sessions) and config reader, backed by the native aphrody-web engine.",
  "license": "Apache-2.0",
  "bin": {
    "agent-browser": "./bin/agent-browser.js"
  },
  "files": [
    "src/",
    "bin/",
    "README.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts",
    "./cdp": "./src/cdp.ts",
    "./config": "./src/config.ts",
    "./engine": "./src/engine.ts",
    "./service": "./src/service.ts",
    "./test-preload": "./src/test-preload.ts",
    "./tauri": "./src/tauri.ts",
    "./runtime": "./src/runtime.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "lint": "oxlint"
  },
  "dependencies": {
    "@aphrody/runtime-sdk": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
