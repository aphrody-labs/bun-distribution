{
  "schemaVersion": 1,
  "note": "Frontend system list (EmulationStation/Recalbox style). `probe` arguments (exit codes in `probeExit`, default 0) qualify a release binary without a game. Each system maps console catalog ids to file extensions, the native Bun Engine machine, upstream release binaries installed by bep (usr/bin) and libretro cores run through RetroArch, in launch-priority order. `dats` are libretro-database files (vendor/libretro-database) matched by CRC32/MD5. `autoDetect` lists extensions too generic to assign a system from the extension alone.",
  "autoDetect": {
    "exclude": [
      "md",
      "bin",
      "iso",
      "img",
      "chd",
      "cue",
      "zip",
      "7z",
      "elf",
      "exe",
      "pbp",
      "cso",
      "pkg",
      "app"
    ]
  },
  "emulators": {
    "tetanes": { "args": ["{file}"], "probe": ["--help"] },
    "mgba": { "args": ["{file}"], "probe": ["--version"] },
    "melonds": { "args": ["{file}"], "probe": ["--help"] },
    "gopher64": { "args": ["{file}"], "probe": ["--help"] },
    "ares": { "args": ["{file}"], "probe": ["--help"] },
    "duckstation": {
      "args": ["-batch", "--", "{file}"],
      "probe": ["-help"],
      "probeExit": [0, 1]
    },
    "pcsx2": {
      "args": ["-batch", "--", "{file}"],
      "probe": ["-help"],
      "probeExit": [0, 1]
    },
    "rpcs3": { "args": ["--no-gui", "{file}"], "probe": ["--version"] },
    "ppsspp": { "args": ["{file}"], "probe": ["--version"] },
    "vita3k": { "args": ["{file}"], "probe": ["--help"] },
    "shadps4": { "args": ["-g", "{file}"], "probe": ["--help"] },
    "azahar": { "args": ["{file}"], "probe": ["-v"] },
    "cemu": { "args": ["-g", "{file}"], "probe": ["--help"] },
    "xemu": { "args": ["-dvd_path", "{file}"], "probe": ["-version"] },
    "flycast": { "args": ["{file}"], "probe": ["--help"] },
    "jgenesis": { "args": ["--file-path", "{file}"], "probe": ["--help"] },
    "mame": { "args": ["-rompath", "{dir}", "{stem}"], "probe": ["-version"] },
    "retroarch": {
      "args": ["-L", "{core}", "{file}"],
      "probe": ["--version"],
      "check": ["-L", "{core}", "{file}", "--max-frames=120"]
    }
  },
  "systems": [
