{
  "name": "@aphrody/winclean",
  "version": "0.1.0",
  "description": "Kernel-backed Bun client for the unified Aphrody OS WinClean catalog (166 tools).",
  "license": "Apache-2.0",
  "author": "aphrody",
  "files": [
    "src",
    "README.md"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --packages external --outdir dist",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/os": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
