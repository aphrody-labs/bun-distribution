{
  "name": "@aphrody/drive-client",
  "version": "0.1.0",
  "description": "Type-safe TypeScript client for Spacedrive daemon",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated/types": {
      "types": "./src/generated/types.ts",
      "default": "./src/generated/types.ts"
    },
    "./src/generated/types": {
      "types": "./src/generated/types.ts",
      "default": "./src/generated/types.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./hooks/useClient": {
      "types": "./src/hooks/useClient.tsx",
      "default": "./src/hooks/useClient.tsx"
    },
    "./hooks/useNormalizedQuery": {
      "types": "./src/hooks/useNormalizedQuery.ts",
      "default": "./src/hooks/useNormalizedQuery.ts"
    },
    "./src/hooks/useClient": {
      "types": "./src/hooks/useClient.tsx",
      "default": "./src/hooks/useClient.tsx"
    },
    "./src/hooks/useNormalizedQuery": {
      "types": "./src/hooks/useNormalizedQuery.ts",
      "default": "./src/hooks/useNormalizedQuery.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test ./tests/integration",
    "generate-types": "cargo run --bin generate_typescript_types --manifest-path ../../../crates/os/drive/core/Cargo.toml"
  },
  "keywords": [
    "spacedrive",
    "client",
    "typescript",
    "daemon"
  ],
  "author": "Spacedrive",
  "license": "FSL-1.1-Apache-2.0",
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@tanstack/react-query": "^5.90.7",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aphrody/assets": "workspace:*",
    "zustand": "^5.0.8",
    "tiny-invariant": "^1.3.3",
    "valibot": "^1.0.0",
    "type-fest": "^4.30.0"
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  }
}
