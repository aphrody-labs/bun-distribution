{
  "name": "@storyteller/ui-pricing-table",
  "version": "1.4.7",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./styles.css": {
      "development": "./src/lib/website-pricing-table.css",
      "default": "./dist/index.css"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.lib.json --threads=2 --no-pretty",
    "lint": "bun lint src",
    "format": "bun fmt --write -c ../../../../../../bun-format.json src"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
