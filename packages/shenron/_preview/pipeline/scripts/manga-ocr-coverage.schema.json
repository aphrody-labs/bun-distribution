{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Shenron Manga OCR Independent Coverage Audit",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "pageId", "verdict", "issues", "notes"],
	"properties": {
		"schemaVersion": { "type": "integer", "enum": [1] },
		"pageId": { "type": "string" },
		"verdict": { "type": "string", "enum": ["confirm", "needs_human"] },
		"issues": {
			"type": "array",
			"maxItems": 100,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["kind", "detail", "confidence"],
				"properties": {
					"kind": {
						"type": "string",
						"enum": ["omitted_region", "misread_text", "wrong_kind", "wrong_order"]
					},
					"detail": { "type": "string", "minLength": 1, "maxLength": 1000 },
					"confidence": { "type": "string", "enum": ["high", "medium", "low"] }
				}
			}
		},
		"notes": { "type": "string", "maxLength": 1000 }
	}
}
