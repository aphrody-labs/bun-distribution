{
	"name": "@shenron/pipeline",
	"version": "0.1.0",
	"private": true,
	"description": "Shenron compute clients and Dragon Ball data pipeline: AI, Aphrody services, BXC and OCR/RAG workflows",
	"type": "module",
	"main": "./src/index.ts",
	"bin": {
		"pipeline": "./src/cli.ts"
	},
	"scripts": {
		"pipeline": "bun src/cli.ts",
		"build": "bun build src/cli.ts --target=bun --outfile=dist/pipeline",
		"type-check": "bun ../../node_modules/typescript/bin/tsc --noEmit && bun ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.scripts.json",
		"lint": "oxlint",
		"test": "bun test"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "catalog:",
		"@ai-sdk/provider": "catalog:",
		"ai": "catalog:",
		"@shenron/config": "workspace:*",
		"@shenron/db": "workspace:*",
		"postgres": "catalog:",
		"sharp": "catalog:",
		"sqlite-vec": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./ai/config": "./src/ai/config.ts",
		"./ai/prompts": "./src/ai/prompts.ts",
		"./ai/chat": "./src/ai/chat.ts",
		"./ai/embeddings": "./src/ai/embeddings.ts",
		"./ai/ports": "./src/ai/ports.ts",
		"./ai/generate": "./src/ai/generate.ts",
		"./ai/eval": "./src/ai/eval.ts",
		"./ai/index": "./src/ai/index.ts",
		"./ai/aphrody": "./src/ai/aphrody.ts",
		"./ai/provider": "./src/ai/provider.ts",
		"./ai/wire": "./src/ai/wire.ts",
		"./aphrody/remote-ocr": "./src/aphrody/remote-ocr.ts",
		"./aphrody/a2a-probes": "./src/aphrody/a2a-probes.ts",
		"./aphrody/shenron-embeddings": "./src/aphrody/shenron-embeddings.ts",
		"./aphrody/a2a": "./src/aphrody/a2a.ts",
		"./aphrody/cli": "./src/aphrody/cli.ts",
		"./aphrody/compute": "./src/aphrody/compute.ts",
		"./aphrody/index": "./src/aphrody/index.ts",
		"./aphrody/native": "./src/aphrody/native.ts",
		"./aphrody/web": "./src/aphrody/web.ts",
		"./bxc/types": "./src/bxc/types.ts",
		"./bxc/cli": "./src/bxc/cli.ts",
		"./manga-ocr": "./src/manga-ocr.ts",
		"./bxc/cli": "./src/bxc/cli.ts",
		"./bxc/voiranime": "./src/bxc/services.ts",
		"./bxc/spawn": "./src/bxc/spawn.ts",
		"./bxc/wiki": "./src/bxc/services.ts",
		"./bxc/db": "./src/bxc/services.ts",
		"./bxc/media": "./src/bxc/services.ts",
		"./bxc/animesama": "./src/bxc/services.ts",
		"./bxc/index": "./src/bxc/index.ts",
		"./bxc/google": "./src/bxc/services.ts",
		"./bxc/frames": "./src/bxc/services.ts",
		"./bxc/dragonballcn": "./src/bxc/services.ts",
		"./compute": "./src/aphrody/compute.ts",
		"./embeddings": "./src/aphrody/shenron-embeddings.ts",
		"./web": "./src/aphrody/web.ts",
		"./a2a": "./src/aphrody/a2a.ts",
		"./cli": "./src/aphrody/cli.ts",
		"./remote-ocr": "./src/aphrody/remote-ocr.ts",
		"./native": "./src/aphrody/native.ts",
		"./ai": "./src/ai/index.ts",
		"./aphrody": "./src/aphrody/index.ts",
		"./bxc": "./src/bxc/index.ts",
		"./aphrody/embeddings": "./src/aphrody/shenron-embeddings.ts"
	},
	"shenron": {
		"runtime": {
			".": "bun",
			"./ai/config": "pure",
			"./ai/prompts": "pure",
			"./ai/chat": "pure",
			"./ai/embeddings": "server",
			"./ai/ports": "pure",
			"./ai/generate": "server",
			"./ai/eval": "pure",
			"./ai/index": "pure",
			"./ai/aphrody": "pure",
			"./ai/provider": "server",
			"./ai/wire": "pure",
			"./aphrody/remote-ocr": "bun",
			"./aphrody/a2a-probes": "server",
			"./aphrody/shenron-embeddings": "server",
			"./aphrody/a2a": "server",
			"./aphrody/cli": "bun",
			"./aphrody/compute": "server",
			"./aphrody/index": "server",
			"./aphrody/native": "bun",
			"./aphrody/web": "server",
			"./bxc/types": "bun",
			"./bxc/cli": "bun",
			"./manga-ocr": "bun",
			"./bxc/cli": "bun",
			"./bxc/voiranime": "bun",
			"./bxc/spawn": "bun",
			"./bxc/wiki": "bun",
			"./bxc/db": "bun",
			"./bxc/media": "bun",
			"./bxc/animesama": "bun",
			"./bxc/index": "bun",
			"./bxc/google": "bun",
			"./bxc/frames": "bun",
			"./bxc/dragonballcn": "bun",
			"./compute": "server",
			"./embeddings": "server",
			"./web": "server",
			"./a2a": "server",
			"./cli": "bun",
			"./remote-ocr": "bun",
			"./native": "bun",
			"./ai": "pure",
			"./aphrody": "server",
			"./bxc": "bun",
			"./aphrody/embeddings": "server"
		}
	},
	"sideEffects": false
}
