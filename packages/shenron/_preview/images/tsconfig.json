{
  "compilerOptions": {
    "types": ["bun"],
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "tests/**/*"]
}
