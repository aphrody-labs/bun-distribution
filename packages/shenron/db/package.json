{
  "name": "@shenron/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL partagé Shenron : schéma Drizzle, pool postgres-js (Next) et driver Bun.SQL (scripts, API), indépendant du framework",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./bot-schema": "./src/bot-schema.ts",
    "./full-schema": "./src/full-schema.ts",
    "./constants": "./src/constants.ts",
    "./config": "./src/config.ts",
    "./types": "./src/types.ts",
    "./sql": "./src/sql.ts",
    "./postgres-js": "./src/postgres-js.ts",
    "./bun-sql": "./src/bun-sql.ts",
    "./bun": "./src/bun.ts",
    "./env": "./src/env.ts",
    "./wiki-registry": "./src/wiki-registry.ts",
    "./repos/wiki": "./src/repos/wiki.ts",
    "./repos/agent-keys": "./src/repos/agent-keys.ts",
    "./repos/accounts": "./src/repos/accounts.ts",
    "./guards": "./src/guards.ts",
    "./redis": "./src/redis.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json",
    "test": "bun test",
    "audit:migrations": "bun scripts/migration-audit.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/sql": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9",
    "@shenron/config": "workspace:*"
  },
  "shenron": {
    "runtime": {
      ".": "server",
      "./schema": "pure",
      "./bot-schema": "pure",
      "./full-schema": "pure",
      "./constants": "pure",
      "./config": "pure",
      "./types": "pure",
      "./sql": "server",
      "./postgres-js": "server",
      "./bun-sql": "bun",
      "./bun": "bun",
      "./env": "server",
      "./wiki-registry": "pure",
      "./repos/wiki": "pure",
      "./repos/agent-keys": "pure",
      "./repos/accounts": "pure",
      "./guards": "server",
      "./redis": "bun"
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
