    "./testing/live-rag": "./src/testing/live-rag.ts",
    "./ai/native": "./src/ai/native.ts"
  },
  "scripts": {
    "pipeline": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/pipeline",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "oxlint -c ../.oxlintrc.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rag:prepare": "bun scripts/prepare-live-rag.ts",
    "rag:test": "bun scripts/test-live-rag.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
