      "./bxc/index": "bun",
      "./bxc/google": "bun",
      "./bxc/frames": "bun",
      "./bxc/dragonballcn": "bun",
      "./compute": "server",
      "./embeddings": "server",
      "./web": "server",
      "./a2a": "server",
      "./cli": "bun",
      "./remote-ocr": "bun",
      "./native": "bun",
      "./ai": "pure",
      "./aphrody": "server",
      "./bxc": "bun",
      "./aphrody/embeddings": "server",
      "./testing/live-rag": "bun",
      "./ai/native": "bun"
    }
