      "./races": "pure",
      "./races-alias": "pure",
      "./economy-canon": "pure",
      "./inflation-rules": "pure",
      "./fusion-names": "pure",
      "./xp": "pure",
      "./techniques-types": "pure",
      "./tsconfig/base.json": "json",
      "./tsconfig/bun.json": "json",
      "./tsconfig/react.json": "json",
      "./slug": "pure",
      "./wiki-slugs": "pure",
      "./databooks-defauts": "pure",
      "./aphrody-corpus": "pure"
