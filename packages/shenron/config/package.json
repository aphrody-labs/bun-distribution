    "./tsconfig/bun.json": "./tsconfig/bun.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./slug": "./src/slug.ts",
    "./wiki-slugs": "./src/wiki-slugs.ts",
    "./databooks-defauts": "./src/databooks-defauts.ts",
