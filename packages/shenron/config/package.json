    "./env": "./src/env.ts",
    "./net": "./src/net.ts",
    "./paths": "./src/paths.ts",
    "./public-urls": "./src/public-urls.ts",
    "./services": "./src/services.ts",
    "./guards": "./src/guards.ts",
    "./testing": "./src/testing.ts",
    "./zeni": "./src/zeni.ts",
    "./races": "./src/races.ts",
    "./races-alias": "./src/races-alias.ts",
    "./economy-canon": "./src/economy-canon.ts",
    "./inflation-rules": "./src/inflation-rules.ts",
    "./fusion-names": "./src/fusion-names.ts",
    "./xp": "./src/xp.ts",
    "./techniques-types": "./src/techniques-types.ts",
