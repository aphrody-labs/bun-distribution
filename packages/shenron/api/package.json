{
  "name": "@shenron/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./client": "./src/client/index.ts",
    "./http": "./src/http.ts",
    "./server": "./src/server/index.ts",
    "./next": "./src/next.ts",
    "./openapi.json": "./openapi/public.json"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json",
    "test": "bun test",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@shenron/config": "workspace:*",
    "@shenron/db": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:",
    "@aphrody/http": "workspace:*"
  },
  "devDependencies": {
    "drizzle-orm": "catalog:"
  },
  "shenron": {
    "runtime": {
      "./contract": "pure",
      "./client": "pure",
      "./http": "pure",
      "./server": "hono",
      "./next": "server",
      "./openapi.json": "json"
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
