{
	"openapi": "3.1.0",
	"info": {
		"title": "Shenron public API",
		"version": "1.0.0",
		"description": "Routes served by @shenron/api inside shenron-bot and shenron-site (docs/STACK.md §3.6)."
	},
	"components": {
		"schemas": {
			"OpenApiDocument": {
				"type": "object",
				"properties": {
					"openapi": {
						"type": "string"
					}
				},
				"required": [
					"openapi"
				],
				"additionalProperties": {}
			},
			"ErrorEnvelope": {
				"type": "object",
				"properties": {
					"error": {
						"type": "string"
					},
					"code": {
						"$ref": "#/components/schemas/ApiErrorCode"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [
					"error"
				]
			},
			"ApiErrorCode": {
				"type": "string",
				"enum": [
					"not_found",
					"invalid_request",
					"rate_limited",
					"unauthenticated",
					"forbidden",
					"pg_unavailable",
					"upstream_unavailable",
					"internal"
				]
			},
			"WikiCategoriesResponse": {
				"type": "object",
				"properties": {
					"categories": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/WikiCategorySummary"
						}
					}
				},
				"required": [
					"categories"
				]
			},
			"WikiCategorySummary": {
				"type": "object",
				"properties": {
					"name": {
						"$ref": "#/components/schemas/WikiCategoryName"
					},
					"label": {
						"type": "string"
					},
					"total": {
						"type": "integer",
						"minimum": 0
					}
				},
				"required": [
					"name",
					"label",
					"total"
				]
			},
			"WikiCategoryName": {
				"type": "string",
				"enum": [
					"characters",
					"planets",
					"races",
					"techniques",
					"transformations",
					"sagas",
					"arcs",
					"episodes",
					"movies",
					"games",
					"tools",
					"battles",
					"items",
					"dragons",
					"wishes",
					"locations",
					"tournaments",
					"voice_actors",
					"soundtracks",
					"power_levels",
					"timeline_events"
				]
			},
			"WikiListResponse": {
				"type": "object",
				"properties": {
					"category": {
						"$ref": "#/components/schemas/WikiCategoryName"
					},
					"items": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/WikiEntity"
						}
					},
					"total": {
						"type": "integer",
						"minimum": 0
					},
					"limit": {
						"type": "integer"
					},
					"offset": {
						"type": "integer"
					}
				},
				"required": [
					"category",
					"items",
					"total",
					"limit",
					"offset"
				]
			},
			"WikiEntity": {
				"type": "object",
				"additionalProperties": {}
			}
		},
		"parameters": {}
	},
	"paths": {
		"/api/public/openapi.json": {
			"get": {
				"operationId": "openApiDocument",
				"tags": [
					"Meta"
				],
				"summary": "OpenAPI 3.1 document of the Shenron public API",
				"responses": {
					"200": {
						"description": "OpenAPI document",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/OpenApiDocument"
								}
							}
						}
					},
					"400": {
						"description": "Invalid request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"404": {
						"description": "Not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"429": {
						"description": "Rate limited",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"500": {
						"description": "Internal error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"503": {
						"description": "PostgreSQL unavailable",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					}
				}
			}
		},
		"/api/public/wiki/categories": {
			"get": {
				"operationId": "wikiCategories",
				"tags": [
					"Wiki"
				],
				"summary": "Public wiki categories with their visible totals",
				"responses": {
					"200": {
						"description": "Categories",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WikiCategoriesResponse"
								}
							}
						}
					},
					"400": {
						"description": "Invalid request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"404": {
						"description": "Not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"429": {
						"description": "Rate limited",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"500": {
						"description": "Internal error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"503": {
						"description": "PostgreSQL unavailable",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					}
				}
			}
		},
		"/api/public/wiki/{category}": {
			"get": {
				"operationId": "wikiList",
				"tags": [
					"Wiki"
				],
				"summary": "Visible entries of a wiki category",
				"parameters": [
					{
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"description": "Wiki category name"
						},
						"required": true,
						"description": "Wiki category name",
						"name": "category",
						"in": "path"
					},
					{
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 200,
							"default": 50
						},
						"required": false,
						"name": "limit",
						"in": "query"
					},
					{
						"schema": {
							"type": [
								"integer",
								"null"
							],
							"minimum": 0,
							"default": 0
						},
						"required": false,
						"name": "offset",
						"in": "query"
					},
					{
						"schema": {
							"type": "string",
							"maxLength": 200
						},
						"required": false,
						"name": "q",
						"in": "query"
					}
				],
				"responses": {
					"200": {
						"description": "Page of entries",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WikiListResponse"
								}
							}
						}
					},
					"400": {
						"description": "Invalid request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"404": {
						"description": "Not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"429": {
						"description": "Rate limited",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"500": {
						"description": "Internal error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"503": {
						"description": "PostgreSQL unavailable",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					}
				}
			}
		},
		"/api/public/wiki/{category}/{idOrSlug}": {
			"get": {
				"operationId": "wikiEntity",
				"tags": [
					"Wiki"
				],
				"summary": "One visible wiki entry by numeric id or slug",
				"parameters": [
					{
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"description": "Wiki category name"
						},
						"required": true,
						"description": "Wiki category name",
						"name": "category",
						"in": "path"
					},
					{
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 200,
							"description": "Numeric id or slug"
						},
						"required": true,
						"description": "Numeric id or slug",
						"name": "idOrSlug",
						"in": "path"
					}
				],
				"responses": {
					"200": {
						"description": "Entry",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/WikiEntity"
								}
							}
						}
					},
					"400": {
						"description": "Invalid request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"404": {
						"description": "Not found",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"429": {
						"description": "Rate limited",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"500": {
						"description": "Internal error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					},
					"503": {
						"description": "PostgreSQL unavailable",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorEnvelope"
								}
							}
						}
					}
				}
			}
		}
	},
	"webhooks": {}
}
