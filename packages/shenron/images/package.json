{
  "name": "@shenron/images",
  "version": "0.1.0",
  "private": true,
  "description": "Image hashing, deduplication, variant selection and sourced illustration picking for Shenron (Bun + sharp)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./variants": {
      "types": "./src/variants.ts",
      "default": "./src/variants.ts"
    },
    "./resolve": {
      "types": "./src/resolve.ts",
      "default": "./src/resolve.ts"
    },
    "./ink-stroke": {
      "types": "./src/ink-stroke.ts",
      "default": "./src/ink-stroke.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sharp": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
