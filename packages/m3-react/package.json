{
  "name": "@aphrody/m3-react",
  "version": "3.3.3",
  "private": true,
  "description": "React wrappers (@lit/react createComponent) for every <md-*> element of the @aphrody/material-web fork.",
  "homepage": "https://github.com/aphrody-code/material-web/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/aphrody-code/material-web/issues"
  },
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-code/material-web.git",
    "directory": "packages/m3-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/**/*.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./index.ts",
      "import": "./index.ts",
      "default": "./dist/index.js"
    },
    "./transitions": {
      "types": "./dist/transitions/index.d.ts",
      "bun": "./transitions/index.ts",
      "import": "./transitions/index.ts",
      "default": "./dist/transitions/index.js"
    },
    "./adaptive": {
      "types": "./dist/adaptive/index.d.ts",
      "bun": "./adaptive/index.ts",
      "import": "./adaptive/index.ts",
      "default": "./dist/adaptive/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "bun": "./state/index.ts",
      "import": "./state/index.ts",
      "default": "./dist/state/index.js"
    },
    "./adapters/tanstack": {
      "types": "./dist/adapters/tanstack.d.ts",
      "bun": "./adapters/tanstack.ts",
      "import": "./adapters/tanstack.ts",
      "default": "./dist/adapters/tanstack.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./wrappers/*.ts",
      "bun": "./wrappers/*.ts",
      "import": "./wrappers/*.ts",
      "default": "./wrappers/*.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run generate.ts",
    "build": "bun ../../scripts/build.ts build --only $npm_package_name",
    "typecheck": "bun check --noEmit",
    "typecheck:fast": "bun check --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/material-web": "catalog:",
    "@lit/react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
