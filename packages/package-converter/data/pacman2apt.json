{
  "schemaVersion": 1,
  "description": "pacman2apt curated policy: target ABI defaults, protected packages and Arch-to-Ubuntu name mappings. Values are Debian relation strings (comma = all of, | = alternatives); null drops the dependency because the target base system or kernel owns it.",
  "target": {
    "distribution": "ubuntu",
    "release": "26.10",
    "series": "stonking",
    "architecture": "amd64",
    "abi": {
      "GLIBC": "2.44",
      "GLIBCXX": "3.4.36",
      "CXXABI": "1.3.17"
    }
  },
  "nameSuffix": {
    "cachyos": "-cachyos",
    "archlinux": "-arch",
    "omarchy": "-omarchy"
  },
  "protected": [
    "glibc",
    "lib32-glibc",
    "gcc-libs",
    "lib32-gcc-libs",
    "libgcc",
    "lib32-libgcc",
    "libstdc++",
    "lib32-libstdc++",
    "mesa",
    "mesa-*",
    "lib32-mesa",
    "lib32-mesa-*",
    "vulkan-radeon",
    "vulkan-intel",
    "vulkan-nouveau",
    "lib32-vulkan-radeon",
    "lib32-vulkan-intel",
    "systemd",
    "systemd-*",
    "lib32-systemd",
    "linux",
    "linux-*",
    "filesystem",
    "pacman",
    "pacman-*",
    "bash",
    "coreutils",
    "util-linux",
    "util-linux-libs",
    "shadow",
    "pam",
    "dbus",
    "dbus-broker",
    "openssl",
    "ca-certificates*",
    "archlinux-keyring",
    "cachyos-keyring",
    "omarchy-keyring"
  ],
  "override": {
    "glibc": "libc6",
    "lib32-glibc": "libc6-i386",
    "gcc-libs": "libgcc-s1, libstdc++6",
    "libgcc": "libgcc-s1",
    "libstdc++": "libstdc++6",
    "lib32-gcc-libs": "lib32gcc-s1, lib32stdc++6",
    "lib32-libgcc": "lib32gcc-s1",
    "lib32-libstdc++": "lib32stdc++6",
    "systemd": "systemd",
    "systemd-libs": "libsystemd0, libudev1",
    "lib32-systemd": "libsystemd0:i386, libudev1:i386",
    "systemd-sysvcompat": "systemd-sysv",
    "sh": null,
    "bash": "bash",
    "coreutils": "coreutils",
    "util-linux": "util-linux",
    "dbus": "dbus",
    "python": "python3",
    "python3": "python3",
    "perl": "perl",
    "ruby": "ruby",
    "nodejs": "nodejs",
    "lua": "lua5.4",
    "openssl": "openssl"
  },
  "map": {
    "vulkan-driver": "mesa-vulkan-drivers | vulkan-icd",
    "lib32-vulkan-driver": "mesa-vulkan-drivers:i386 | vulkan-icd:i386",
    "opengl-driver": "libgl1-mesa-dri",
    "lib32-opengl-driver": "libgl1-mesa-dri:i386",
    "libgl": "libgl1",
    "lib32-libgl": "libgl1:i386",
    "ttf-font": "fonts-dejavu-core | fonts-liberation | fonts-freefont-ttf",
    "lib32-alsa-plugins": "libasound2-plugins:i386",
    "lib32-pipewire": "libpipewire-0.3-0t64:i386, libspa-0.2-modules:i386",
    "alsa-plugins": "libasound2-plugins",
    "lsb-release": "lsb-release",
    "xorg-xrandr": "x11-xserver-utils",
    "xorg-xwayland": "xwayland",
    "xorg-server-xwayland": "xwayland",
    "desktop-file-utils": "desktop-file-utils",
    "hicolor-icon-theme": "hicolor-icon-theme",
    "xdg-user-dirs": "xdg-user-dirs",
    "xdg-utils": "xdg-utils",
    "usbutils": "usbutils",
    "pciutils": "pciutils",
    "lsof": "lsof",
    "curl": "curl",
    "wget": "wget",
    "xz": "xz-utils",
    "zstd": "zstd",
    "diffutils": "diffutils",
    "findutils": "findutils",
    "grep": "grep",
    "sed": "sed",
    "gawk": "gawk",
    "awk": "gawk | mawk",
    "tar": "tar",
    "gzip": "gzip",
    "which": "debianutils",
    "procps-ng": "procps",
    "iproute2": "iproute2",
    "iw": "iw",
    "inxi": "inxi",
    "wireless-regdb": "wireless-regdb",
    "zram-generator": "systemd-zram-generator",
    "power-profiles-daemon": "power-profiles-daemon",
    "git": "git",
    "jq": "jq",
    "fzf": "fzf",
    "gum": "gum",
    "unzip": "unzip",
    "cabextract": "cabextract",
    "attr": "attr",
    "gettext": "gettext-base",
    "polkit": "polkitd",
    "pipewire": "pipewire",
    "wireplumber": "wireplumber",
    "xorg-server": "xserver-xorg-core",
    "kmod": "kmod",
    "steam": "steam-installer",
    "NTSYNC-MODULE": null,
    "ntsync-module": null,
    "vulkan-headers": null,
    "libxcrypt-compat": "libcrypt1",
    "lib32-libxcrypt-compat": "libcrypt1:i386"
  }
}
