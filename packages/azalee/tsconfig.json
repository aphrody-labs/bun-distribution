{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "noUncheckedIndexedAccess": false,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "paths": {
      "@rosegriffon/inagle": ["../inagle/src/index.ts"],
      "@rosegriffon/inagle/*": ["../inagle/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "../inagle/src/types/**/*.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
