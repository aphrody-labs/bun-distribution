{
  "name": "@aphrody/bun",
  "version": "3.3.8",
  "description": "Native Rust FFI wrappers for Bun.",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "files": [
    "src",
    "bindings",
    "native"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*.js": "./src/*.ts",
    "./src/*": "./src/*",
    "./cli": "./src/cli.ts",
    "./web": "./src/web.ts",
    "./web/pipeline": "./src/pipeline.ts",
    "./x": "./src/x.ts",
    "./n2b": "./src/n2b.ts",
    "./oxc": "./src/oxc.ts",
    "./zerocopy": "./src/zerocopy.ts",
    "./spawn-sync": "./src/spawn-sync.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bash ../../../scripts/build/rust/cargo-serial.sh build --release --locked -p aphrody-ffi --features gpu",
    "test": "bash ../../../scripts/build/rust/cargo-serial.sh build --release --locked -p aphrody-ffi --features gpu && APHRODY_FFI_DEV=1 APHRODY_FFI_REQUIRE_NATIVE=1 bun test test-library.test.ts test-native.test.ts test-native-artifact.test.ts test-pipeline.test.ts && APHRODY_FFI_DEV=1 bun run test-ffi.ts && APHRODY_FFI_DEV=1 bun run test-cli-only.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/runtime-sdk": "workspace:*",
    "@aphrody/update": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
