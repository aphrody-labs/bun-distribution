{
	"extends": "../rg-config/tsconfig-bun.json",
	"compilerOptions": {
		"outDir": "dist",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"skipLibCheck": true,
		"rootDir": "..",
		"paths": {
			"@rosegriffon/assets": ["../assets/src/index.ts"],
			"@rosegriffon/assets/*": ["../assets/src/*"],
			"@rosegriffon/db": ["../db/src/index.ts"],
			"@rosegriffon/db/*": ["../db/src/*"],
			"@rosegriffon/types": ["../types/src/index.ts"],
			"@rosegriffon/types/*": ["../types/src/*"],
			"@rosegriffon/auth": ["../auth/src/index.ts"],
			"@rosegriffon/auth/*": ["../auth/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
