{
  "name": "@rosegriffon/cron",
  "version": "1.4.4",
  "private": false,
  "description": "Tâches planifiées Rose Griffon (maintenance DB, Discord, campagnes, SEO) : registre, route HTTP serverless et CLI",
  "license": "Apache-2.0",
  "files": [
    ".npmignore",
    "src",
    "tsconfig.json",
    "tsconfig.typecheck.json",
    "types"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "test": "bun test src",
    "start": "bun src/index.ts",
    "qa:website": "bun src/index.ts --run website:qa",
    "compile": "bun build src/index.ts --compile --minify --sourcemap --bytecode --format esm --outfile dist/rg-cron",
    "type-check": "bun check -p tsconfig.typecheck.json --noEmit",
    "lint": "bun lint -c ../rg-config/oxlintrc.json src",
    "typecheck": "bun check -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@aphrody/agent-browser": "catalog:",
    "@aphrody/paths": "catalog:",
    "@aphrody/x": "catalog:",
    "@rosegriffon/assets": "workspace:*",
    "@rosegriffon/db": "workspace:*",
    "@rosegriffon/discord-sync": "workspace:*",
    "@rosegriffon/inagle": "workspace:*",
    "@rosegriffon/types": "workspace:*",
    "@vercel/functions": "catalog:",
    "cheerio": "catalog:",
    "discord.js": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
