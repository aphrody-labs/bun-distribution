INAGLE_DATABASE_URL=
# Alias de compatibilité pour les scripts RG encore historiques.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_INTERNAL_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Discord ─────────────────────────────────────────────────────────────────
