# ─── API / déclenchement des tâches ──────────────────────────────────────────
CRON_SECRET=
# API_URL = gateway nginx api.rosegriffon.fr (health-check uniquement, futurs outils Rust).
# NE sert PLUS à router les routes cron : publish-scheduled vit sur AZALEE_URL,
# patreon-refresh/-reminders sur WEBSITE_URL (voir src/tasks/api.ts).
API_URL=https://api.rosegriffon.fr
WEBSITE_URL=https://rosegriffon.fr
AZALEE_URL=https://azalee.rosegriffon.fr
CDN_URL=https://cdn.rosegriffon.fr
GITHUB_TOKEN=

# ─── SEO / IndexNow ──────────────────────────────────────────────────────────
# Clé IndexNow (publique par design du protocole : un fichier <clé>.txt contenant
# cette valeur est servi à la racine de chaque site). Si absente, un fallback
# constant est utilisé (voir src/tasks/seo/indexnow.ts) et DOIT correspondre au
# fichier apps/*/public/<clé>.txt.
INDEXNOW_KEY=fd6605d39faf4ed0bef411e08138ed59
