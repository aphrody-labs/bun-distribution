{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@rosegriffon/assets": ["../assets/src/index.ts"],
      "@rosegriffon/assets/*": ["../assets/src/*"],
      "@rosegriffon/db": ["../db/src/index.ts"],
      "@rosegriffon/db/*": ["../db/src/*"],
      "@rosegriffon/types": ["../types/src/index.ts"],
      "@rosegriffon/types/*": ["../types/src/*"],
      "@rosegriffon/auth": ["../auth/src/index.ts"],
      "@rosegriffon/auth/*": ["../auth/src/*"],
      "@aphrody/x": ["./types/x-shim.d.ts"],
      "@aphrody/x/*": ["./types/x-shim.d.ts"]
    }
  }
}
