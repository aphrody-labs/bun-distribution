{
  "name": "@aphrody/sql",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Bun database mechanics for Aphrody: env/URL resolution, Bun.SQL and Redis factories, bun:sqlite open policy with optional sqlite-vec",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./postgres": "./src/postgres.ts",
    "./redis": "./src/redis.ts",
    "./sqlite": "./src/sqlite.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../../.oxlintrc.json src test"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
