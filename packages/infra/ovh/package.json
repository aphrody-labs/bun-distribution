{
  "name": "@aphrody/ovh",
  "version": "0.2.0",
  "description": "Unified OVH cloud engine for Aphrody Infra: DNS, VPS, Email, and multi-profile operations in pure Bun",
  "license": "Apache-2.0",
  "bin": {
    "aphrody-ovh": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./dns": "./src/dns.ts",
    "./vps": "./src/vps.ts",
    "./email": "./src/email.ts",
    "./profiles": "./src/profiles.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts --target bun --packages external --outdir dist",
    "lint": "oxlint src test",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun ./src/cli.ts check",
    "dns": "bun ./src/cli.ts dns",
    "vps": "bun ./src/cli.ts vps",
    "email": "bun ./src/cli.ts email"
  },
  "dependencies": {},
  "engines": {
    "bun": ">=1.4.2"
  }
}
