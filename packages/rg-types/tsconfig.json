{
	"extends": "@rosegriffon/config/tsconfig-base.json",
	"compilerOptions": {
		"outDir": "dist",
		"noEmit": true,
		"declaration": false,
		"types": ["bun"],
		"lib": ["ESNext", "DOM"],
		"rootDir": "..",
		// `@rosegriffon/db` est déclaré en `peerDependencies` et non en `dependencies` :
		// `packages/db` importe `DashboardStats` d'ici, donc une dépendance directe créerait
		// un cycle que turbo refuse ("Cyclic dependency detected"). Ces alias assurent la
		// résolution locale sans passer par le hoisting de node_modules.
		"paths": {
			"@rosegriffon/db": ["../db/src/index.ts"],
			"@rosegriffon/db/*": ["../db/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
