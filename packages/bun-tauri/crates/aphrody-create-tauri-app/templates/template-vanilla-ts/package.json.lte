  "dependencies": {
    {% if v2 %}"@aphrody/tauri": "^1.4.4"{% else %}"@tauri-apps/api": "^1"{% endif %}
  },
  "devDependencies": {
    {% if v1 %}"@tauri-apps/cli": "^1",{% endif %}
    "@types/bun": "^1.4.2",
    "typescript": "~6.0.3"
  }
}
