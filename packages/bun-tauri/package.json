{
  "name": "@aphrody/tauri",
  "version": "1.4.7",
  "description": "Tauri API, every plugin guest binding of tauri-plugin-aphrody, and the Bun runtime bridge",
  "license": "Apache-2.0 OR MIT",
  "files": [
    "js",
    "crates/tauri-plugin-aphrody/iife",
    "README.md",
    "LICENSE-*"
  ],
  "type": "module",
  "exports": {
    ".": "./js/index.ts",
    "./api": "./js/api/index.ts",
    "./api/*": "./js/api/*.ts",
    "./plugins/*": "./js/plugins/*.ts",
    "./bun": "./js/bun.ts",
    "./server": "./js/server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "bun ../../scripts/cargo.ts exec -- check --locked -p tauri-plugin-aphrody --tests",
    "test": "bun ../../scripts/cargo.ts exec -- test --locked -p tauri-plugin-aphrody"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
