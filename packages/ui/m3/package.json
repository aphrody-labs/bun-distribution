{
  "name": "@aphrody/m3",
  "version": "3.3.7",
  "description": "The @aphrody Material Design 3 framework for Bun: one plugin (Tailwind v4, Sass through Rust, m3:* virtual theme/font modules, ?url imports), serveM3 (Bun.serve + HMR + proxy), buildM3 (Bun.build, Tauri webview layout), M3App and the m3 CLI.",
  "keywords": [
    "bun",
    "material-3",
    "md3",
    "tailwind",
    "tauri"
  ],
  "homepage": "https://github.com/aphrody-labs/aphrody-m3/tree/main/packages/m3#readme",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody-m3.git",
    "directory": "packages/m3"
  },
  "bin": {
    "m3": "./bin/m3.ts"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "client.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/lit.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "bun": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "bun": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./build": {
      "bun": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./config": {
      "bun": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./react": {
      "bun": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./native": {
      "bun": "./src/native-layout.ts",
      "types": "./dist/native-layout.d.ts",
      "browser": "./src/native-layout.ts",
      "import": "./src/native-layout.ts",
      "default": "./dist/native-layout.js"
    },
    "./native-react": {
      "bun": "./src/native-layout-react.tsx",
      "types": "./dist/native-layout-react.d.ts",
      "browser": "./src/native-layout-react.tsx",
      "import": "./src/native-layout-react.tsx",
      "default": "./dist/native-layout-react.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "default": "./dist/lit.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./i18n": {
      "bun": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./src/i18n.ts",
      "default": "./dist/i18n.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../../scripts/build/m3/build.ts build --only $npm_package_name",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../../scripts/build/m3/fonts-sync.ts --quiet && bun test"
  },
  "dependencies": {
    "@aphrody/bun": "^3.3.0",
    "@aphrody/canvas": "workspace:*",
    "@aphrody/m3-fonts": "workspace:*",
    "@aphrody/m3-motion": "workspace:*",
    "@aphrody/m3-react": "workspace:*",
    "@aphrody/m3-theme": "workspace:*",
    "@aphrody/material-web": "catalog:",
    "@aphrody/scaffold": "workspace:*",
    "@tailwindcss/node": "catalog:",
    "@tailwindcss/oxide": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "peerDependencies": {
    "@aphrody/m3-bun": "workspace:*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@aphrody/m3-bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
