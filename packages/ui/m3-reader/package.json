{
  "name": "@aphrody/m3-reader",
  "private": true,
  "version": "3.3.3",
  "description": "Material 3 manga and illustrated book readers for React",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles.css",
    "dragon-ball.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./dragon-ball.css": "./dragon-ball.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "typecheck:fast": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^1.48.0",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
