{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@aphrody/bun-types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
