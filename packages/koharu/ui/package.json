{
  "name": "@aphrody/koharu-ui",
  "version": "0.1.0",
  "description": "Koharu editor, controls, preferences, resources and canvas UI for Aphrody hosts",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers": "./src/providers.tsx",
    "./navigation": "./src/navigation.ts",
    "./components/editor/useCanvas": "./src/components/editor/useCanvas.ts",
    "./components/preferences/models": "./src/components/preferences/models.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./locales/*": "./src/locales/*",
    "./assets/NotoSansCJK-VF.otf": "./src/assets/NotoSansCJK-VF.otf",
    "./assets/OFL.txt": "./src/assets/OFL.txt",
    "./styles.css": "./src/styles.css",
    "./components/preferences/KoharuSettings": "./src/components/preferences/KoharuSettings.tsx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/api": "workspace:*",
    "@aphrody/koharu-bridge": "workspace:*",
    "@aphrody/koharu-sdk": "workspace:*",
    "@aphrody/m3-primitives": "workspace:*",
    "@aphrody/plugin-opener": "workspace:*",
    "@base-ui/react": "catalog:",
    "@shenron/pipeline": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "i18next-localstorage-backend": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react-colorful": "catalog:",
    "react-i18next": "catalog:",
    "react-markdown": "catalog:",
    "react-resizable-panels": "catalog:",
    "remark-gfm": "catalog:",
    "tailwind-merge": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
