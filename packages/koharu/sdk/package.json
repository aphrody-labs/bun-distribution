{
  "name": "@koharu/sdk",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tauri": {
      "types": "./src/tauri.ts",
      "default": "./src/tauri.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./settings": {
      "types": "./src/settings.ts",
      "default": "./src/settings.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@koharu/bridge": "workspace:*"
  },
  "peerDependencies": {
    "@tauri-apps/api": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tauri-apps/api": "catalog:"
  }
}
