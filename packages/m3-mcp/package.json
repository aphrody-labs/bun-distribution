{
  "name": "@aphrody/m3-mcp",
  "version": "1.4.5",
  "description": "Design/UI tool host of aphrody-m3 (served through the single aphrody-mcp): packages, M3 tokens (lookup, validate), docs search, research links, templates, Material Symbols SVG, SVG to Tauri icons.",
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/tools.ts",
    "./tool-host": "./src/tool-host.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/tool-host.ts list",
    "test": "bun test",
    "typecheck": "bun check --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aphrody/m3-os-themes": "workspace:*",
    "@aphrody/material-design-icons": "workspace:*",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
