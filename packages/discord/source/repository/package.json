{
	"name": "aphrody-discord",
	"version": "0.0.0",
	"private": true,
	"description": "Shared Bun Discord transport, contracts, and framework adapters for Aphrody applications.",
	"keywords": [
		"api",
		"bot",
		"client",
		"decorators",
		"discord",
		"framework",
		"library",
		"tool",
		"typescript"
	],
	"license": "Apache-2.0",
	"workspaces": {
		"packages": [
			"packages/*",
			"packages/*/examples/**",
			"apps/*",
			"docs",
			"tools/*"
		],
		"catalog": {
			"@types/bun": "1.4.2",
			"oxfmt": "0.71.0",
			"oxlint": "1.86.0",
			"typescript": "7.0.2",
			"@buape/carbon": "0.16.0"
		}
	},
	"publishConfig": {
		"access": "restricted"
	},
	"scripts": {
		"build": "turbo run build --concurrency=4",
		"build:apps": "turbo run build:local --filter=...{apps/*} --concurrency=4",
		"build:typedoc": "turbo run build:typedoc",
		"check": "oxlint packages apps docs",
		"format": "oxfmt --check README.md package.json turbo.json .oxlintrc.json .oxfmtrc.json .github/workflows/build.yml docs/STACK.md docs/UPSTREAMS.md apps/carbon-example/package.json apps/carbon-example/src/index.ts apps/carbon-example/tsconfig.json",
		"fix": "oxlint --fix packages apps docs && oxfmt",
		"prepare": "husky",
		"test": "turbo run test --concurrency=4",
		"verify:messaging-pack": "bash scripts/verify-messaging-package.sh",
		"typecheck": "turbo run typecheck --concurrency=4",
		"dev:discordx-docs": "bun --cwd docs run dev",
		"dev:discordjs-guide": "bun --cwd apps/guide run dev",
		"dev:discordjs-website": "bun --cwd apps/website run dev"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-angular": "^21.2.0",
		"husky": "^9.1.7",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"turbo": "^2.10.12",
		"typedoc": "^0.28.20",
		"typescript": "catalog:",
		"unocss": "^66.9.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"@discordjs/ws@1.2.3>@discordjs/util": "1.2.0"
	},
	"packageManager": "bun@1.4.2"
}
