{
  "name": "@aphrody/discord-kit",
  "version": "0.1.1",
  "description": "Unified Discord bot core kit: pre-flight intent negotiation, memory-bounded caching, resilient interaction dispatching, lifecycle management and guards for Bun.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./rest": {
      "types": "./dist/rest.d.mts",
      "import": "./dist/rest.mjs"
    },
    "./apps": {
      "types": "./dist/apps.d.mts",
      "import": "./dist/apps.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/rest.ts src/apps.ts --format esm --dts",
    "test": "bun test test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aphrody/runtime-sdk": "workspace:*",
    "discord-api-types": "catalog:",
    "discord.js": "catalog:",
    "discordx": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
