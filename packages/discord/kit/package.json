{
  "name": "@aphrody/discord-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Discord bot core kit: pre-flight intent negotiation, memory-bounded caching, resilient interaction dispatching, lifecycle management and guards for Bun.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "test": "bun test test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "discord-api-types": "catalog:",
    "discord.js": "catalog:",
    "discordx": "catalog:"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
