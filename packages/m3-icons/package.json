{
  "name": "@aphrody/m3-icons",
  "version": "3.3.3",
  "private": true,
  "description": "Material Symbols icons for @aphrody/m3: pixel-perfect inline SVG rendered from the aphrody-bun icons module (variable fonts), no icon font shipped at runtime.",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody-m3.git",
    "directory": "packages/m3-icons"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./browser/lit": {
      "types": "./dist/browser-lit.d.ts",
      "default": "./dist/browser-lit.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts build --only $npm_package_name",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/bun": "^3.3.0"
  },
  "devDependencies": {
    "lit": "catalog:"
  },
  "peerDependencies": {
    "lit": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
