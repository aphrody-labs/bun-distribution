{
  "name": "@aphrody/m3-reader",
  "version": "1.4.4",
  "description": "Material 3 manga and illustrated book readers for React",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "styles.css",
    "dragon-ball.css",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./dragon-ball.css": "./dragon-ball.css",
    "./use-focus-trap": {
      "types": "./src/use-focus-trap.ts",
      "default": "./src/use-focus-trap.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target browser --packages external --outdir dist --banner '\"use client\";'",
    "typecheck": "bun check --noEmit",
    "test": "bun test",
    "typecheck:fast": "bun check --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "swiper": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.1.0"
  },
  "engines": {
    "bun": "=1.4.4"
  },
  "bunos": {
    "runtime": {
      "./source": "react",
      "./styles.css": "css",
      "./dragon-ball.css": "css",
      "./use-focus-trap": "react"
    }
  }
}
