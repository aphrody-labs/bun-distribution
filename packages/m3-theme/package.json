{
  "name": "@aphrody/m3-theme",
  "version": "3.3.3",
  "description": "Canonical Material 3 fusion sheets: tokens.css (M3 + shadcn/ui + Tailwind v4 aliases), tailwind.css (every M3 system token as a Tailwind v4 utility) and spaceui.css (the SpaceUI themes rebuilt as M3 dynamic schemes, with SpaceUI compatibility aliases).",
  "keywords": [
    "design-tokens",
    "material-3",
    "md3",
    "shadcn",
    "spaceui",
    "tailwind"
  ],
  "homepage": "https://github.com/aphrody-code/material-web/tree/main/packages/m3-theme#readme",
  "bugs": {
    "url": "https://github.com/aphrody-code/material-web/issues"
  },
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-code/material-web.git",
    "directory": "packages/m3-theme"
  },
  "files": [
    "dist",
    "tokens.css",
    "tailwind.css",
    "spaceui.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./tauri": {
      "types": "./dist/tauri.d.ts",
      "default": "./dist/tauri.js"
    },
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css",
    "./spaceui.css": "./spaceui.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun run generate.ts && oxfmt tokens.css tailwind.css spaceui.css",
    "build": "tsup && tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsgo --noEmit",
    "generate:fusion": "bun run generate",
    "test": "bun test",
    "fixture:mcu": "bun run scripts/mcu-fixture.ts"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/bun": "workspace:*",
    "@aphrody/m3-config": "workspace:*",
    "@material/material-color-utilities": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
