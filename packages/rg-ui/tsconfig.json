{
  "extends": "../rg-config/tsconfig-nextjs.json",
  "compilerOptions": {
    "types": ["react", "react-dom", "@aphrody/bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/components/*": ["./src/components/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
