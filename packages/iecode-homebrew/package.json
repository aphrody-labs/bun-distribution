{
  "name": "iecode-homebrew",
  "version": "1.4.4",
  "private": false,
  "description": "Bun commands for the IECODE DS/DSi and 3DS homebrew toolchains",
  "license": "UNLICENSED",
  "bin": {
    "iecode-homebrew": "./src/cli.ts"
  },
  "files": [
