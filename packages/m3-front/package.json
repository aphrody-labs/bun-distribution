{
  "name": "@aphrody/m3-front",
  "version": "1.4.4",
  "description": "Framework-agnostic Material 3 front layer: <m3-theme> web component, lazy material-web registration and window-class observation on top of @aphrody/material-web and @aphrody/m3-tokens.",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody-m3.git",
    "directory": "packages/m3-front"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/theme-element.ts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme-element": "./src/theme-element.ts",
    "./register": "./src/register.ts",
    "./window-class": "./src/window-class.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test test/",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "lint": "bun lint src test"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/material-web": "catalog:"
  },
  "devDependencies": {
    "@aphrody/bun": "^3.3.0",
    "@aphrody/m3-config": "workspace:*"
  },
  "engines": {
    "bun": "=1.4.4"
  }
}
