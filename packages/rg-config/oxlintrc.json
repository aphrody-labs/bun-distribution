{
	"plugins": ["typescript", "react", "react-perf", "jsx-a11y", "import", "nextjs", "unicorn"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"env": { "browser": true, "node": true, "es2024": true },
	"globals": { "Bun": "readonly" },
	"rules": {
		"no-console": ["warn", { "allow": ["warn", "error", "info"] }],
		"no-debugger": "error",
		"no-array-index-key": "off",
		"no-non-null-assertion": "off",
		"no-explicit-any": "warn"
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/.next/**",
		"**/dist/**",
		"**/build/**",
		"**/.turbo/**",
		"**/*.d.ts"
	]
}
