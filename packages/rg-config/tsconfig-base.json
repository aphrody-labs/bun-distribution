{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,
    "rootDir": "../..",
    "paths": {
      "@rosegriffon/db": ["../rg-db/src/index.ts"],
      "@rosegriffon/db/*": ["../rg-db/src/*"],
      "@rosegriffon/types": ["../rg-types/src/index.ts"],
      "@rosegriffon/types/*": ["../rg-types/src/*"],
      "@rosegriffon/auth": ["../rg-auth/src/index.ts"],
      "@rosegriffon/auth/*": ["../rg-auth/src/*"],
      "@rosegriffon/assets": ["../rg-assets/src/index.ts"],
      "@rosegriffon/assets/*": ["../rg-assets/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
