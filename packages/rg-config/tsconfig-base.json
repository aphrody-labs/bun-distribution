{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,
    "rootDir": "../../..",
    "paths": {
      "@rosegriffon/db": ["../db/src/index.ts"],
      "@rosegriffon/db/*": ["../db/src/*"],
      "@rosegriffon/types": ["../types/src/index.ts"],
      "@rosegriffon/types/*": ["../types/src/*"],
      "@rosegriffon/auth": ["../auth/src/index.ts"],
      "@rosegriffon/auth/*": ["../auth/src/*"],
      "@rosegriffon/ui": ["../ui/src/index.ts"],
      "@rosegriffon/ui/*": ["../ui/src/*"],
      "@rosegriffon/assets": ["../assets/src/index.ts"],
      "@rosegriffon/assets/*": ["../assets/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
