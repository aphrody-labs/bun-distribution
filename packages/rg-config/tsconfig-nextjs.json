{
	"extends": "./tsconfig-base.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "preserve",
		"jsxImportSource": "react",
		"types": ["node", "react", "react-dom"],
		"plugins": [{ "name": "next" }],
		"incremental": true,
		"noEmit": true
	},
	"exclude": ["node_modules", ".next", "dist", "build", ".turbo", "coverage"]
}
