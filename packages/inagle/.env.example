# Private Inagle/NIE gameplay PostgreSQL configuration.
# Use the direct connection for schema migrations and TLS certificate checking.
# Runtime services may use their approved Neon pooled URL when configured separately.
# Create packages/inagle/.env.local from the protected credential store; do not commit URLs.
INAGLE_DATABASE_URL=

# Historical alias for NIE consumers. Prefer INAGLE_DATABASE_URL.
# NIE_PG_URL=
