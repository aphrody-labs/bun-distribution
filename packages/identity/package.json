{
  "name": "@aphrody/identity",
  "version": "0.1.0",
  "description": "Aphrody product identity for the M3 surfaces: brand emblem and icons, the Aphrody avatar, and the animated pet sprite (atlas, timed tracks, 16-way gaze) drawn from crates/ui/identity.",
  "keywords": [
    "aphrody",
    "avatar",
    "brand",
    "material-3",
    "sprite"
  ],
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./atlas": "./src/atlas.ts",
    "./pet": "./src/pet.ts"
  },
  "scripts": {
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@aphrody/m3": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
