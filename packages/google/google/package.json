{
  "name": "@aphrody/google",
  "version": "1.0.0-canary.1",
  "description": "Canonical Bun facade for Aphrody Google Cloud and Gemini.",
  "license": "Apache-2.0",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./api": "./src/api.ts",
    "./drive-sync": "./src/drive-sync.ts",
    "./drive-model-sync": "./src/drive-model-sync.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "google:status": "bun ../../../apps/yolo/cli/src/index.ts google drive status",
    "google:sync": "bun ../../../apps/yolo/cli/src/index.ts google drive sync",
    "test": "bun test ./test",
    "verify": "bun run test && bun run build"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "catalog:",
    "ai": "catalog:",
    "google-auth-library": "catalog:",
    "googleapis": "catalog:",
    "@aphrody/yolo-core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
