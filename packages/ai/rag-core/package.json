{
  "name": "@aphrody/rag-core",
  "version": "0.1.2",
  "description": "Aphrody RAG core for the web (WebAssembly) and for Bun (bun:ffi): chunking, fusion, eval and vector kernels behind one typed facade.",
  "license": "Apache-2.0",
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wasm": "./src/wasm.ts",
    "./ffi": "./src/ffi.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "bun run --cwd ../../infra/cli-wasm build:wasm",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aphrody/cli-wasm": "workspace:*",
    "@aphrody/paths": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
