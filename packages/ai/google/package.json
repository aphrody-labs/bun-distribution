{
  "name": "@aphrody/google",
  "version": "1.0.0-canary",
  "private": true,
  "type": "module",
  "description": "Canonical Bun facade for Aphrody Google Cloud, Gemini and BXC Web integrations.",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "build:cli": "bun build ./bin/aphrody-google.ts --compile --outfile ./dist/aphrody-google-bun",
    "test": "bun test ./test",
    "verify": "bun run test && bun run build"
  },
  "bin": {
    "aphrody-google": "./bin/aphrody-google.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.89",
    "@aphrody/bxc": "0.9.15",
    "ai": "6.0.286"
  }
}
