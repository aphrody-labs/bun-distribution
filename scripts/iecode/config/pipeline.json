{
  "schemaVersion": 1,
  "name": "iecode-monorepo-validation",
  "authority": "@aphrody/workspace",
  "workspaceRoot": "..",
  "stages": [
    {
      "id": "structure",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "check:workspace"]
        }
      ]
    },
    {
      "id": "rust-foundation",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "check:rust"]
        },
        {
          "repo": "iecode",
          "command": ["run", "test:rust"]
        }
      ]
    },
    {
      "id": "bun-web",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@aphrody/iecode-web", "typecheck"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@aphrody/iecode-web", "build"]
        }
      ]
    },
    {
      "id": "bun-azalee",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/azalee", "lint"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/azalee", "typecheck"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/azalee", "test"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/azalee", "build"]
        }
      ]
    },
    {
      "id": "bun-iecode-homebrew",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "--filter", "iecode-homebrew", "typecheck"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "iecode-homebrew", "test"]
        }
      ]
    },
    {
      "id": "bun-ieverse",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "--filter", "ieverse", "typecheck"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "ieverse", "test"]
        }
      ]
    },
    {
      "id": "bun-inagle",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/inagle", "lint"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/inagle", "typecheck"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/inagle", "test"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/inagle", "build"]
        }
      ]
    },
    {
      "id": "bun-inagle-cross",
      "parallel": false,
      "steps": [
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/inagle-cross", "lint"]
        },
        {
          "repo": "iecode",
          "command": ["run", "--filter", "@rosegriffon/inagle-cross", "typecheck"]
        }
      ]
    }
  ]
}
