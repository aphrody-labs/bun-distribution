[Unit]
Description=Sync Shenron Agent Home with its shared Google Drive and Docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aphro
WorkingDirectory=/home/aphro/aphrody
EnvironmentFile=/home/aphro/aphrody/.env
Environment=PATH=/home/aphro/.bun/bin:/home/aphro/.local/bin:/home/aphro/.local/google-cloud-sdk/bin:/usr/local/bin:/usr/bin:/bin
Environment=APHRODY_AGENT_HOME_MEMORY_BIN=/home/aphro/.local/lib/aphrody/installed-20261001/daemon/aphrody-agent-home-memory
Environment=APHRODY_AGENT_TRAIN_BIN=/home/aphro/.local/lib/aphrody/installed-20261001/daemon/aphrody-agent-train
ExecStart=/home/aphro/.bun/bin/bun /home/aphro/aphrody/packages/infra/workspace/src/agent-home-drive-sync.ts daemon
Restart=on-failure
RestartSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/aphro/.aphrody/workspaces/dbfr /home/aphro/.aphrody/drive-sync /home/aphro/.config/gcloud /home/aphro/.aphrody/private/memory /home/aphro/.aphrody/train/dbfr /home/aphro/.aphrody/locks /home/aphro/aphrody/py/aphrody-train/.venv /home/aphro/.cargo /home/aphro/.cache/uv
ReadOnlyPaths=/home/aphro/.aphrody/private/google /home/aphro/.aphrody/private/agent-training.json

[Install]
WantedBy=multi-user.target
