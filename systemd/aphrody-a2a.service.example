# SPDX-License-Identifier: Apache-2.0
# Retired 2026-09-25: aphrody-a2a was removed from vps (config/service-catalog.json status:retired; docs/PLAN.md). Kept as a redeploy template for the Aphrody convergence plan (superproject docs/architecture/APHRODY-CONVERGENCE.md).
[Unit]
Description=Aphrody AI A2A loopback service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/aphrody/shared/a2a
Environment=HOME=/srv/aphrody/shared/a2a
Environment=APHRODY_A2A_PUBLIC_URL=https://aphrody.com/api/v1/a2a
Environment=APHRODY_A2A_DRY_RUN=1
Environment=RUST_LOG=aphrody_a2a_coord=info
EnvironmentFile=-/etc/aphrody/aphrody-a2a.env
ExecStart=/srv/aphrody/current/bin/aphrody a2a serve --bind 127.0.0.1:8788
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/aphrody/shared/a2a /srv/aphrody/shared/coord
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
