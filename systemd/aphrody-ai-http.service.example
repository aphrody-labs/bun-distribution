# SPDX-License-Identifier: Apache-2.0
# Retired 2026-09-25: aphrody-ai-http was removed from vps (config/service-catalog.json status:retired; docs/PLAN.md). Kept as a redeploy template for the Aphrody convergence plan (superproject docs/architecture/APHRODY-CONVERGENCE.md).
[Unit]
Description=Aphrody AI private HTTP backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aphrody
Group=aphrody
WorkingDirectory=/srv/aphrody/current
Environment=APHRODY_HOME=/srv/aphrody/shared/ai
EnvironmentFile=-/etc/aphrody/aphrody-ai-http.env
ExecStart=/srv/aphrody/current/bin/aphrody-mcp http --bind 127.0.0.1:8789
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/aphrody/shared/ai

[Install]
WantedBy=multi-user.target
