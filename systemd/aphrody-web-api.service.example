# SPDX-License-Identifier: Apache-2.0
# Retired 2026-09-25: aphrody-web-api was removed from vps (config/service-catalog.json status:retired; docs/PLAN.md). Kept as a redeploy template for the Aphrody convergence plan (superproject docs/architecture/APHRODY-CONVERGENCE.md).
[Unit]
Description=Aphrody OS browser and web index HTTP backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/aphrody/current
Environment=PORT=3007
Environment=BXC_DIR=/srv/aphrody/shared/bxc
Environment=BXC_STORAGE_DIR=/srv/aphrody/shared/bxc/storage
Environment=BXC_COOKIES_DIR=/srv/aphrody/shared/bxc/cookies
Environment=BXC_DB_PATH=/srv/aphrody/shared/bxc/bxc.sqlite
Environment=BXC_RUST_BRIDGE_LIB=/srv/aphrody/current/lib/libaphrody_web_ffi.so
Environment=BXC_RENDER_LIB=/srv/aphrody/current/lib/libbxc_render.so
EnvironmentFile=/etc/aphrody/aphrody-web-api.env
ExecStart=/srv/aphrody/current/bin/aphrody-web-api
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/aphrody/shared/bxc

[Install]
WantedBy=multi-user.target
