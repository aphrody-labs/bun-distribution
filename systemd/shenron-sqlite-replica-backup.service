# Host prerequisite: an aphrody-infra checkout at /home/ubuntu/aphrody-infra on DBFR.
# Audit 2026-09-24: DBFR has no such checkout and the installed unit still runs
# the frozen copy under /home/ubuntu/shenron/scripts/; see docs/SHENRON-MIGRATION.md.
[Unit]
Description=Backup of the Shenron SQLite replica on DBFR
After=shenron-pg-backup.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shenron
Environment=SHENRON_SQLITE_BACKUP_DIR=/home/ubuntu/shenron/data/backups/shenron-sqlite
Environment=SHENRON_SQLITE_BACKUP_RETENTION_DAYS=14
Environment=SHENRON_ROOT=/home/ubuntu/shenron
ExecStartPre=+/bin/mkdir -p /home/ubuntu/shenron/data/backups/shenron-sqlite
ExecStart=/bin/bash -c 'if [ -f /home/ubuntu/aphrody-infra/scripts/ops/backup-shenron-sqlite.sh ]; then exec /bin/bash /home/ubuntu/aphrody-infra/scripts/ops/backup-shenron-sqlite.sh; else exec /bin/bash /home/ubuntu/shenron/scripts/backup-shenron-sqlite.sh; fi'

Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/shenron/data/backups/shenron-sqlite

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-sqlite-replica-backup
