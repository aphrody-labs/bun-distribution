# rg-watchdog@.service — sonde de santé d'un service de production, déclenchée par son
# timer jumeau. `%i` est le nom du service surveillé, sans son suffixe : par exemple
# `rg-watchdog@nie-model-serve.service` surveille `nie-model-serve.service`.
#
# Template plutôt qu'une unité par service : l'audit du 14/8/2026 a compté treize
# services de production sans aucune sonde, pour un seul qui en avait une. Recopier le
# fichier treize fois aurait garanti que les treize copies divergent ; ici, la seule
# chose qui change d'une instance à l'autre est le nom passé en argument, et toute la
# configuration de surveillance vit dans une table unique, scripts/ops/rg-watchdog.sh.
#
# Root : le watchdog doit pouvoir redémarrer le service qu'il surveille.
[Unit]
Description=Watchdog %i (santé HTTP + mémoire, redémarrage automatique)
After=%i.service
# Pas de Requires= : le watchdog doit tourner même — surtout — si le service est tombé.

[Service]
Type=oneshot
ExecStart=/home/ubuntu/aphrody-infra/scripts/ops/rg-watchdog.sh %i
# Trois sondes espacées de 5 s, plus la marge d'un redémarrage : 90 s suffisent et
# évitent qu'un watchdog bloqué reste en vol jusqu'au tick suivant.
TimeoutStartSec=90
# La surveillance ne doit jamais disputer le processeur à ce qu'elle surveille.
Nice=5
MemoryMax=128M
