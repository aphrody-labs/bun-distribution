# SPDX-License-Identifier: Apache-2.0
# Retired 2026-09-25: aphrody-shenron-embed was removed from vps (config/service-catalog.json status:retired; docs/PLAN.md). Kept as a redeploy template for the Aphrody convergence plan (superproject docs/architecture/APHRODY-CONVERGENCE.md).
# Since 2026-09-26 the service runs the pure-Rust `aphrody-embed serve` (aphrody-ai crate aphrody-embed, feature server) instead of the Bun apps/shenron-embed.
# Provision the pinned E5 files once with `aphrody-embed install --model-dir /srv/aphrody/shared/models/e5-native`; serving never downloads.
[Unit]
Description=Aphrody multilingual E5 embedding service (aphrody-embed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aphrody
Group=aphrody
WorkingDirectory=/srv/aphrody/current
Environment=APHRODY_EMBED_HOST=127.0.0.1
Environment=APHRODY_EMBED_PORT=8794
Environment=APHRODY_EMBED_MODEL_DIR=/srv/aphrody/shared/models/e5-native
ExecStart=/srv/aphrody/current/bin/aphrody-embed serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
