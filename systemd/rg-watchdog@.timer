# rg-watchdog@.timer — tick de surveillance d'un service, toutes les 60 secondes.
#
# 60 s est le compromis retenu par le watchdog d'azalée depuis son écriture : assez
# court pour qu'une panne dure moins d'une minute, assez long pour que trois sondes
# espacées de 5 s aient le temps de conclure avant le tick suivant.
[Unit]
Description=Tick du watchdog %i (toutes les 60 s)

[Timer]
# Deux minutes après le démarrage : le service surveillé doit avoir eu le temps de
# s'ouvrir, sinon le premier tick le redémarrerait alors qu'il démarrait.
OnBootSec=120
OnUnitActiveSec=60
AccuracySec=10s
# Un tick manqué pendant un arrêt machine n'a aucun intérêt à être rattrapé : c'est
# l'état courant qui compte, pas l'historique.
Persistent=false

[Install]
WantedBy=timers.target
