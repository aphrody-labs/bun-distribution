[Unit]
Description=Aphrody source workspace synchronisation
Documentation=file:///home/aphro/src/aphrody-infra/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/aphro/src/aphrody-infra/scripts/source-sync.ts

[Service]
Type=simple
WorkingDirectory=/home/aphro/src/aphrody-infra
Environment=PATH=/home/aphro/.local/bin:/home/aphro/.bun/bin:/home/aphro/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/aphro/.bun/bin/bun run source:sync:watch
Restart=always
RestartSec=10s
Nice=15
CPUQuota=20%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
