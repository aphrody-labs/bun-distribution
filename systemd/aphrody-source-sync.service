[Unit]
Description=Aphrody source workspace synchronisation
Documentation=file:///home/aphro/aphrody/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/aphro/aphrody/scripts/source-sync.ts

[Service]
Type=simple
WorkingDirectory=/home/aphro/aphrody
Environment=PATH=/home/aphro/.local/bin:/home/aphro/.bun/bin:/home/aphro/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/aphro/.bun/bin/bun scripts/source-sync.ts --apply --watch --interval 60 --repo aphrody --repo aphrody-py --repo iecode
Restart=always
RestartSec=10s
Nice=15
CPUQuota=20%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
