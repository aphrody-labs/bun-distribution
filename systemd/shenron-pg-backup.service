# Host prerequisite: an aphrody-infra checkout at /home/ubuntu/aphrody-infra on DBFR.
# Audit 2026-09-24: DBFR has no such checkout and the installed unit still runs
# the frozen copy under /home/ubuntu/shenron/scripts/; see docs/SHENRON-MIGRATION.md.
[Unit]
Description=Daily logical backup of Shenron PostgreSQL data on DBFR
After=postgresql@18-main.service
Wants=postgresql@18-main.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shenron
Environment=SHENRON_ROOT=/home/ubuntu/shenron
ExecStart=/bin/bash /home/ubuntu/aphrody-infra/scripts/ops/backup-shenron-pg.sh

Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/shenron/data/backups/shenron-pg

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-pg-backup
