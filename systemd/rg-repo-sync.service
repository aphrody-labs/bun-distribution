[Unit]
Description=contrôle Git RG/Niers manuel — sans autocommit ni déploiement
Documentation=file:///home/ubuntu/aphrody-infra/docs/ops/REPO-SYNC.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ubuntu/aphrody-infra/scripts/ops/repo-sync.ts

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rg
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RG_ROOT=/home/ubuntu/rg
Environment=NIE_ROOT=/home/ubuntu/nie
# L'autocommit est volontairement désactivé : toute écriture Git doit être demandée
# explicitement par un opérateur avec `repo-sync.ts --commit`.
Environment=REPO_SYNC_AUTOCOMMIT=0
Environment=REPO_SYNC_PUSH=0
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/aphrody-infra/scripts/ops/repo-sync.ts --repo all --json
Nice=15
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=256M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/rg /home/ubuntu/nie
