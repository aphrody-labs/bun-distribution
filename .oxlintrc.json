{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "promise",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "rules": {
    "no-console": "off",
    "no-debugger": "error",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "target/**",
    "var/**",
    "dist/**",
    ".venv/**",
    ".uv-cache/**",
    ".git/**",
    ".claude/**",
    "py/**",
    "apps/photoshop-*/**",
    "crates/**/assets/**",
    "docs/**/screenshots/**",
    "**/examples/**",
    "**/tests/assets/**",
    "**/*.min.js",
    "apps/shenron/bot/dist/**",
    "apps/shenron/bot/node_modules/**",
    "apps/shenron/bot/src/_entries.ts",
    "apps/shenron/bot/src/db/migrations/**",
    "apps/shenron/bot/bun/**",
    "apps/shenron/bot/assets/**",
    "apps/shenron/site/public/**",
    "apps/shenron/site/.next/**",
    "apps/shenron/site/.next-build/**",
    "apps/shenron/site/.next-dev/**",
    "apps/koharu/editor/.next/",
    "apps/koharu/editor/out/",
    "apps/koharu/editor/dist/",
    "apps/koharu/editor/build/",
    "apps/koharu/editor/coverage/",
    "apps/koharu/editor/lib/api/**/*.msw.ts",
    "m3/forks/**",
    "crates/turbopack/**",
    "crates/tauri/**",
    "crates/ui/app/ui-dist/**",
    "crates/web/obscura-js/**",
    "**/templates/**",
    "vendor/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.test.js"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "no-console": "off"
      }
    },
    {
      "files": [
        "apps/shenron/bot/**"
      ],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_",
            "destructuredArrayIgnorePattern": "^_"
          }
        ],
        "no-empty": [
          "error",
          {
            "allowEmptyCatch": true
          }
        ],
        "no-console": "off",
        "no-await-in-loop": "off",
        "no-new": "off",
        "no-shadow": "off",
        "no-underscore-dangle": [
          "warn",
          {
            "allow": [
              "_auth",
              "_hlsCache",
              "__done"
            ]
          }
        ],
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unused-vars": "off",
        "import/no-unassigned-import": "off",
        "unicorn/no-null": "off",
        "unicorn/filename-case": "off",
        "unicorn/no-array-for-each": "off",
        "unicorn/prefer-top-level-await": "off",
        "unicorn/no-array-reduce": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/require-post-message-target-origin": "off"
      },
      "globals": {
        "Bun": "readonly"
      }
    },
    {
      "files": [
        "apps/shenron/bot/src/workers/**/*.ts"
      ],
      "rules": {
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      "files": [
        "apps/shenron/bot/scripts/**/*.ts",
        "apps/shenron/bot/src/db/seed-*.ts",
        "apps/shenron/bot/src/db/migrate.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "apps/shenron/site/**"
      ],
      "rules": {
        "no-unused-vars": "warn",
        "no-useless-escape": "warn"
      }
    },
    {
      "files": [
        "apps/koharu/editor/**"
      ],
      "rules": {
        "react/exhaustive-deps": "warn",
        "react/incompatible-library": "off",
        "react/refs": "off",
        "react/set-state-in-effect": "off",
        "react/static-components": "off",
        "no-useless-catch": "warn",
        "typescript/no-useless-empty-export": "warn",
        "unicorn/no-empty-file": "warn",
        "unicorn/no-unnecessary-await": "warn",
        "unicorn/no-useless-spread": "warn",
        "no-unused-vars": "warn",
        "unicorn/no-document-cookie": "warn",
        "no-useless-rename": "warn",
        "unicorn/no-useless-length-check": "warn",
        "no-useless-escape": "warn",
        "typescript/prefer-as-const": "warn",
        "unicorn/no-useless-fallback-in-spread": "warn",
        "no-extra-boolean-cast": "warn",
        "unicorn/no-new-array": "warn",
        "unicorn/prefer-set-size": "warn",
        "typescript/no-this-alias": "warn",
        "unicorn/prefer-string-starts-ends-with": "warn"
      },
      "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "promise",
        "import",
        "eslint",
        "react"
      ]
    }
  ]
}
