{
  "description": "Aphrody plugin hooks. Both are project-agnostic and no-ops when the kernel or the matching project layout is absent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/enforce-web-test-scope.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
