{
  "schemaVersion": 1,
  "description": "vu-forge (planned), the mirror of config/bun-forge.json for the vu monorepo: one temporary checkout per commit of the watched branch, built on the serialized build host under the factory locks, one JSON receipt per commit (schema aphrody.vu-forge/1: revision, toolchain, pinned sources, artifact path and sha256, smoke results). It is not a second stack: `yolo forge` is generalised to read a --config file (PLAN section 6.4) instead of embedding one.",
  "repository": "https://github.com/aphrody-labs/vu.git",
  "branch": "main",
  "profile": "release",
  "lto": true,
  "scratch": {
    "mode": "auto",
    "size": "48G"
  },
  "watch": {
    "intervalSeconds": 300,
    "everyCommit": true,
    "historyDepth": 50
  },
  "build": {
    "wrapper": "scripts/build/rust/cargo-serial.sh",
    "packages": ["vu"],
    "locked": true,
    "jobsVariable": "APHRODY_CARGO_JOBS",
    "maxJobs": 6,
    "sccache": true
  },
  "toolchain": {
    "rust": {
      "channel": "1.98.1",
      "note": "The Aphrody workspace toolchain; uv and ruff require 1.97 and pin 1.99.0 upstream, which is not needed because the vu workspace sets its own channel.",
      "targets": ["x86_64-unknown-linux-gnu"]
    },
    "apt": ["build-essential", "pkg-config", "ca-certificates", "git", "curl", "zstd", "xz-utils"],
    "binaries": ["cc", "git", "tar", "zstd"],
    "pythonStandalone": {
      "release": "20261003",
      "version": "3.12.15",
      "alsoQualified": "3.14.8",
      "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20261003/{asset}",
      "assetsFrom": "vendor.json#/releases/0/assets"
    }
  },
  "smoke": [
    { "name": "version", "command": ["{binary}", "--version"] },
    { "name": "uv", "command": ["{binary}", "uv", "--version"], "expect": "uv 0.12.23" },
    { "name": "ruff", "command": ["{binary}", "ruff", "--version"], "expect": "ruff 0.16.10" },
    {
      "name": "python",
      "command": ["{binary}", "python", "-c", "import sys; print(sys.version_info[:3])"],
      "expect": "(3, 12, 15)"
    },
    {
      "name": "native module",
      "command": [
        "{binary}",
        "python",
        "-c",
        "import aphrody.aphrody_rust as m; print(m.cosine_similarity([1.0, 0.0], [1.0, 0.0]))"
      ],
      "expect": "1.0"
    }
  ]
}
