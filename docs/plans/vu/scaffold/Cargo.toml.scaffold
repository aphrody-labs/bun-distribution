# SPDX-License-Identifier: Apache-2.0
# Scaffold of the root manifest of the private repository aphrody-labs/vu. It is named *.scaffold so that Cargo
# and the workspace scanners of this repository ignore it; it is `Cargo.toml` in the vu repository.
#
# Decision D8 (PLAN section 9): the sidecars `uv` and `ruff` (tier T0) are built from their own fork checkouts with
# their own upstream locks (`cargo build --locked --manifest-path vendor/<name>/Cargo.toml -p <name>`) and are not
# members or dependencies of this workspace. The workspace holds the launcher and the CPython embedding, and depends
# on PyO3 by path from the pinned fork checkout, so a patch can be carried on the fork branch.

[workspace]
resolver = "3"
members = ["crates/vu", "crates/vu-runtime"]
# The forks are workspaces of their own: they are built or used by path only.
exclude = ["vendor"]

[workspace.package]
edition = "2024"
rust-version = "1.98"
license = "Apache-2.0"
repository = "https://github.com/aphrody-labs/vu"
authors = ["aphrody-dev <contact@aphrody.com>"]
version = "0.1.0"

[workspace.dependencies]
# Pinned fork checkout (branch vu-pin-0.29.3). Embedding: `auto-initialize`; the deprecated `extension-module`
# feature is not used. `pyo3::ffi` is pyo3-ffi (Py_BytesMain).
pyo3 = { path = "vendor/pyo3", version = "=0.29.3", default-features = false, features = ["macros", "auto-initialize"] }
vu-runtime = { path = "crates/vu-runtime" }

[profile.release]
# Same shape as the uv and ruff release profiles. panic = "abort" is the upstream choice for both CLIs (D10).
lto = "fat"
codegen-units = 1
panic = "abort"
strip = true

[profile.dev]
debug = "line-tables-only"
