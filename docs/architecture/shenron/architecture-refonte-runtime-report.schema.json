{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonballfr.com/schemas/architecture-refonte-runtime-report.json",
  "title": "Architecture refonte runtime report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "structuralExitCode",
    "runtimeExitCode",
    "apiExitCode",
    "fullSuiteExitCode",
    "serialValidation",
    "status",
    "failureStreak",
    "escalation"
  ],
  "properties": {
    "generatedAt": { "type": "string", "format": "date-time" },
    "structuralExitCode": { "type": "integer", "minimum": 0 },
    "runtimeExitCode": { "type": ["integer", "null"], "minimum": 0 },
    "apiExitCode": { "type": ["integer", "null"], "minimum": 0 },
    "fullSuiteExitCode": { "type": ["integer", "null"], "minimum": 0 },
    "serialValidation": { "type": "boolean" },
    "status": { "enum": ["FAIT", "INCOMPLET"] },
    "failureStreak": { "type": "integer", "minimum": 0 },
    "escalation": { "type": ["string", "null"], "enum": ["ADMIN_REQUIRED", null] }
  }
}
