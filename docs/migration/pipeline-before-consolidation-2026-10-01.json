          ]
        },
        {
          "repo": "aphrody-os",
          "runner": "just",
          "command": [
            "test"
          ]
        },
        {
          "repo": "aphrody-ui",
          "command": [
            "run",
            "test"
          ]
        },
        {
          "repo": "aphrody-ui",
          "runner": "just",
          "command": [
            "test"
          ]
        },
        {
          "repo": "aphrody-web",
          "command": [
            "run",
            "test"
          ]
        },
        {
          "repo": "aphrody-web",
          "runner": "just",
          "command": [
            "test"
          ]
        },
        {
          "repo": "aphrody-compat",
          "command": [
            "run",
            "test"
          ]
        },
        {
          "repo": "aphrody-compat",
          "runner": "just",
