          ]
        },
        {
          "repo": "aphrody-web",
          "runner": "just",
          "command": [
            "check"
          ]
        },
        {
          "repo": "aphrody-compat",
          "command": [
            "run",
            "typecheck"
          ]
        },
        {
          "repo": "aphrody-compat",
          "command": [
            "run",
            "n2b:typecheck"
          ]
        },
        {
          "repo": "aphrody-compat",
          "runner": "just",
          "command": [
            "check"
