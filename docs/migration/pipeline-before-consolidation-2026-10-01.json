          ]
        }
      ]
    },
    {
      "id": "build",
      "parallel": false,
      "steps": [
        {
          "repo": "aphrody-infra",
          "command": [
            "run",
            "infra:cli",
            "validate"
          ]
        },
        {
          "repo": "aphrody-compat",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "aphrody-ui",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "aphrody-web",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "aphrody-ai",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "aphrody-os",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "rg",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "shenron",
          "command": [
            "run",
            "site:build"
          ]
        },
        {
          "repo": "nie",
          "command": [
            "run",
            "build"
          ]
        },
        {
          "repo": "iecode",
          "command": [
            "run",
            "check:dotnet"
          ]
        }
      ]
    },
    {
      "id": "release",
      "parallel": false,
      "steps": [
        {
          "repo": "aphrody-ai",
          "command": [
            "run",
            "verify:release"
          ]
        },
        {
          "repo": "aphrody-infra",
          "command": [
            "run",
            "release:bundle"
          ]
        }
      ]
    },
    {
      "id": "live",
      "parallel": false,
      "afterDeploy": true,
      "steps": [
        {
          "repo": "aphrody-infra",
          "command": [
            "run",
            "audit:live"
          ]
        }
      ]
    }
  ],
  "deploy": {
    "adapter": "cargo run -p aphrody-infra -- deploy --stack bundle",
    "target": "vps",
    "bundle": "scripts/build/build-aphrody-stack-release.sh (WSL Ubuntu-24.04, ext4 superproject clone): Aphrody stack + Shenron artifact + RG pin; NIE and IECode ship no VPS release",
    "requires": [
      "all stages green",
      "SMOKE.json attestation",
      "nginx -t",
      "health probes",
      "rollback slot"
    ],
    "then": "live stage: scripts/audit/live-audit.ts must report 0 errors (routes, pages, links, assets, render, server journal)"
  },
  "cdn": {
    "owner": "aphrody-infra",
    "provider": "nginx+rg-cdn",
    "invalidate": "scripts/rg/invalidate-cdn.ts",
    "singleOrigin": true,
    "aphrody": {
      "host": "cdn.aphrody.com",
      "catalog": "config/asset-catalog.json",
      "check": "bun scripts/assets/cdn.ts check",
      "build": "bun scripts/assets/cdn.ts build",
      "publish": "bun scripts/assets/cdn.ts publish --vps <ssh-host>"
    }
  }
}
