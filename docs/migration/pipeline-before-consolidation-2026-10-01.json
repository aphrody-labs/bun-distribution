            "clippy"
          ]
        },
        {
          "repo": "aphrody-contracts",
          "runner": "just",
          "command": [
            "clippy"
          ]
        },
        {
          "repo": "aphrody-shell",
          "runner": "just",
          "command": [
            "clippy"
          ]
        },
        {
          "repo": "aphrody-native",
          "runner": "just",
          "command": [
            "clippy"
          ]
        },
        {
          "repo": "rg",
          "command": [
            "run",
            "lint"
          ]
        },
        {
          "repo": "shenron",
          "command": [
            "run",
            "lint"
          ]
        },
        {
          "repo": "nie",
          "command": [
            "run",
            "lint"
          ]
        },
