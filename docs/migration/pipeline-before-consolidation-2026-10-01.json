{
  "schemaVersion": 1,
  "name": "aphrody-production-pipeline",
  "authority": "aphrody-infra",
  "workspaceRoot": "../src",
  "runners": {
    "bun": "package.json scripts (default)",
    "just": "Justfile recipes of the Rust category repositories"
  },
  "nextPolicy": {
    "major": 16,
    "channel": "canary",
    "singleBuildPerRelease": true
  },
  "stages": [
    {
      "id": "format",
      "parallel": true,
      "steps": [
        {
          "repo": "aphrody-infra",
          "command": [
            "run",
            "format:check"
          ]
        },
        {
          "repo": "aphrody-ai",
          "command": [
            "run",
            "fmt:check"
          ]
        },
        {
          "repo": "aphrody-os",
          "command": [
            "run",
            "format",
            "--",
            "--check"
          ]
        },
        {
          "repo": "aphrody-os",
          "runner": "just",
          "command": [
            "fmt-check"
          ]
        },
        {
          "repo": "aphrody-ui",
          "command": [
            "run",
            "format",
            "--",
            "--check"
          ]
        },
        {
          "repo": "aphrody-web",
          "command": [
            "run",
            "format",
            "--",
            "--check"
          ]
        },
        {
          "repo": "aphrody-compat",
          "command": [
            "run",
            "format",
            "--",
            "--check"
          ]
        },
        {
          "repo": "aphrody-contracts",
          "runner": "just",
          "command": [
            "fmt-check"
          ]
        },
        {
          "repo": "aphrody-shell",
          "runner": "just",
          "command": [
            "fmt-check"
          ]
        },
        {
          "repo": "aphrody-native",
          "runner": "just",
          "command": [
            "fmt-check"
          ]
        },
        {
          "repo": "rg",
          "command": [
            "run",
            "format:check"
          ]
        },
        {
          "repo": "shenron",
          "command": [
            "run",
            "format:check"
          ]
        },
        {
          "repo": "nie",
          "command": [
            "run",
            "docs:check"
          ]
        },
        {
          "repo": "iecode",
          "command": [
            "run",
            "format:check"
          ]
        }
      ]
    },
    {
      "id": "lint",
      "parallel": true,
      "steps": [
        {
          "repo": "aphrody-infra",
          "command": [
            "run",
            "lint"
          ]
        },
