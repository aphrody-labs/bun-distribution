{
  "name": "aphrody",
  "build": {
    "dockerfile": "../../../tools/aphrody/config/container/Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "remoteUser": "aphrody",
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
  "containerEnv": {
    "APHRODY_CLOUD": "1"
  },
  "mounts": [
    "source=aphrody-cargo-registry,target=/home/aphrody/.cargo/registry,type=volume",
    "source=aphrody-cargo-target,target=/app/target,type=volume",
    "source=aphrody-home,target=/home/aphrody/.aphrody,type=volume"
  ],
  "postCreateCommand": "bun install --frozen-lockfile"
}
