{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "es5",
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"ignorePatterns": [
		"**/*.generated.ts",
		"**/dist/**",
		"**/.next/**",
		"**/.turbo/**",
		"**/node_modules/**",
		"**/data/**",
		"**/*.min.js",
		"**/patches/**",
		"**/scratch/**",
		"**/*.conf",
		"**/*.inc",
		"**/*.d.ts"
	]
}
