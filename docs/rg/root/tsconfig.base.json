{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"forceConsistentCasingInFileNames": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"skipLibCheck": true,
		"allowJs": false,
		"jsx": "preserve",
		"jsxImportSource": "react",
		"paths": {
			"@rosegriffon/ui": ["./packages/ui/src/index.ts"],
			"@rosegriffon/ui/*": ["./packages/ui/src/*"],
			"@rosegriffon/db": ["./packages/db/src/index.ts"],
			"@rosegriffon/db/*": ["./packages/db/src/*"],
			"@rosegriffon/config/*": ["./packages/config/*"],
			"@rosegriffon/achillea-types": ["./packages/achillea-types/src/index.ts"],
			"@rosegriffon/achillea-types/*": ["./packages/achillea-types/src/*"],
			"@rosegriffon/achillea-core": ["./packages/achillea-core/src/index.ts"],
			"@rosegriffon/achillea-core/*": ["./packages/achillea-core/src/*/index.ts"],
			"@rosegriffon/achillea-client": ["./packages/achillea-client/src/index.ts"],
			"@rosegriffon/achillea-client/*": ["./packages/achillea-client/src/*/index.ts"],
			"@rosegriffon/achillea-contract": ["./packages/achillea-contract/src/index.ts"],
			"@rosegriffon/achillea-contract/*": ["./packages/achillea-contract/src/*/index.ts"],
			"@rosegriffon/auth": ["./packages/auth/src/index.ts"],
			"@rosegriffon/auth/*": ["./packages/auth/src/*"],
			"@rosegriffon/azalee": ["./packages/azalee/src/index.ts"],
			"@rosegriffon/azalee/*": ["./packages/azalee/src/*"],
			"@rosegriffon/inagle": ["./packages/inagle/src/index.ts"],
			"@rosegriffon/inagle/*": ["./packages/inagle/src/*"]
		}
	},
	"exclude": ["node_modules", ".next", "dist", "build", ".turbo", "coverage"]
}
