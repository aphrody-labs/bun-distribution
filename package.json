{
  "name": "@aphrody/bun-libraries",
  "version": "1.4.4",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/workspace",
    "packages/app-host",
    "apps/desktop",
    "packages/video",
    "packages/artifacts"
  ],
  "type": "module",
  "scripts": {
    "setup": "bun packages/workspace/src/cli.ts sync && bun install --frozen-lockfile",
    "doctor": "bun packages/workspace/src/cli.ts doctor",
    "catalog": "bun packages/workspace/src/cli.ts list",
    "status": "bun packages/workspace/src/cli.ts status",
    "sync": "bun packages/workspace/src/cli.ts sync",
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "desktop:dev": "bun run --cwd apps/desktop desktop:dev",
    "desktop:build": "bun run --cwd apps/desktop desktop:build",
    "workspace": "bun packages/workspace/src/cli.ts",
    "frontend:dev": "bun run --cwd libraries/artcraft/frontend dev",
    "frontend:build": "bun run --cwd libraries/artcraft/frontend build",
    "video": "bun packages/video/src/cli.ts",
    "assets": "bun packages/workspace/src/assets-cli.ts",
    "artifacts": "bun packages/artifacts/src/cli.ts",
    "video:build": "bun packages/workspace/src/cli.ts build filmcraft",
    "apps:plan": "bun scripts/build-apps.ts plan",
    "apps:build": "bun scripts/build-apps.ts build"
  },
  "devDependencies": {
    "@aphrody/bun-types": "file:toolchains/bun/packages/bun-types"
  },
  "engines": {
    "bun": "=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
