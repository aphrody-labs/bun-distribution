    "typecheck": "bun run --filter @aphrody/workspace typecheck",
    "test": "bun run --filter @aphrody/workspace test",
    "lint": "bun run --filter @aphrody/workspace lint",
    "format:check": "bun run --filter @aphrody/workspace format:check",
    "workspace:doctor:iecode": "bun packages/infra/workspace/src/ops.ts iecode-doctor --root ../iecode",
    "ai:build": "turbo run build --filter=\"@aphrody/*\"",
    "ai:typecheck": "turbo run typecheck --filter=\"@aphrody/*\"",
    "ai:test": "turbo run test --filter=\"@aphrody/*\"",
    "ai:dev": "turbo run dev",
    "ai:lint": "oxlint -c .oxlintrc.json packages/ai/ packages/web/x/",
    "ai:fmt": "oxfmt packages/ai/ packages/web/x/",
    "docs:translate": "bun packages/ai/doc-ai/src/cli.ts translate",
    "docs:ai": "bun packages/ai/doc-ai/src/cli.ts sync",
    "discord:verify": "bun scripts/audit/discord-verify.ts --full",
    "discord:compile": "bun packages/infra/workspace/src/ops.ts discord compile all --smoke",
    "discord:status": "bun packages/infra/workspace/src/ops.ts discord status",
    "ui:browser-audit": "bun scripts/audit/ui-browser-bundles.ts",
    "web:verify": "bun scripts/audit/web-verify.ts",
    "web:verify:rust": "bun scripts/audit/web-verify.ts --rust",
    "web:smoke": "bun scripts/audit/web-smoke.ts",
    "web:crawl": "bun scripts/tools/web/web-crawl.ts",
    "web:crawlability": "bun scripts/audit/web-crawlability.ts",
    "shenron:verify": "bun scripts/audit/shenron-layout.ts && bun run --filter '@shenron/*' type-check",
    "n2b:google": "aphrody n2b packages/ai/google",
    "scan": "bash scripts/audit/ai/scripts/scan-repo.sh",
    "bench": "bun scripts/tools/ai/scripts/bench-all.ts",
    "bench:all": "bun scripts/tools/ai/scripts/bench-all.ts",
    "bench:rust": "bun scripts/tools/ai/scripts/bench-rust-surface.ts",
    "bench:bun": "bun scripts/tools/ai/scripts/bench-bun-surface.ts",
    "bench:python": "bun scripts/tools/ai/scripts/bench-python-surface.ts",
    "rg:status": "bun packages/infra/workspace/src/ops.ts rg status",
    "rg:pipeline": "bun packages/infra/workspace/src/ops.ts rg pipeline",
    "rg:pipeline:plan": "bun packages/infra/workspace/src/ops.ts rg pipeline --dry-run",
    "docs:check-links": "bun packages/infra/workspace/src/ops.ts docs-links --root . --docs docs --scope repository --exclude-file docs/migration/workspace-architecture-before-monorepo-2026-10-01.md --exclude-file docs/NIE-CAPABILITY-MAP.md --exclude-file docs/FILE-SURFACE-AUDIT.md --exclude-file docs/nu-legacy.md --exclude-file docs/ARCHITECTURE-legacy.md",
    "docs:consolidate": "bun packages/infra/workspace/src/ops.ts docs-consolidate",
    "docs:overlaps": "bun packages/infra/workspace/src/ops.ts docs-overlaps --root .",
    "tauri:apps": "bun packages/infra/workspace/src/ops.ts tauri-apps --root .",
    "tauri:apps:check": "bun packages/infra/workspace/src/ops.ts tauri-apps --root . --check",
    "tauri:apps:fix": "bun packages/infra/workspace/src/ops.ts tauri-apps --root . --fix",
    "stack:dedup": "bun packages/infra/workspace/src/ops.ts stack-dedup --root .",
    "ui:wrap": "bun packages/infra/workspace/src/ops.ts web-to-tauri",
    "ui:scaffold": "bun packages/infra/workspace/src/ops.ts scaffold",
    "sources": "bun packages/infra/workspace/src/ops.ts upstream-sources --root .",
    "sources:verify": "bun packages/infra/workspace/src/ops.ts upstream-sources verify --root .",
    "sources:sync": "bun packages/infra/workspace/src/ops.ts upstream-sources sync --apply --root .",
    "tauri:sync": "bun packages/infra/workspace/src/ops.ts tauri-sync --root .",
    "tauri:sync:check": "bun packages/infra/workspace/src/ops.ts tauri-sync --root . --check",
