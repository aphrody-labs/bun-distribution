{
  "name": "aphrody",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*/*",
      "apps/*/*"
    ],
    "catalog": {
      "@types/bun": "1.4.2",
      "@types/node": "24.19.0",
      "typescript": "7.0.2",
      "oxlint": "1.85.0",
      "oxfmt": "0.70.0",
      "@happy-dom/global-registrator": "^20.10.1",
      "tsup": "^8.5.1",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@material/material-color-utilities": "^0.4.0",
      "lit": "^3.3.3",
      "@lit/react": "^1.0.8",
      "@lit/context": "^1.1.6",
      "tslib": "^2.8.1",
      "bun-types": "^1.4.2",
      "wireit": "^0.14.13",
      "turbo": "^2.10.12",
      "motion": "^12.43.0",
      "element-internals-polyfill": "^3.0.2",
      "sass-true": "^10.1.0",
      "@typescript/native-preview": "^7.0.0-dev.20260707.2",
      "@ai-sdk/google": "^3.0.122",
      "@ai-sdk/google-vertex": "^5.0.89",
      "ai": "^6.0.282",
      "firebase": "^10.13.0",
      "firebase-admin": "^12.4.0",
      "genkit": "^1.36.0",
      "@genkit-ai/google-genai": "^1.36.0",
      "zod": "^4.6.4",
      "@modelcontextprotocol/sdk": "^1.30.0",
      "bottleneck": "^2.19.5",
      "class-validator": "^0.15.1",
      "graphql": "^16.14.2",
      "graphql-scalars": "^1.26.0",
      "lru-cache": "^11.5.2",
      "p-queue": "^9.3.3",
      "p-retry": "^8.0.1",
      "reflect-metadata": "^0.2.2",
      "type-graphql": "^2.0.0-rc.3",
      "cheerio": "^1.2.0"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "bun run --filter @aphrody/workspace typecheck",
    "test": "bun run --filter @aphrody/workspace test",
    "lint": "bun run --filter @aphrody/workspace lint",
    "format:check": "bun run --filter @aphrody/workspace format:check",
    "workspace:doctor:iecode": "bun packages/infra/aphrody-workspace/src/ops.ts iecode-doctor --root ../iecode",
    "ai:build": "turbo run build --filter=\"@aphrody/*\"",
    "ai:typecheck": "turbo run typecheck --filter=\"@aphrody/*\"",
    "ai:test": "turbo run test --filter=\"@aphrody/*\"",
    "ai:dev": "turbo run dev",
    "ai:lint": "oxlint -c .oxlintrc.json packages/ai/ packages/web/x/",
    "ai:fmt": "oxfmt packages/ai/ packages/web/x/",
    "docs:translate": "bun packages/ai/doc-ai/src/cli.ts translate",
    "docs:ai": "bun packages/ai/doc-ai/src/cli.ts sync",
    "n2b:google": "aphrody n2b packages/ai/google",
    "scan": "bash scripts/audit/ai/scripts/scan-repo.sh",
    "bench": "bun scripts/tools/ai/scripts/bench-all.ts",
    "bench:all": "bun scripts/tools/ai/scripts/bench-all.ts",
    "bench:rust": "bun scripts/tools/ai/scripts/bench-rust-surface.ts",
    "bench:bun": "bun scripts/tools/ai/scripts/bench-bun-surface.ts",
    "bench:python": "bun scripts/tools/ai/scripts/bench-python-surface.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "cheerio": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@discordjs/rest@2.5.0": "patches/@discordjs%2Frest@2.5.0.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "bun",
    "esbuild",
    "lmdb",
    "msgpackr-extract"
  ]
}
