{
  "name": "@aphrody/bun-os",
  "version": "1.4.4",
  "private": true,
  "description": "Aphrody OS and Bun Libraries unified source workspace",
  "license": "MIT",
  "bin": {
    "bun-os": "src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/distribution.ts"
  },
  "workspaces": [
    "packages/package-converter",
    "packages/workspace",
    "packages/video",
    "packages/artifacts",
    "apps/desktop"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "cargo:metadata": "bun scripts/cargo.ts metadata",
    "cargo:check": "bun scripts/cargo.ts check",
    "cargo:test": "bun scripts/cargo.ts test",
    "plan": "bun src/cli.ts plan",
    "sources": "bun src/cli.ts sources",
    "stage": "bun src/cli.ts stage",
    "wasm": "bun src/cli.ts wasm",
    "image": "bun src/cli.ts image",
    "typecheck": "bun check -p tsconfig.json --threads=2 --no-pretty",
    "lint": "bun lint --deny-warnings src container factory infra packages/package-converter/src packages/workspace/src packages/video/src packages/artifacts/src apps/desktop scripts",
    "format": "bun fmt --write -c bun-format.json --ignore-pattern '**/*.html' src container factory infra packages/package-converter/src packages/workspace/src packages/video/src packages/artifacts/src apps/desktop scripts",
    "format:check": "bun fmt --check -c bun-format.json --ignore-pattern '**/*.html' src container factory infra packages/package-converter/src packages/workspace/src packages/video/src packages/artifacts/src apps/desktop scripts",
    "check": "bun scripts/quality.ts",
    "doctor": "bun packages/workspace/src/cli.ts doctor",
    "catalog": "bun packages/workspace/src/cli.ts list",
    "status": "bun packages/workspace/src/cli.ts status",
    "sync": "bun packages/workspace/src/cli.ts sync",
    "migrate": "aphrody n2b . --aggressive --ignore 'node_modules/**' --ignore 'out/**' --ignore '.git/**' --jobs 2 --agent --report json",
    "factory": "bun factory/ubuntu.ts",
    "packages": "bun packages/package-converter/src/cli.ts",
    "apt:build": "bun src/build-apt.ts",
    "workspace": "bun packages/workspace/src/cli.ts",
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "desktop:dev": "bun run --cwd apps/desktop desktop:dev",
    "desktop:build": "bun run --cwd apps/desktop desktop:build",
    "frontend:dev": "bun run --cwd libraries/artcraft/frontend dev",
    "frontend:build": "bun run --cwd libraries/artcraft/frontend build",
    "video": "bun packages/video/src/cli.ts",
    "assets": "bun packages/workspace/src/assets-cli.ts",
    "artifacts": "bun packages/artifacts/src/cli.ts",
    "video:build": "bun packages/workspace/src/cli.ts build filmcraft",
    "apps:plan": "bun scripts/build-apps.ts plan",
    "apps:build": "bun scripts/build-apps.ts build"
  },
  "dependencies": {
    "@aphrody/bun-workspace": "workspace:*"
  },
  "devDependencies": {
    "@aphrody/bun-types": "1.4.4"
  },
  "engines": {
    "bun": "=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
