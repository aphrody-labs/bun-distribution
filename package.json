    "monorepo:clean": "bun apps/yolo/cli/src/index.ts ops workspace-clean --root .",
    "layering:check": "bun scripts/tools/workspace/repo-layering.ts",
    "paths:audit": "bun apps/yolo/cli/src/index.ts ops path-audit",
    "paths:fix": "bun apps/yolo/cli/src/index.ts ops path-audit --apply",
    "env:example:sync": "bun scripts/audit/workspace/env-inventory.ts",
    "db:compare": "bun scripts/audit/infra/db-compare/compare-rg-shenron.ts",
    "infra:pipeline:sync": "bun apps/yolo/cli/src/index.ts ops pipeline-catalog --root . --apply",
    "docs": "bun apps/yolo/cli/src/index.ts ops docs",
    "docs:audit": "bun apps/yolo/cli/src/index.ts ops docs audit --root . --json",
    "docs:site": "bun apps/yolo/cli/src/index.ts ops docs site --root .",
    "cli:help": "bun apps/yolo/cli/src/index.ts ops cli-help",
    "build:factory": "bun apps/yolo/cli/src/index.ts ops build-factory",
