{
  "name": "@aphrody/bun-os",
  "version": "1.4.4",
  "private": true,
  "description": "Aphrody OS unified product and library workspace",
  "license": "MIT",
  "bin": {
    "bun-os": "src/cli.ts"
  },
  "workspaces": [
    "apps/desktop",
    "packages/bun-app-host",
    "packages/bun-artifacts",
    "packages/bun-video-project",
    "packages/bun-workspace",
    "packages/kernel-client",
    "packages/ovh",
    "packages/package-converter",
    "packages/paths",
    "libraries/artcraft/frontend",
    "libraries/artcraft/frontend/apps/artcraft",
    "libraries/artcraft/frontend/libs/*",
    "libraries/artcraft/frontend/libs/analytics/*",
    "libraries/artcraft/frontend/libs/components/*",
    "libraries/artcraft/frontend/libs/state/*"
  ],
  "type": "module",
  "exports": {
    ".": "./src/distribution.ts"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "cargo:metadata": "bun scripts/cargo.ts metadata",
    "cargo:fmt": "bun scripts/cargo.ts fmt",
    "cargo:check": "bun scripts/cargo.ts check",
    "cargo:test": "bun scripts/cargo.ts test",
    "plan": "bun src/cli.ts plan",
    "sources": "bun src/cli.ts sources",
    "stage": "bun src/cli.ts stage",
    "wasm": "bun src/cli.ts wasm",
    "image": "bun src/cli.ts image",
    "typecheck": "bun check -p tsconfig.json --threads=2 --no-pretty",
    "lint": "bun lint --deny-warnings src container factory infra packages apps/desktop scripts",
    "format": "bun fmt --write -c bun-format.json --ignore-pattern '**/*.html' src container factory infra packages apps/desktop scripts",
    "format:check": "bun fmt --check -c bun-format.json --ignore-pattern '**/*.html' src container factory infra packages apps/desktop scripts",
    "check": "bun scripts/quality.ts",
    "doctor": "bun packages/bun-workspace/src/cli.ts doctor",
    "catalog": "bun packages/bun-workspace/src/cli.ts list",
    "status": "bun packages/bun-workspace/src/cli.ts status",
    "sync": "bun packages/bun-workspace/src/cli.ts sync",
    "factory": "bun factory/ubuntu.ts",
    "packages": "bun packages/package-converter/src/cli.ts",
    "apt:build": "bun src/build-apt.ts",
    "workspace": "bun packages/bun-workspace/src/cli.ts",
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "desktop:dev": "bun run --cwd apps/desktop desktop:dev",
    "desktop:build": "bun run --cwd apps/desktop desktop:build",
    "frontend:dev": "bun run --filter @frontend/source dev",
    "frontend:build": "bun scripts/build-frontend.ts build",
    "frontend:install": "bun install --filter @frontend/source --frozen-lockfile",
    "video": "bun packages/bun-video-project/src/cli.ts",
    "assets": "bun packages/bun-workspace/src/assets-cli.ts",
    "artifacts": "bun packages/bun-artifacts/src/cli.ts",
    "video:build": "bun packages/bun-workspace/src/cli.ts build filmcraft",
    "apps:plan": "bun scripts/build-apps.ts plan",
    "apps:build": "bun scripts/build-apps.ts build",
    "packages:plan": "bun scripts/build-packages.ts plan",
    "packages:build": "bun scripts/build-packages.ts build",
    "source:plan": "bun scripts/source-portal.ts plan",
    "source:refresh": "bun scripts/source-portal.ts refresh && bun fmt --write -c bun-format.json infra/source-portal.json",
    "source:verify": "bun scripts/source-portal.ts verify --live",
    "workspace:manifests": "bun scripts/workspace-manifests.ts"
  },
  "dependencies": {
    "@aphrody/bun-app-host": "workspace:*",
    "@aphrody/bun-artifacts": "workspace:*",
    "@aphrody/bun-video-project": "workspace:*",
    "@aphrody/bun-workspace": "workspace:*",
    "@aphrody/tauri": "catalog:"
  },
  "devDependencies": {
    "@aphrody/bun-types": "catalog:",
    "@types/node": "catalog:",
    "undici-types": "catalog:"
  },
  "overrides": {
    "@preact/signals-react": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "@remix-run/node": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tauri-apps/plugin-dialog": "catalog:",
    "@tauri-apps/plugin-http": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "dayjs": "catalog:",
    "detect-gpu": "catalog:",
    "konva": "catalog:",
    "postcss": "catalog:",
    "postcss-import": "catalog:",
    "postcss-nesting": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-copy-to-clipboard": "catalog:",
    "react-dom": "catalog:",
    "react-drag-drop-files": "catalog:",
    "react-helmet": "catalog:",
    "react-hot-toast": "catalog:",
    "react-konva": "catalog:",
    "react-resizable-panels": "catalog:",
    "react-router-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "catalog:",
    "undici-types": "catalog:"
  },
  "engines": {
    "bun": "=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "@aphrody/tauri": "file:toolchains/bun/packages/bun-tauri",
    "@types/node": "26.6.5",
    "undici-types": "8.11.2",
    "@preact/signals-react": "3.12.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@remix-run/node": "2.17.5",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "@tauri-apps/plugin-http": "2.8.2",
    "@types/lodash": "4.17.26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "dayjs": "1.11.23",
    "detect-gpu": "5.0.70",
    "konva": "10.8.0",
    "postcss": "8.5.30",
    "postcss-import": "17.0.1",
    "postcss-nesting": "14.0.3",
    "posthog-js": "1.438.9",
    "react": "19.3.0",
    "react-copy-to-clipboard": "5.1.1",
    "react-dom": "19.3.0",
    "react-drag-drop-files": "3.1.0",
    "react-helmet": "6.1.0",
    "react-hot-toast": "2.6.1",
    "react-resizable-panels": "4.14.5",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "@aphrody/bun-types": "1.4.4",
    "react-konva": "19.3.0"
  }
}
