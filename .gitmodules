[submodule "forks/material-web"]
	path = forks/material-web
	url = git@github-dev:aphrody-labs/material-web.git
	upstream = https://github.com/material-components/material-web.git
	shallow = true
[submodule "forks/material-color-utilities"]
	path = forks/material-color-utilities
	url = git@github-dev:aphrody-labs/material-color-utilities.git
	upstream = https://github.com/material-foundation/material-color-utilities.git
	shallow = true
[submodule "forks/material-design-icons"]
	path = forks/material-design-icons
	url = git@github-dev:aphrody-labs/material-design-icons.git
	upstream = https://github.com/google/material-design-icons.git
	shallow = true
	sparse-script = packages/material-design-icons/scripts/sync-catalogue.ts
[submodule "packages/nie-ui"]
	path = packages/nie-ui
	url = git@github-dev:aphrody-labs/nie-ui.git
[submodule "forks/fonts"]
	path = forks/fonts
	url = git@github-dev:aphrody-labs/fonts.git
	upstream = https://github.com/google/fonts.git
	shallow = true
	sparse = ofl/googlesansflex ofl/googlesanscode ofl/robotoflex ofl/robotomono ofl/notosansjp ofl/mplus1code
