The release build runs bun install --frozen-lockfile, which refused the stale lock.

(cherry picked from commit 954db0c030d703e1b84cb03ce2bbdf44df03fdaa)
---
 bun.lock | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/bun.lock b/bun.lock
index 09c427a342..d971fd0588 100644
--- a/bun.lock
+++ b/bun.lock
@@ -21,7 +21,7 @@
       },
     },
     "packages/bun-types": {
-      "name": "bun-types",
+      "name": "@aphrody/bun-types",
