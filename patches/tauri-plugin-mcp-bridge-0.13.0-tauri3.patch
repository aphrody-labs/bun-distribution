+
+/// Host names that identify the local machine.
+fn is_loopback_host(host: &str) -> bool {
+    matches!(host, "127.0.0.1" | "localhost" | "::1" | "[::1]")
+}
+
+/// Splits `host[:port]` (also `[v6]:port`) and returns the bare host.
+fn host_without_port(authority: &str) -> &str {
+    if let Some(rest) = authority.strip_prefix('[') {
+        return rest.split(']').next().map_or(authority, |inner| {
+            // Keep the bracketed form recognised by `is_loopback_host`.
+            if inner == "::1" {
+                "::1"
+            } else {
+                inner
+            }
+        });
+    }
+    authority.rsplit_once(':').map_or(authority, |(host, port)| {
+        if port.chars().all(|c| c.is_ascii_digit()) {
+            host
+        } else {
+            authority
+        }
+    })
+}
+
+/// Origin header host (`scheme://host[:port]`), if it parses.
+fn origin_host(origin: &str) -> Option<&str> {
+    let rest = origin.split_once("://")?.1;
+    Some(host_without_port(rest.split('/').next()?))
+}
+
+/// Constant-time comparison so token checks do not leak the match length.
+fn constant_time_eq(a: &str, b: &str) -> bool {
+    let (a, b) = (a.as_bytes(), b.as_bytes());
+    if a.len() != b.len() {
+        return false;
+    }
+    a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+/// Query parameter `token` of a request target (`/path?token=...`).
+fn query_token(target: &str) -> Option<&str> {
+    let query = target.split_once('?')?.1;
