+    pub status: u16,
+    #[serde(rename = "statusText")]
+    pub status_text: String,
+    #[serde(rename = "httpVersion")]
+    pub http_version: String,
+    pub cookies: Vec<HarCookie>,
+    pub headers: Vec<HarHeader>,
+    pub content: HarContent,
+    #[serde(rename = "redirectURL")]
