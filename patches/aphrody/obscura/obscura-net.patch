+    pub blocked: Option<f64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub dns: Option<f64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub connect: Option<f64>,
+    pub send: f64,
+    pub wait: f64,
+    pub receive: f64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub ssl: Option<f64>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub comment: Option<String>,
+}
+
+/// Helper builder to construct an `HarEntry` from an Obscura Request and Response pair.
+impl HarEntry {
+    #[must_use]
+    pub fn from_exchange(
+        method: &str,
+        url: &url::Url,
+        request_headers: &HashMap<String, String>,
+        status: u16,
+        response_headers: &HashMap<String, String>,
+        response_body: &[u8],
+        duration_ms: f64,
+    ) -> Self {
+        let started = Utc::now();
+        let query_string = url
+            .query_pairs()
+            .map(|(k, v)| HarQueryParam {
+                name: k.to_string(),
+                value: v.to_string(),
+                comment: None,
+            })
+            .collect();
+
+        let req_headers = request_headers
+            .iter()
+            .map(|(k, v)| HarHeader {
+                name: k.clone(),
+                value: v.clone(),
+                comment: None,
+            })
+            .collect();
+
+        let resp_headers = response_headers
+            .iter()
+            .map(|(k, v)| HarHeader {
+                name: k.clone(),
+                value: v.clone(),
+                comment: None,
+            })
+            .collect();
+
+        let mime_type = response_headers
+            .get("content-type")
+            .cloned()
+            .unwrap_or_else(|| "application/octet-stream".to_string());
+
+        let text = String::from_utf8(response_body.to_vec()).ok();
+        let encoding = if text.is_none() && !response_body.is_empty() {
+            Some("base64".to_string())
+        } else {
+            None
+        };
+
+        Self {
+            pageref: None,
+            started_date_time: started,
+            time: duration_ms,
+            request: HarRequest {
+                method: method.to_uppercase(),
+                url: url.to_string(),
+                http_version: "HTTP/1.1".into(),
+                cookies: Vec::new(),
+                headers: req_headers,
+                query_string,
+                post_data: None,
+                headers_size: -1,
+                body_size: 0,
+                comment: None,
+            },
+            response: HarResponse {
+                status,
+                status_text: if status == 200 {
+                    "OK".into()
+                } else {
+                    "HTTP".into()
+                },
+                http_version: "HTTP/1.1".into(),
+                cookies: Vec::new(),
+                headers: resp_headers,
+                content: HarContent {
+                    size: response_body.len() as i64,
+                    compression: None,
+                    mime_type,
+                    text,
+                    encoding,
+                    comment: None,
+                },
+                redirect_url: String::new(),
+                headers_size: -1,
+                body_size: response_body.len() as i64,
+                comment: None,
+            },
+            cache: HarCache::default(),
+            timings: HarTimings {
+                send: 0.0,
+                wait: duration_ms,
+                receive: 0.0,
+                ..Default::default()
+            },
+            server_ip_address: None,
+            connection: None,
+            comment: None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn har_serialization_roundtrip() {
+        let mut har = Har::new("aphrody-har", "1.0.0");
+        let url = url::Url::parse("https://example.com/test?a=1&b=2").unwrap();
+        let mut req_headers = HashMap::new();
+        req_headers.insert("accept".into(), "text/html".into());
+        let mut resp_headers = HashMap::new();
+        resp_headers.insert("content-type".into(), "text/html".into());
+
+        let entry = HarEntry::from_exchange(
+            "GET",
+            &url,
+            &req_headers,
+            200,
+            &resp_headers,
+            b"Hello World",
+            12.5,
+        );
+
+        har.log.entries.push(entry);
+
+        let json = serde_json::to_string(&har).expect("serialize");
+        assert!(json.contains("Hello World"));
+        assert!(json.contains("example.com"));
+
+        let deserialized: Har = serde_json::from_str(&json).expect("deserialize");
+        assert_eq!(deserialized.log.entries.len(), 1);
+        assert_eq!(deserialized.log.entries[0].response.status, 200);
+    }
+}
