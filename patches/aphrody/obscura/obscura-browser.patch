+# set, so the workspace -D warnings gate does not rewrite upstream style.
+[lints.rust]
+warnings = "allow"
+unexpected_cfgs = "allow"
+# `-D warnings` on the command line outranks the group above; name the groups
+# upstream code actually trips so the vendored tree stays out of the gate.
+unused = { level = "allow", priority = -1 }
+deprecated = "allow"
+
+[lints.clippy]
+all = { level = "allow", priority = -1 }
+pedantic = { level = "allow", priority = -1 }
