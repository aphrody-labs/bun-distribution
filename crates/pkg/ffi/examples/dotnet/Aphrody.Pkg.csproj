<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Aphrody.Pkg</PackageId>
    <Version>0.1.0</Version>
    <Description>Versioned P/Invoke adapter for the Aphrody package store</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativeLibrary)' != '' and '$(RuntimeIdentifier)' != ''">
    <None Include="$(NativeLibrary)" Pack="true" PackagePath="runtimes/$(RuntimeIdentifier)/native/" CopyToOutputDirectory="PreserveNewest" Link="aphrody_pkg.dll" />
  </ItemGroup>
</Project>
