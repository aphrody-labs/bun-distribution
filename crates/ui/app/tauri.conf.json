{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v3.0.0-alpha.3/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "aphrody",
  "identifier": "dev.aphrody.desktop",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "ui-dist",
    "beforeDevCommand": "bun run --filter @aphrody/app-ui dev",
    "beforeBuildCommand": "bun run --filter @aphrody/app-ui build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "aphrody",
        "url": "index.html",
        "width": 1280,
        "height": 832,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#111318"
      },
      {
        "label": "splash",
        "title": "Aphrody",
        "url": "index.html?view=splash",
        "width": 320,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "pet",
        "title": "Aphrody pet",
        "url": "index.html?view=pet",
        "width": 180,
        "height": 196,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "widget",
        "title": "Aphrody widget",
        "url": "index.html?view=widget",
        "width": 300,
        "height": 172,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "quickbar",
        "title": "Aphrody quick ask",
        "url": "index.html?view=quickbar",
        "width": 720,
        "height": 176,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://asset.localhost http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*",
      "devCsp": "default-src 'self'; img-src 'self' asset: data: blob: https://asset.localhost http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:1421 ws://localhost:1421"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "aphrody-code",
    "copyright": "Copyright 2026 aphrody-code",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Local coding agent with open-weight models and retrieval.",
    "longDescription": "Aphrody desktop embeds the shared Rust agent protocol and CLI. The local console provides streaming turns, session history and interruption, with optional retrieval from an existing RAG index.",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {},
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Aphrody",
        "languages": ["English", "French"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "fileAssociations": [
      {
        "ext": ["aphrody"],
        "name": "Aphrody session",
        "description": "Aphrody session",
        "role": "Editor",
        "mimeType": "application/x-aphrody"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt", "log"],
        "name": "Text document",
        "description": "Text document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/plain"
      },
      {
        "ext": ["json"],
        "name": "JSON document",
        "description": "JSON document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/json"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/aphrody.desktop",
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.40.0)",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl3"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aphrody"]
      }
    },
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
