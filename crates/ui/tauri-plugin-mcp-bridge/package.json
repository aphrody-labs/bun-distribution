{
  "name": "@hypothesi/tauri-plugin-mcp-bridge",
  "version": "0.13.0",
  "description": "A Tauri plugin that exposes an MCP server interface via WebSockets.",
  "type": "module",
  "main": "./dist-js/index.js",
  "types": "./dist-js/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-js/index.js",
      "types": "./dist-js/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project guest-js/tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist-js",
    "guest-js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hypothesi/mcp-server-tauri.git",
    "directory": "packages/tauri-plugin-mcp-bridge"
  },
  "author": "hypothesi",
  "license": "MIT",
  "keywords": [
    "tauri",
    "tauri-plugin",
    "mcp",
    "ipc",
    "monitoring"
  ],
  "devDependencies": {
    "typescript": "catalog:",
    "@aphrody/api": "workspace:*"
  },
  "peerDependencies": {
    "@aphrody/api": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
