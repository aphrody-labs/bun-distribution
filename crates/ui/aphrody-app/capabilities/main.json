{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal default-deny permissions for the Aphrody desktop main window. Agent actions use typed app-server JSON-RPC; native domain actions use scoped commands and broker-owned services. Filesystem access is read-only, scoped to $APPDATA plus files opened by the operating system.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-print",
    "core:event:default",

    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch",
    "os:allow-locale",
    "os:allow-hostname",
    "os:allow-os-type",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",

    "notification:default",

    "process:allow-restart",
    "process:allow-exit",

    "window-state:allow-save-window-state",
    "window-state:allow-restore-state",
    "window-state:allow-filename",

    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",

    "log:default",

    "store:default",
    "updater:default",

    "opener:default",
    "deep-link:default",

    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    },

    "aphrody-drive:default"
  ]
}
