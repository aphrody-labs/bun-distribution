{
  "$defs": {
    "adapter": {
      "additionalProperties": false,
      "properties": {
        "handles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "builtin",
            "crate",
            "vendor",
            "command",
            "env"
          ],
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "enum": [
            "acquire",
            "identify",
            "unpack",
            "analyze",
            "lift",
            "decompile",
            "rebuild",
            "verify"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "registered",
            "unavailable"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "stage",
        "kind",
        "owner",
        "handles",
        "status",
        "reason"
      ],
      "type": "object"
    },
    "identifyOutput": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "container": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "pe",
            "elf",
            "macho",
            "apk",
            "zip",
            "iso",
            "uefi",
            "bios",
            "rom",
            "fdt",
            "compressed",
            "raw"
          ],
          "type": "string"
        },
        "liftable": {
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "format",
        "arch",
        "platform",
        "entry",
        "liftable",
        "container",
        "notes"
      ],
      "type": "object"
    }
  },
  "$id": "https://aphrody.com/schema/re/pipeline-report.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "string"
    },
    "outdir": {
      "type": "string"
    },
    "schema_version": {
      "minimum": 0,
      "type": "integer"
    },
    "stages": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "type": "string"
          },
          "artifacts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "kind": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "path",
                "bytes"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "detail": {
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          },
          "output": {
            "description": "Stage payload: AcquireOutput, IdentifyOutput, UnpackOutput, TriageReport, LiftOutput or VerifyOutput."
          },
          "stage": {
            "enum": [
              "acquire",
              "identify",
              "unpack",
              "analyze",
              "lift",
              "decompile",
              "rebuild",
              "verify"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "unavailable",
              "skipped",
              "failed"
            ],
            "type": "string"
          }
        },
        "required": [
          "stage",
          "adapter",
          "status",
          "detail",
          "artifacts",
          "metrics",
          "output"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "summary": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "type": "string"
    },
    "target": {
      "enum": [
        "os",
        "bios",
        "firmware"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "input",
    "target",
    "outdir",
    "stages",
    "summary"
  ],
  "title": "Bun OS RE pipeline report",
  "type": "object"
}
