root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,js,mjs,json,html,css}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf
