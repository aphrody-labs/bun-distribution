# SPDX-License-Identifier: Apache-2.0
# User unit (ubuntu, lingering) on the VPS: refresh the host-side submodule mirrors that Gitea Actions jobs
# clone from (~/build/git-mirrors, mounted read-only into job containers) and add mirrors for new submodule
# URLs of aphrody-dev/bun-os os. Installed to ~/.config/systemd/user; the script is
# infra/config/host/apps/vps/gitea-runner/git-mirrors.sh, installed as ~/apps/gitea-runner/git-mirrors.sh.
# The gh credential is used by this process only; it never reaches the mirrors or the job containers.
[Unit]
Description=Refresh the Gitea Actions submodule mirrors

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/apps/gitea-runner/git-mirrors.sh sync
Nice=10
IOSchedulingClass=idle
UMask=0022
TimeoutStartSec=6h
