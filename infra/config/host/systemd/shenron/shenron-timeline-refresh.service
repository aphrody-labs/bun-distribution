# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Refresh official Shenron timeline projections and DBFR retrieval index
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.aphrody/workspaces/dbfr/private/web
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/usr/bin:/bin
Environment=SHENRON_TIMELINE_REDIS_URL=redis://127.0.0.1:6379
EnvironmentFile=/etc/aphrody/shenron-compute-client.env
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/.local/lib/aphrody/shenron/workspace.mjs timeline refresh --output /home/ubuntu/.aphrody/workspaces/dbfr/private/web/timeline --index --crawl-budget 32
UMask=0077
Nice=10
CPUQuota=100%
MemoryMax=1G
TimeoutStartSec=31min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.aphrody/workspaces/dbfr
StandardOutput=journal
StandardError=journal
