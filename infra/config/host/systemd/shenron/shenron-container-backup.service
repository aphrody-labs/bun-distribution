# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Verified backups of Shenron container-owned PostgreSQL, Redis and SQLite
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/aphrody-infra/backup-shenron-container.py
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
# Retention: only the newest verified snapshot stays on DBFR; shenron-offsite-backup keeps the off-host copy on the VPS.
StandardOutput=journal
StandardError=journal
