# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron Cloudflare tunnel connector
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
LoadCredential=tunnel-token:/etc/aphrody/cloudflare/tunnel-token
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --metrics 127.0.0.1:20243 run --token-file /run/credentials/shenron-cloudflared.service/tunnel-token
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target

