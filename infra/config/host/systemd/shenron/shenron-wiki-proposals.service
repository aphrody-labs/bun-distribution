# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Private wiki proposals with independent review and immutable exports
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/wiki-fill-supervisor.mjs
ConditionPathExists=/home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/queue.sqlite
ConditionPathExists=!/home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/supervisor.pause

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock --nonblock --no-fork --conflict-exit-code 75 /home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/supervisor.lock /home/ubuntu/.local/bin/bun /home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/wiki-fill-supervisor.mjs once --job /home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015
SuccessExitStatus=75
TimeoutStartSec=2h
TimeoutStopSec=60s
KillMode=control-group
UMask=0077
Nice=10
CPUQuota=200%
MemoryHigh=2G
MemoryMax=4G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=append:/home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/supervisor.log
StandardError=append:/home/ubuntu/.aphrody/profiles/dbfr/jobs/wiki-completion-20261015/supervisor.log
