# shenron-site — site Next.js (dragonballfr.com), servi par `next start` sous Bun.
#
# Application Shenron sur son propre plan de release (voir
# docs/reference/infra/SHENRON-MIGRATION.md) : `/home/ubuntu/apps/shenron/current` -> `/home/ubuntu/apps/shenron/releases/<sha>`,
# découplé du pointeur RG `/home/ubuntu/apps/rg/current`. Un seul process, aucun slot
# bleu/vert : la bascule atomique du lien est portée par le déploiement, pas
# par cette unité. Base PostgreSQL : `shenron_site` sur dbfr via
# `shenron-pg-tunnel.service` (127.0.0.1:15433).
#
# Installation :
#   bun $YOLO_ROOT/packages/core/src/host/cli.ts compose-unit shenron-site.service | sudo tee /etc/systemd/system/shenron-site.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now shenron-site.service
[Unit]
Description=Shenron — site Next.js (dragonballfr.com, runtime Bun)
After=network-online.target shenron-pg-tunnel.service
Wants=network-online.target shenron-pg-tunnel.service
StartLimitBurst=20
StartLimitIntervalSec=600

[Service]
Type=simple

# Release Shenron : /home/ubuntu/apps/shenron/current reflète la racine du dépôt shenron
# (apps/bot, apps/site ; le MCP vit dans la release Aphrody).
WorkingDirectory=/home/ubuntu/apps/shenron/current/apps/site

# Secrets et configuration opérateur : emplacement infra-standard utilisé par
# les unités rg-* (`/etc/rose-griffon/<unit>.env`), jamais dans le dépôt ni
# dans un chemin sous la maison de l'utilisateur de service.
EnvironmentFile=-/etc/rose-griffon/shenron-site.env
EnvironmentFile=-/etc/aphrody/shenron-compute-client.env
Environment=NODE_ENV=production
Environment=PORT=5011
# Boucle locale uniquement : nginx (local) est le seul à proxifier.
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
# L'artefact scellé (`bun run site:artifact`) est un `.next-build`, pas `.next`.
Environment=NEXT_DIST_DIR=.next-build
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=/home/ubuntu/apps/shenron/shared/site/bun-cache
Environment=A2A_COORD_DIR=/home/ubuntu/apps/shenron/shared/coord
# Relais /mcp du site vers le serveur MCP public de la release (unité shenron-mcp-http).
Environment=SHENRON_MCP_URL=http://127.0.0.1:8790
# ProtectHome=read-only keeps ~ubuntu read-only; native Node-API modules (@swc/core,
# loaded by next.config.ts) fail to initialise without a writable HOME.
Environment=HOME=/home/ubuntu/apps/shenron/shared/site/home

# `next` est résolu depuis la racine du workspace Bun de la release (hors
# répertoire courant), jamais depuis un chemin `~`/maison : la release est le
# seul artefact de vérité, `/home/ubuntu/apps/shenron/current` bascule atomiquement au déploiement.
ExecStart=/home/ubuntu/.bun/bin/bun --bun /home/ubuntu/apps/shenron/current/node_modules/next/dist/bin/next start -p 5011 -H 127.0.0.1

ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
# Bun sort en 143 (128+SIGTERM) au lieu de mourir du signal : sans cette ligne
# systemd marque l'unité `failed` à chaque arrêt propre.
SuccessExitStatus=143

Restart=always
RestartSec=5
RestartSteps=4
RestartMaxDelaySec=45

# Next SSR/ISR/RSC — pas de plafond serré : un reclaim cgroup au ras du seuil
# gèle l'event-loop (incident de référence documenté côté application).
MemoryAccounting=true
MemoryHigh=10G
MemoryMax=12G
MemoryLow=1G
MemorySwapMax=2G
LimitNOFILE=131072
OOMScoreAdjust=-300
CPUWeight=150
IOWeight=150

PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

# Caches durables hors de la release (jamais sous /home/ubuntu/apps/shenron/current, qui
# bascule à chaque déploiement) — même convention que /home/ubuntu/apps/aphrody/shared.
# `.next-build/cache` de la release est un lien vers
# /home/ubuntu/apps/shenron/shared/site/next-cache (cache images/fetch conservé d'une
# release à l'autre) ; le cache ISR de Next écrit aussi sous `.next-build/server`,
# d'où l'écriture autorisée sur le `.next-build` de la release active.
ExecStartPre=+/usr/bin/install -d -o ubuntu -g ubuntu /home/ubuntu/apps/shenron/shared/site/home /home/ubuntu/apps/shenron/shared/site/bun-cache /home/ubuntu/apps/shenron/shared/site/runtime-cache /home/ubuntu/apps/shenron/shared/site/image-cache /home/ubuntu/apps/shenron/shared/site/next-cache /home/ubuntu/apps/shenron/shared/coord
ReadWritePaths=/home/ubuntu/apps/shenron/shared/site /home/ubuntu/apps/shenron/shared/coord /home/ubuntu/apps/shenron/current/apps/site/.next-build

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-site

[Install]
WantedBy=multi-user.target
