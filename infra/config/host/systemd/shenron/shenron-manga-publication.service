# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Qualified manga acquisition publication consumer
Wants=network-online.target
After=network-online.target docker.service
ConditionPathExists=/home/ubuntu/.aphrody/private/shenron/manga-publication/runtime/manga-publication-worker

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/ubuntu/.aphrody/private/shenron/manga-publication
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/ubuntu/.aphrody/private/shenron/manga-publication/worker.env
ExecStart=/home/ubuntu/.aphrody/private/shenron/manga-publication/runtime/manga-publication-worker watch /home/ubuntu/.aphrody/private/shenron/manga-publication/config.json
Restart=always
RestartSec=30s
TimeoutStopSec=90s
KillMode=control-group
UMask=0077
Nice=10
CPUQuota=100%
MemoryHigh=1G
MemoryMax=2G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
