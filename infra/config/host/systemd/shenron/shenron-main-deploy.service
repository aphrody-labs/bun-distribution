[Unit]
Description=Synchronize Shenron main and build and deploy qualified services
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/home/ubuntu/.config/shenron-autodeploy
ExecStart=/home/ubuntu/.config/shenron-autodeploy/factory-run.sh --run
TimeoutStartSec=4h
UMask=0077
Nice=5
MemoryMax=12G
CPUQuota=400%
TasksMax=1024
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-main-deploy
