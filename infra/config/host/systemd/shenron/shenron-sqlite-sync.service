# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Qualified SQLite off-host backup and PostgreSQL wiki replica synchronization
Requires=docker.service
After=network-online.target docker.service aphrody-mesh.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/src/aphrody
ExecStart=/home/ubuntu/.local/bin/bun --no-env-file /usr/local/libexec/aphrody-infra/shenron-sqlite-sync-pipeline.mjs /home/ubuntu/src/aphrody /etc/aphrody/shenron/sqlite-sync.json
UMask=0077
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
