# rg-core — the single Rose Griffon VPS service: one Bun single-file binary
# (aphrody-labs/rosegriffon/apps/rg-bot/src/core.ts)
# running the Discord gateway of the `rg` profile (and the `azalee` profile as a supervised child),
# the Achilléa ranked Colyseus server with the unified API in process, the in-process cron
# (packages/rg-cron registry, Bun.cron) and nie-model-serve (crates/aphrody-nie-model-serve) as a
# supervised loopback child. One port, 127.0.0.1:8810, behind nginx (nginx/rg/rg-core.conf,
# nginx/nie/nie.aphrody.app.conf). Replaces nie-model-serve.service.
#
# The executable is provisioned from the Rose Griffon source/release owner; this
# Bun OS checkout no longer contains the application build source.
# /etc/aphrody/rg-core.env (root:ubuntu 0640) holds the production environment: Discord tokens,
# Supabase session pooler (DATABASE_URL), Neon `inagle` (INAGLE_DATABASE_URL), JWT_SECRET_KEY,
# CRON_SECRET, BOT_ADMIN_TOKEN, NIE_* paths and RG_MEDIA_ROOT.
[Unit]
Description=Rose Griffon core (Discord gateways, ranked Colyseus, model serve, cron)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
SupplementaryGroups=adm
WorkingDirectory=/var/lib/rg-core
EnvironmentFile=/etc/aphrody/rg-core.env
Environment=NODE_ENV=production RG_CORE_HOST=127.0.0.1 RG_CORE_PORT=8810
ExecStart=/usr/local/bin/rg-core
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=20
StateDirectory=rg-core rg-core/media rg-core/cdn rg-core/shared rg-core/disputes rg
StateDirectoryMode=0755
LimitNOFILE=65536
MemoryHigh=10G
MemoryMax=12G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/ubuntu/apps/nie/cache /home/ubuntu/apps/nie/var -/home/ubuntu/.bun/install/cache
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rg-core

[Install]
WantedBy=multi-user.target
