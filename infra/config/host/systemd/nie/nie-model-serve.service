# IEVR asset origin (crates/aphrody-nie-model-serve) behind nginx on nie.aphrody.app
# (nginx/nie/nie.aphrody.app.conf). Game installed by `nie steam sync -o <game-dir>`.
# Binary built from the bun-os checkout:
#   cargo build --release -p aphrody-nie-model-serve
#   install -m 755 target/release/aphrody-nie-model-serve /home/ubuntu/.local/bin/
[Unit]
Description=nie-model-serve (IEVR assets for iecode and rg, nie.aphrody.app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/nie
Environment=NIE_GAME_DIR=/home/ubuntu/apps/nie/game
ExecStart=/home/ubuntu/.local/bin/aphrody-nie-model-serve --game-dir /home/ubuntu/apps/nie/game --cache-dir /home/ubuntu/apps/nie/cache --port 8792 --threads 8
Restart=always
RestartSec=2
MemoryHigh=6G
MemoryMax=8G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/ubuntu/apps/nie/cache /home/ubuntu/apps/nie/var
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nie-model-serve

[Install]
WantedBy=multi-user.target
