{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Infra native Aphrody Windows startup",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "home", "root", "principal", "trigger", "services"],
  "properties": {
    "version": { "const": 1 },
    "home": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "logonType", "runLevel"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "logonType": { "enum": ["Interactive", "S4U", "ServiceAccount"] },
        "runLevel": { "enum": ["Limited", "Highest"] }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "enum": ["logon", "boot"] } }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "executable", "enabled", "bind", "port", "arguments", "healthPath"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
          "kind": { "enum": ["site", "mcp", "a2a"] },
          "executable": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "bind": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "desiredPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "home": { "type": "string", "minLength": 1 },
          "principal": { "$ref": "#/properties/principal" },
          "trigger": { "$ref": "#/properties/trigger" },
          "existingTask": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "name"],
            "properties": { "path": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
          },
          "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 4096 } },
          "healthPath": { "type": "string", "pattern": "^/[^\\r\\n]*$" }
        }
      }
    }
  }
}
