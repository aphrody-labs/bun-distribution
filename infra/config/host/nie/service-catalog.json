{
  "schemaVersion": 1,
  "owner": "iecode",
  "supervisor": "systemd",
  "proxy": "nginx",
  "services": [
    {
      "id": "rg-core",
      "application": "rg",
      "kind": "bun-single-file",
      "runtime": "bun",
      "unit": "rg-core.service",
      "health": "http://127.0.0.1:8810/health",
      "port": 8810,
      "capabilities": ["discord-gateway", "ranked-colyseus", "unified-api", "cron", "3d-assets"],
      "children": [
        {
          "id": "nie-model-serve",
          "runtime": "rust",
          "port": 8792,
          "health": "http://127.0.0.1:8792/health"
        }
      ],
      "sourceRepo": "bun-os",
      "workingDirectory": "/var/lib/rg-core",
      "environmentFile": "/etc/aphrody/rg-core.env",
      "publicProxy": "nginx",
      "public": true,
      "status": "active",
      "publicOrigins": [
        "https://ranked.rosegriffon.fr",
        "https://bot.rosegriffon.fr",
        "https://cdn.rosegriffon.fr",
        "https://nie.aphrody.app"
      ],
      "consumers": ["iecode-web", "rg-website"]
    },
    {
      "id": "rg-website",
      "application": "rg",
      "kind": "next-standalone",
      "runtime": "bun",
      "unit": "rg-website.service",
      "health": "http://127.0.0.1:3100/",
      "port": 3100,
      "sourceRepo": "bun-os",
      "workingDirectory": "/home/ubuntu/apps/rg/current/apps/rg-website",
      "environmentFile": "/etc/rg/rg.env",
      "publicOrigin": "https://rosegriffon.fr",
      "publicProxy": "nginx",
      "public": true,
      "status": "active"
    }
  ],
  "policies": {
    "oneUnitPerWorkload": true,
    "onePublicProxy": true,
    "releasePlanes": {},
    "applicationRoots": {
      "aphrody-web": "/home/ubuntu/apps/aphrody/current",
      "aphrody-ai": "/home/ubuntu/apps/aphrody/current",
      "rg": "/home/ubuntu/apps/rg/current",
      "shenron": "/home/ubuntu/apps/shenron/current",
      "nie": "/home/ubuntu/apps/nie"
    },
    "secrets": "operator-managed-environment-files",
    "retiredUnits": [
      "rg-watchdog@.service",
      "rg-repo-sync.service",
      "shenron.service",
      "shenron-site-b.service",
      "shenron-api.service",
      "shenron-mcp.service",
      "shenron-watchdog.service",
      "shenron-watchdog.timer",
      "shenron-clean-vps.service",
      "shenron-clean-vps.timer",
      "shenron-log-watcher.service",
      "shenron-zswap.service",
      "filebrowser.service",
      "nie-model-serve.service"
    ],
    "sharedRuntimes": ["bun", "postgresql", "redis", "nginx"],
    "databasePolicy": "postgresql-primary-with-sqlite-local-cache",
    "authPolicy": "one-better-auth-contract-per-public-origin"
  }
}
