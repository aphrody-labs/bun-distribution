# Job image of the `aphrody-bun-linux` runner label: Rust with the workspace nightly, and the
# system libraries the native engine (wgpu/winit/Bevy) and C/C++ cores need. The qualified Linux
# Bun binary is mounted read-only by the runner at /usr/local/bin/bun.
#
#   docker build -t aphrody/bun-os-build:<date> -f Containerfile .
FROM docker.io/library/rust@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates git openssh-client curl unzip xz-utils zstd python3 \
    pkg-config cmake ninja-build clang lld \
    libxkbcommon-dev libwayland-dev libx11-dev libxcursor-dev libxi-dev libxrandr-dev \
    libudev-dev libasound2-dev libvulkan-dev libssl-dev \
  && rm -rf /var/lib/apt/lists/*

# Same toolchain as rust-toolchain.toml, so jobs never download it.
RUN rustup toolchain install nightly-2026-09-15 --profile minimal --component rustfmt,clippy,rust-src \
  && rustup default nightly-2026-09-15
