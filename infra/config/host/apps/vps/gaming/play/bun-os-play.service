# play.aphrody.app (apps/play): Bun API/WebSocket server on 127.0.0.1:18481 that owns the play
# NGINX engine through bun:nginx (127.0.0.1:18480, mesh 10.200.77.1:18482). Installed by
# apps/play/scripts/deploy.ts into ~/.config/systemd/user/. The runtime is the Bun OS release with
# bun:nginx (~/apps/play/runtime/bun); the shared ~/.local/bin/bun 1.4.4 predates that module.
[Unit]
Description=Bun OS Play (play.aphrody.app) with its bun:nginx engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=bun-os-gaming.slice
WorkingDirectory=%h/apps/play/current
EnvironmentFile=%h/apps/play/play.env
ExecStart=%h/apps/play/runtime/bun %h/apps/play/current/server.js
ExecReload=/bin/kill -HUP $MAINPID
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
Nice=5
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
