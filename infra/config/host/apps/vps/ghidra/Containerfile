# Runtime for the continuous reverse-engineering worker (ghidra_re.py): JDK 21 and Python only.
# The pinned Ghidra release and its PyGhidra venv live on /home (see up.sh) and are mounted at
# /opt/ghidra and /work/venv, which keeps this image small on the VPS root filesystem.
FROM eclipse-temurin:21-jdk-noble

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv tini \
 && rm -rf /var/lib/apt/lists/*

ENV GHIDRA_INSTALL_DIR=/opt/ghidra \
    JAVA_HOME=/opt/java/openjdk \
    PATH=/work/venv/bin:/opt/ghidra/support:/opt/ghidra:$PATH \
    HOME=/work/home \
    RE_WORK=/work \
    PYTHONUNBUFFERED=1

COPY entry.sh /opt/re/entry.sh

WORKDIR /work
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/re/entry.sh"]
CMD ["loop"]
