[Unit]
Description=Aphrody A2A hub (loopback 127.0.0.1:23888, tunnel Windows 24888)
After=network.target

[Service]
WorkingDirectory=%h/.aphrody/checkout
Type=simple
EnvironmentFile=%h/.aphrody/private/a2a/hub.env
Environment=PATH=%h/.cargo/bin:%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/aphrody a2a serve --bind 127.0.0.1:23888 --coord-dir %h/.aphrody/a2a/coord
Restart=always
RestartSec=2
Nice=10
CPUWeight=20
MemoryHigh=192M
MemoryMax=384M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
