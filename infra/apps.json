  "build": {
    "outputRoot": "../build/apps",
    "timeoutSeconds": 600,
    "sharedHeavyLock": "../../bun/build/cargo-serial/.build.lock",
    "lockKind": "exclusive-file"
  },
  "runtimeSnapshots": {
    "windows-x64": {
      "path": "$BUN_INSTALL/bin/bun.exe",
