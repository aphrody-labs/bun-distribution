      "id": "desktop",
      "hostname": "desktop.aphrody.app",
      "kind": "bun-server",
      "workspace": "os",
      "entrypoint": "apps/desktop/server.ts",
      "entrypointWorkspace": "os",
      "source": {
        "repository": "aphrody-labs/bun-distribution",
        "path": "apps/desktop",
        "license": "MIT"
      },
      "native": {
        "required": true,
        "binary": null
      },
      "assetRoots": ["apps/desktop/web"],
