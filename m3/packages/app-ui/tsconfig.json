{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": [
      "@react-three/fiber"
    ]
  },
  "include": ["src", "build.ts", "undeclared-deps.ts", "m3.config.ts", "../assets/types.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
