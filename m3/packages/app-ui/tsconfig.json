{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "customConditions": ["bun"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "~/*": ["./src/*"]
    },
    "types": [
      "@react-three/fiber"
    ]
  },
  "include": [
    "src",
    "build.ts",
    "undeclared-deps.ts",
    "m3.config.ts",
    "../assets/types.d.ts",
    "../../../crates/tauri/aphrody-tauri-api/src/global.d.ts",
    "../../../packages/os/drive-client/src/tiny-invariant.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
