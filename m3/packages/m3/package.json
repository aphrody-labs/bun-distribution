{
  "name": "@aphrody/m3",
  "version": "1.4.4",
  "description": "The @aphrody Material Design 3 framework for Bun: one plugin (Tailwind v4, Sass through Rust, m3:* virtual theme/font modules, ?url imports), serveM3 (Bun.serve + HMR + proxy), buildM3 (Bun.build, Tauri webview layout), M3App and the m3 CLI.",
  "keywords": [
    "bun",
    "material-3",
    "md3",
    "tailwind",
    "tauri"
  ],
  "homepage": "https://github.com/aphrody-labs/aphrody-m3/tree/main/packages/m3#readme",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody-m3.git",
    "directory": "packages/m3"
  },
  "bin": {
    "m3": "./bin/m3.ts"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "client.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/lit.js",
    "./src/app/runtime/client.tsx"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "bun": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "bun": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./build": {
      "bun": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./config": {
      "bun": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "default": "./dist/lit.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./i18n": {
      "bun": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./src/i18n.ts",
      "default": "./dist/i18n.js"
    },
    "./data": {
      "bun": "./src/data.ts",
      "types": "./dist/data.d.ts",
      "import": "./src/data.ts",
      "default": "./dist/data.js"
    },
    "./app": {
      "bun": "./src/app/index.ts",
      "types": "./src/app/index.ts",
      "default": "./src/app/index.ts"
    },
    "./app/link": {
      "bun": "./src/app/link.tsx",
      "types": "./src/app/link.tsx",
      "default": "./src/app/link.tsx"
    },
    "./app/navigation": {
      "react-server": "./src/app/navigation.server.ts",
      "bun": "./src/app/navigation.ts",
      "types": "./src/app/navigation.ts",
      "default": "./src/app/navigation.ts"
    },
    "./app/headers": {
      "bun": "./src/app/headers.ts",
      "types": "./src/app/headers.ts",
      "default": "./src/app/headers.ts"
    },
    "./app/server": {
      "bun": "./src/app/server.ts",
      "types": "./src/app/server.ts",
      "default": "./src/app/server.ts"
    },
    "./app/cache": {
      "bun": "./src/app/cache.ts",
      "types": "./src/app/cache.ts",
      "default": "./src/app/cache.ts"
    },
    "./app/image": {
      "bun": "./src/app/image.tsx",
      "types": "./src/app/image.tsx",
      "default": "./src/app/image.tsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts build --only $npm_package_name",
    "typecheck": "bun check -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/fonts-sync.ts --quiet && APHRODY_FFI_DEV=1 bun test"
  },
  "dependencies": {
    "@aphrody/bun": "^3.3.0",
    "@aphrody/bun-plugin-tailwind": "0.1.0-aphrody.4",
    "@aphrody/m3-fonts": "workspace:*",
    "@aphrody/m3-motion": "workspace:*",
    "@aphrody/m3-react": "workspace:*",
    "@aphrody/m3-theme": "workspace:*",
    "@aphrody/material-web": "catalog:",
    "@aphrody/scaffold": "workspace:*",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-parcel": "catalog:"
  },
  "peerDependencies": {
    "@aphrody/m3-bun": "workspace:*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-server-dom-parcel": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@aphrody/m3-bun": {
      "optional": true
    },
    "react-server-dom-parcel": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
