{
  "name": "@aphrody/m3-mcp",
  "version": "3.3.4",
  "description": "Single design/UI MCP server of aphrody-m3: packages, M3 tokens (lookup, validate), docs search, research links, templates, Material Symbols SVG, SVG to Tauri icons.",
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aphrody/m3-os-themes": "workspace:*",
    "@aphrody/material-design-icons": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
