{
  "name": "@aphrody/m3-next-example",
  "version": "3.3.4",
  "description": "Sample Next.js 16 app on the M3 stack: App Router, Cache Components, proxy.ts, React Compiler, typed routes, Tailwind v4 and Base UI, built and served on Bun through yolo.",
  "type": "module",
  "scripts": {
    "dev": "bun ../../../../../apps/yolo/cli/src/index.ts m3 next dev",
    "build": "bun ../../../../../apps/yolo/cli/src/index.ts m3 next build",
    "start": "bun ../../../../../apps/yolo/cli/src/index.ts m3 next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./test/"
  },
  "dependencies": {
    "@aphrody/m3-baseui": "workspace:*",
    "@aphrody/m3-next": "workspace:*",
    "@aphrody/m3-tailwind": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
