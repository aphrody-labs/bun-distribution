{
  "name": "@aphrody/rg-ui",
  "version": "1.0.5",
  "private": false,
  "description": "Rose Griffon, Achillea and Azalee shared UI on the Aphrody Bun Base UI fork and native Material 3 tokens",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody.git",
    "directory": "m3/packages/rg-ui"
  },
  "files": [
    "src",
    "scripts",
    "SOURCE.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/adsense": "./src/lib/adsense.ts",
    "./styles.css": "./src/styles.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./*": "./src/components/*.tsx",
    "./brands.css": "./src/brands.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "lint": "oxlint src",
    "type-check": "bun --bun tsc --noEmit",
    "test": "bun test test",
    "tokens": "bun scripts/generer-tokens.ts",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@aphrody/m3-tokens": "3.3.9",
    "@base-ui/react": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "qrcode-generator": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "3.3.9",
    "@rosegriffon/db": "1.0.3",
    "@rosegriffon/preferences": "1.0.3",
    "@rosegriffon/types": "1.0.3",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/typescript6": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@rosegriffon/db": "^1.0.3",
    "@rosegriffon/preferences": "^1.0.3",
    "@rosegriffon/types": "^1.0.3",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@rosegriffon/db": {
      "optional": true
    },
    "@rosegriffon/preferences": {
      "optional": true
    },
    "@rosegriffon/types": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
