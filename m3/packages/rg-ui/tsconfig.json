{
  "extends": "@aphrody/m3-config/tsconfig.json",
  "compilerOptions": {
    "types": ["react", "react-dom", "bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/components/*": ["./src/components/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
