{
  "name": "@aphrody/m3-codemods",
  "version": "3.3.6",
  "description": "Codemods MUI React -> @aphrody/m3-react (jscodeshift + ast-grep)",
  "type": "commonjs",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transforms/*": "./transforms/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun run scripts/run-fixtures.ts && bun test ./test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jscodeshift": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "@types/jscodeshift": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
