{
  "name": "aphrody-m3",
  "private": true,
  "description": "Aphrody M3 design monorepo: UI/design packages, tokens, icons, templates and docs.",
  "scripts": {
    "build": "bun scripts/yolo.ts build",
    "test": "bun scripts/yolo.ts test",
    "serve": "bun scripts/yolo.ts serve",
    "compile": "bun scripts/yolo.ts compile",
    "install:theme": "bun scripts/yolo.ts install:theme",
    "lint": "bun scripts/yolo.ts lint",
    "typecheck": "bun scripts/yolo.ts typecheck",
    "bench": "bun scripts/yolo.ts bench",
    "bench:check": "bun scripts/yolo.ts bench:check",
    "fmt:check": "oxfmt --check packages apps scripts",
    "icons:ico": "bun ../packages/engine/yolo/src/index.ts m3 svg-to-ico",
    "bundle-size": "bun scripts/bundle-size.ts",
    "check": "bun scripts/check-exports.ts && bun scripts/check-assets.ts && bun scripts/check-links.ts",
    "fonts:sync": "bun scripts/fonts-sync.ts",
    "native": "bun scripts/native.ts"
  }
}
