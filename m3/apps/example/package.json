{
  "name": "@aphrody/m3-example",
  "version": "1.4.4",
  "private": false,
  "description": "The m3 example app: App Router (React Server Components, server actions, streaming SSR, static generation), M3 theme, Tailwind v4 and the M3 DataTable, on Bun only.",
  "license": "Apache-2.0",
  "files": [
    "app",
    "lib",
    "m3.config.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./m3.config.ts",
    "./app/*": "./app/*",
    "./lib/*": "./lib/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "m3 dev",
    "build": "m3 build",
    "start": "m3 start",
    "compile": "m3 compile",
    "docker": "m3 docker",
    "test": "APHRODY_FFI_DEV=1 bun test",
    "typecheck": "bun check -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aphrody/m3": "workspace:*",
    "@aphrody/m3-react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-parcel": "catalog:"
  },
  "devDependencies": {
    "@aphrody/m3-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
