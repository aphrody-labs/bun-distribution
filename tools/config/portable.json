{
  "schemaVersion": 1,
  "description": "What Aphrody needs outside its checkout, gathered into the git-ignored `.portable/` so the checkout moves to a fresh WSL, the VPS or another disk. move: the tree is renamed into .portable/ and a symlink is left behind (no copy, same filesystem). copy: small or secret files duplicated (restore copies them back with their modes). dump: produced by a command. root: read/written through sudo. Categories: essential (config, credentials, binaries), data (stores, databases, sessions); `heavy` subtrees (models, archived backups) are reported apart so a small target disk can leave them behind. Driven by `bun scripts/tools/portable/portable.ts`.",
  "directory": ".portable",
  "home": [
    {
      "path": ".aphrody",
      "mode": "move",
      "category": "data",
      "heavy": ["models", "private/backups"]
    },
    {
      "path": ".codex",
      "mode": "move",
      "category": "data"
    },
    {
      "path": ".local/share/aphrody",
      "mode": "move",
      "category": "data"
    },
    {
      "path": ".local/state/aphrody",
      "mode": "move",
      "category": "data"
    },
    {
      "path": "aphrody-claude",
      "mode": "move",
      "category": "data"
    },
    {
      "path": ".bxc",
      "mode": "move",
      "category": "data"
    },
    {
      "path": ".yolo",
      "mode": "move",
      "category": "essential"
    },
    {
      "path": ".local/lib/aphrody",
      "mode": "move",
      "category": "essential"
    },
    {
      "path": ".claude",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".claude.json",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".agents",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".gemini",
      "mode": "copy",
      "category": "essential",
