      "path": ".atuin.nu",
      "mode": "copy",
      "category": "essential"
    }
  ],
  "system": [
    {
      "path": "/var/lib/postgresql",
      "mode": "copy",
      "category": "data",
      "root": true,
      "service": "postgresql"
    },
    {
      "path": "/var/lib/redis",
      "mode": "copy",
      "category": "data",
      "root": true,
      "service": "redis-server"
    },
    {
      "path": "/var/lib/docker/volumes/supabase_db-config",
      "mode": "copy",
      "category": "data",
      "root": true
    },
    {
      "path": "/etc/apt/sources.list.d",
      "mode": "copy",
      "category": "essential",
      "root": true
    },
    {
      "path": "/etc/apt/keyrings",
      "mode": "copy",
      "category": "essential",
      "root": true
    },
    {
      "path": "/usr/share/keyrings",
      "mode": "copy",
      "category": "essential",
      "root": true
    },
    {
      "path": "/etc/wsl.conf",
      "mode": "copy",
      "category": "essential",
      "root": true
    },
    {
      "path": "/etc/os-release",
      "mode": "copy",
      "category": "essential",
      "root": false
    }
  ],
  "dumps": [
    {
      "name": "supabase.sql",
      "category": "data",
      "command": ["docker", "exec", "supabase-db", "pg_dumpall", "-U", "postgres"],
      "when": ["docker", "inspect", "-f", "{{.State.Running}}", "supabase-db"]
    },
    {
      "name": "dpkg-selections.txt",
      "category": "essential",
      "command": ["dpkg", "--get-selections"]
    },
    {
      "name": "apt-manual.txt",
      "category": "essential",
      "command": ["apt-mark", "showmanual"]
    },
    {
      "name": "crontab.txt",
      "category": "essential",
      "command": ["crontab", "-l"]
    },
    {
      "name": "systemd-user-enabled.txt",
      "category": "essential",
      "command": ["systemctl", "--user", "list-unit-files", "--state=enabled", "--no-legend"]
    },
    {
      "name": "docker-images.txt",
      "category": "essential",
      "command": ["docker", "image", "ls", "--format", "{{.Repository}}:{{.Tag}}"]
    },
    {
      "name": "bun-global.txt",
      "category": "essential",
      "command": ["bun", "pm", "ls", "-g"]
    },
    {
      "name": "cargo-installed.txt",
      "category": "essential",
      "command": ["cargo", "install", "--list"]
    },
    {
      "name": "uv-tools.txt",
      "category": "essential",
      "command": ["uv", "tool", "list"]
    },
    {
      "name": "rustup-toolchains.txt",
      "category": "essential",
      "command": ["rustup", "toolchain", "list"]
    }
  ]
}
