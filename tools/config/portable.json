      "category": "essential"
    },
    {
      "path": ".atuin",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".local/bin",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".cargo/bin",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".bun/bin",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".config/aphrody",
      "mode": "copy",
      "category": "essential"
    },
    {
