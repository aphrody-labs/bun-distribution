    },
    {
      "path": ".ssh",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".gnupg",
      "mode": "copy",
      "category": "essential",
      "exclude": [
        "S.gpg-agent",
        "S.gpg-agent.browser",
        "S.gpg-agent.extra",
        "S.gpg-agent.ssh",
        "S.keyboxd"
      ]
    },
    {
      "path": ".gitconfig",
      "mode": "copy",
      "category": "essential"
    },
    {
      "path": ".bunfig.toml",
      "mode": "copy",
