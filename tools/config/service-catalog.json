{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "supervisor": "systemd",
  "proxy": "nginx",
  "services": [
    {
      "id": "aphrody-fonts-proxy",
      "application": "aphrody-google",
      "kind": "bun-edge-proxy",
      "runtime": "bun",
      "unit": "aphrody-fonts-proxy.service",
      "health": "http://127.0.0.1:8796/health",
      "port": 8796,
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody-cdn/src",
      "publicProxy": "nginx",
      "public": true,
      "host": "dbfr"
    },
    {
      "id": "aphrody-downloads",
      "application": "aphrody",
      "kind": "bun-download-server",
      "runtime": "bun",
      "unit": "aphrody-downloads.service",
      "health": "http://127.0.0.1:8797/health",
      "port": 8797,
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody-downloads/app",
      "releaseRoot": "/srv/aphrody-downloads/releases",
      "publicProxy": "nginx",
      "note": "read-only download site (index, latest.json, SHA256SUMS, install.sh, install.ps1, artifacts): public and unauthenticated by design, it serves published checksummed release files only; published by scripts/release/publish-downloads.ts from tools/config/downloads.json (docs/operations/infra/DOWNLOADS.md)",
      "public": true,
      "host": "dbfr"
    },
    {
      "id": "aphrody-creator",
      "application": "aphrody",
      "kind": "nginx-static",
      "runtime": "none",
      "sourceRepo": "aphrody",
      "releaseRoot": "/srv/aphrody-creator/releases",
      "publicProxy": "nginx",
      "note": "static download page of creator-kit (Material 3 page, latest.json, packs) served from /srv/aphrody-creator/current by the dbfr gateway container (vhost zz-creator.aphrody.com.conf, read-only bind), no application origin and no unit; public and unauthenticated by design, published by scripts/release/publish-creator.ts (docs/operations/infra/CREATOR.md)",
      "public": true,
      "container": "shenron-gateway-1",
      "host": "dbfr"
    },
    {
      "id": "aphrody-llama-gemma4",
      "application": "aphrody",
      "kind": "llama-server-openai",
      "runtime": "native",
      "unit": "aphrody-llama-gemma4.service",
      "health": "http://127.0.0.1:8798/health",
      "port": 8798,
      "capabilities": [
        "chat"
      ],
      "sourceRepo": "aphrody",
      "workingDirectory": "/home/ubuntu/.aphrody/runtimes/llama-b11415",
      "model": {
        "catalogId": "gemma-4-e2b-it-q4km",
        "alias": "gemma4-e2b",
        "ref": "hf:unsloth/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q4_K_M.gguf@0314792d7f1f7e229411f620751375812bb9faf2",
        "sha256": "740185b21d22ceb83a11c3aa62ad5842ef32c70f6096d756bbee85a1e4ec34b8"
      },
      "note": "Arrêté sur décision utilisateur (2026-10-09), unit et poids conservés sur le vps, jamais redémarré ; ai-lab et debate utilisent shenron-chat-v2 sur dbfr (127.0.0.1:8799).",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-10-09"
    },
    {
      "id": "aphrody-llama-shenron-chat",
      "application": "aphrody",
      "kind": "llama-server-openai",
      "runtime": "native",
      "host": "dbfr",
      "container": "shenron-chat-1",
      "health": "http://127.0.0.1:8799/health",
      "port": 8799,
      "capabilities": [
        "chat"
      ],
      "sourceRepo": "aphrody",
      "model": {
        "catalogId": "shenron-chat-v2-merged-q4km",
        "alias": "shenron-chat-v2",
        "ref": "local:llama-export-lora b11415 (Qwen3-4B-Instruct-2507-F16 + adapter sha256 aab485357c68fdcbb6d4ba55911632b8228964106047db035e0223e2aecc6107) -> llama-quantize Q4_K_M --imatrix unsloth",
        "sha256": "22362d5729eab45a4f2238246e6b5a448d26c01b5a541671e730415ec0d731b4"
      },
      "note": "Fine-tuned shenron-chat-v2 served on DBFR by the Compose service chat of project shenron (container shenron-chat-1, llama.cpp b11415, OpenAI-compatible /v1 on loopback only, never proxied by nginx). Single merged GGUF /srv/shenron/shared/models/shenron-chat-v2/shenron-chat-v2-merged-Q4_K_M.gguf mounted read-only; --cache-ram 256 -fa on -ctk q8_0 -ctv q8_0, ctx 8192, parallel 1, threads 4, mem_limit 5g. Rollback: adapter.gguf stays beside it; re-download the base Q4_K_M (hf:unsloth/Qwen3-4B-Instruct-2507-GGUF@a06e946b, sha256 3605803b982cb64aead44f6c1b2ae36e3acdb41d8e46c8a94c6533bc4c67e597) and serve it with --lora. The native systemd unit was removed on 2026-10-09; see docs/operations/infra/SHENRON-DOCKER.md",
      "public": false
    },
    {
      "id": "aphrody-discord-dev",
      "application": "aphrody-discord",
      "kind": "discord-interactions-and-gateway",
      "runtime": "bun",
      "unit": "aphrody-discord-dev.service",
      "health": "http://127.0.0.1:4010/healthz",
      "port": 4010,
      "sourceRepo": "aphrody-discord",
      "workingDirectory": "/srv/aphrody-discord/current",
      "releaseRoot": "/srv/aphrody-discord/releases",
      "publicProxy": "nginx",
      "public": true,
      "host": "dbfr"
    },
    {
      "id": "aphrody-site",
      "application": "aphrody",
      "kind": "rust-site",
      "runtime": "rust",
      "unit": "aphrody-site.service",
      "health": "http://127.0.0.1:80/health",
      "port": 80,
      "host": "vps",
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody/current",
      "releaseRoot": "/srv/aphrody/releases",
      "public": true,
      "publicProxy": "direct-rust",
      "staged": true,
      "note": "Owner directive 2026-10-09: native read-only Rust product site on VPS port80, scoped CAP_NET_BIND_SERVICE under systemd. Source owner crates/web/site; templates are deployed read-only. MCP/A2A/host/provider APIs remain separately protected. Activation and source/artifact receipts recorded by Infra."
    },
    {
      "id": "aphrody-web-api",
      "application": "aphrody",
      "kind": "bun-http",
      "runtime": "bun",
      "unit": "aphrody-web-api.service",
      "health": "http://127.0.0.1:3007/health",
      "sourceRepo": "aphrody-web",
      "workingDirectory": "/srv/aphrody/current",
      "publicProxy": "aphrody-site",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-ai-http",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-ai-http.service",
      "health": "http://127.0.0.1:8789/healthz",
      "port": 8789,
      "capabilities": [
        "ai-http"
      ],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "publicProxy": "nginx",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25",
      "note": "same server as aphrody-mcp-http (`aphrody-mcp http`). On the vps 127.0.0.1:8789 stays the loopback end of the WSL compute reverse tunnel (aphrody-compute-vps-tunnel), which the Shenron site and bot read: nothing else binds it"
    },
    {
      "id": "aphrody-mcp-http",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-mcp-http.service",
      "health": "http://127.0.0.1:8793/healthz",
      "port": 8793,
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody/shared/agent-workspaces/aphrody",
      "public": false,
      "host": "vps",
      "note": "Merged on 2026-10-09 into aphrody-mcp-http-dbfr (drop-in 50-migration-vps.conf: debate RAG database on local 5432, yolo/m3 tool hosts); the vps unit was removed. Runbook: docs/operations/infra/MCP-A2A.md",
      "status": "retired",
      "retiredAt": "2026-10-09"
    },
    {
      "id": "aphrody-shenron-embed",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-shenron-embed.service",
      "health": "http://127.0.0.1:8794/health",
      "port": 8794,
      "capabilities": [
        "embed"
      ],
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-09-25"
    },
    {
      "id": "aphrody-a2a",
      "application": "aphrody",
      "kind": "rust-http",
      "runtime": "rust",
      "unit": "aphrody-a2a.service",
      "health": "http://127.0.0.1:8788/ping",
      "port": 8788,
      "capabilities": [
        "a2a"
      ],
      "sourceRepo": "aphrody",
      "workingDirectory": "/srv/aphrody/shared/agent-workspaces/aphrody",
      "a2a": {
        "registry": "tools/config/a2a-peers.json",
        "peer": "aphrody",
        "rpcPath": "/",
        "agentCardPath": "/.well-known/agent-card.json"
      },
      "public": false,
      "note": "Persistent native A2A service on loopback 8788, authenticated private routes (APHRODY_A2A_COORD_TOKEN), dedicated main checkout and existing Codex authentication. Protocol tasks/results remain in /srv/aphrody/shared/coord/a2a/tasks across client disconnects and service reconstruction; interrupted coding tasks are not replayed on restart. Canonical MCP child is available. Runbook: docs/operations/infra/MCP-A2A.md. Runs on dbfr since 2026-10-09 (workspace and Codex standalone copied from the vps); wg1 projection 10.200.77.3:8788 via aphrody-wg-proxy@8788.socket.",
      "host": "dbfr"
    },
    {
      "id": "shenron-site",
      "application": "shenron",
      "kind": "next-bun-http",
      "runtime": "bun",
      "unit": "shenron-site.service",
      "host": "dbfr",
      "container": "shenron-site-1",
      "health": "http://127.0.0.1:5011/api/health",
      "readiness": "http://127.0.0.1:5011/api/health/ready",
      "port": 5011,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current/apps/site",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "Next.js site: /api/health (liveness), /api/health/live (alias) and /api/health/ready (readiness)",
      "public": true
    },
    {
      "id": "shenron-mcp",
      "application": "aphrody",
      "kind": "bun-mcp-http",
      "runtime": "bun",
      "unit": "shenron-mcp.service",
      "health": "http://127.0.0.1:5010/health",
      "sourceRepo": "aphrody-ai",
      "workingDirectory": "/srv/aphrody/current",
      "releaseRoot": "/srv/aphrody/releases",
      "publicProxy": "nginx",
      "a2a": {
        "registry": "tools/config/a2a-peers.json",
        "peer": "shenron",
        "rpcPath": "/a2a",
        "agentCardPath": "/.well-known/agent-card.json"
      },
      "public": true,
      "status": "retired",
      "retiredAt": "2026-09-25",
      "supersededBy": "shenron-mcp dragonball.* tools in aphrody-labs/shenron (crates/shenron-mcp, served by the Shenron plugin; aphrody-ai d0cb59d deleted apps/shenron-mcp, its systemd unit and mcp.dragonballfr.com vhost template)"
    },
    {
      "id": "shenron-bot",
      "application": "shenron",
      "kind": "discord-bot-and-api",
      "runtime": "bun",
      "unit": "shenron-bot.service",
      "host": "dbfr",
      "container": "shenron-bot-1",
      "health": "http://127.0.0.1:5006/health",
      "port": 5006,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current/apps/bot",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "single Bun process (discordx + Bun.serve REST/GraphQL/OpenAPI); no separate shenron-api.service, see docs/reference/infra/SHENRON-MIGRATION.md",
      "public": true
    },
    {
      "id": "shenron-mcp-http",
      "application": "shenron",
      "kind": "rust-mcp-http",
      "runtime": "native",
      "unit": "shenron-mcp-http.service",
      "health": "http://127.0.0.1:8790/health",
      "port": 8790,
      "sourceRepo": "shenron",
      "workingDirectory": "/srv/shenron/current",
      "releaseRoot": "/srv/shenron/releases",
      "sharedRoot": "/srv/shenron/shared",
      "deployAdapter": "scripts/release/atomic-deploy-shenron.sh",
      "note": "Retired on 2026-10-09: on DBFR shenron-mcp runs inside the site container on 127.0.0.1:3599 and the site relays /mcp to it. The former native unit on 8790 and its SSH forward are gone",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-10-09"
    },
    {
      "id": "shenron-pg-tunnel",
      "application": "shenron",
      "kind": "ssh-tunnel",
      "runtime": "native",
      "unit": "shenron-pg-tunnel.service",
      "host": "vps",
      "health": "tcp://127.0.0.1:15433",
      "target": "dbfr:127.0.0.1:5432",
      "note": "Removed on 2026-10-09: its only consumer (vps aphrody-mcp-http, debate RAG) now runs on dbfr against 127.0.0.1:5432.",
      "public": false,
      "status": "retired",
      "retiredAt": "2026-10-09"
    },
    {
      "id": "shenron-redis",
      "application": "shenron",
