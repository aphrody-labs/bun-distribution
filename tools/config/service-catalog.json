      },
      {
        "host": "dbfr",
        "kind": "systemd",
        "unit": "shenron-bot-docker.service"
      },
      {
        "host": "dbfr",
        "kind": "systemd",
        "unit": "shenron-site-docker.service"
      },
      {
        "host": "dbfr",
        "kind": "systemd",
        "unit": "shenron-compute.service"
      },
      {
        "host": "dbfr",
        "kind": "systemd",
        "unit": "shenron-embed.service"
      },
      {
        "host": "dbfr",
        "kind": "systemd",
        "unit": "shenron-timeline-api.service"
      },
      {
        "host": "dbfr",
        "kind": "systemd",
        "unit": "shenron-timeline-refresh.timer"
