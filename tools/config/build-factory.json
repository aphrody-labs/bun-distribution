{
  "schemaVersion": 1,
  "owner": "aphrody-infra",
  "enabled": true,
  "target": "vps",
  "windowsFactory": {
    "host": "omar-pc",
    "target": "windows-x64",
    "enabled": true,
    "nativeArchitectures": ["x64"],
    "crossArchitectures": ["arm64"],
    "maxJobs": 1,
    "reserveMemoryGiB": 6,
    "reserveDiskGiB": 20,
    "scope": ["windows-native-builds", "windows-packaging", "windows-smoke-tests"],
    "execution": "local-windows"
  },
  "executionOnlyTargets": [],
  "workspaceRoot": "/home/ubuntu/src/aphrody",
  "cacheRoot": "/home/ubuntu/build/cache",
  "artifactRoot": "/home/ubuntu/build/artifacts",
  "lockPath": "/home/ubuntu/build/locks/heavy.lock",
  "hostEnvironment": {
    "name": "APHRODY_BUILD_HOST",
    "value": "vps"
  },
  "rust": {
    "maxJobs": 6,
    "serialized": true,
    "wrapper": "scripts/build/rust/cargo-serial.sh",
    "incremental": false,
    "cache": "sccache"
  },
  "bun": {
    "heavyJobs": 1,
    "frozenLockfile": true
  },
  "local": {
    "allowed": ["help", "plan", "inventory", "source-edit", "scoped-static-check"],
    "heavyExecution": "remote"
  },
  "transport": {
    "owner": "aphrody-infra ssh",
    "sync": "sync",
    "exec": "exec",
    "sourcePolicy": "clean-pinned-first-party-source",
    "secrets": "host-local-private-files-only"
  },
  "runtimeTargets": {
    "shenron": "dbfr",
    "rg": "stopped"
  },
  "retention": {
    "preserve": [
      "active-releases",
      "rollback-releases",
      "primary-data",
      "source-patches",
      "cargo-cache",
      "sccache",
      "bun-cache"
    ],
    "cleanup": "existing-infra-allowlist-only"
  },
  "repositories": {
    "bun-os": "/home/ubuntu/builds/bun-os-factory/sources/bun",
    "aphrody": "/home/ubuntu/src/aphrody",
    "yolo": "/home/ubuntu/src/yolo",
    "iecode": "/home/ubuntu/src/iecode"
  },
  "next": {
    "image": "node:22-bookworm-slim",
    "pull": "never",
    "cpus": 6,
    "memoryMiB": 16384,
    "maxOldSpaceSizeMiB": 8192
  },
  "cleanup": {
    "transientRoot": "/home/ubuntu/build/transient",
    "privilegeBinary": "/usr/bin/sudo-rs",
    "retiredOutputs": [
      {
        "path": "/home/ubuntu/build/cache/cargo/obscura-fork",
        "terminalReceipt": "/home/ubuntu/build/artifacts/wsl/obscura-fork-check.log.exit",
        "reason": "Terminal native fork-check target; no live job or mounted container may use it"
      },
      {
        "path": "/home/ubuntu/build/cache/cargo/vu-uv",
        "terminalReceipt": "/home/ubuntu/build/wsl/vu/receipts/7c3db189-2026-10-05T21-13-26-131Z.json",
        "reason": "Terminal qualified vu build intermediates; runtime artifacts and source receipts retained"
      },
      {
        "path": "/home/ubuntu/build/cache/cargo/vu-ruff",
        "terminalReceipt": "/home/ubuntu/build/wsl/vu/receipts/7c3db189-2026-10-05T21-13-26-131Z.json",
        "reason": "Terminal qualified vu build intermediates; runtime artifacts and source receipts retained"
      },
      {
        "path": "/home/ubuntu/build/cache/cargo/vu-wsl",
        "terminalReceipt": "/home/ubuntu/build/wsl/vu/receipts/7c3db189-2026-10-05T21-13-26-131Z.json",
        "reason": "Terminal qualified vu build intermediates; runtime artifacts and source receipts retained"
      },
      {
        "path": "/home/ubuntu/build/cache/cargo/aphrody",
        "terminalReceipt": "/home/ubuntu/build/artifacts/factory-jobs/downloads-aphrody-windows-x86_64-5bf7eed5a/exit.json",
        "reason": "Terminal 2026-10-06 Aphrody Linux/Windows packaging intermediates; deployed/rollback binaries, artifact receipts, source and shared caches retained"
      }
    ]
  }
}
