[Unit]
Description=Sauvegarde Postgres quotidienne (03h15, après la fenêtre de trafic creux)

[Timer]
# 03h15 : après la rotation des journaux (00h50) et avant la synchronisation du miroir
# azalée (04h09), pour que les trois ne se disputent pas le disque.
OnCalendar=*-*-* 03:15:00
# Une machine éteinte à 03h15 ne doit pas sauter un jour de sauvegarde.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
