# SPDX-License-Identifier: Apache-2.0
# VPS direct Rust HTTP port 80, owner directive 2026-10-09.
[Unit]
Description=Aphrody native read-only product site
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aphrody-site
Group=aphrody-site
WorkingDirectory=/home/ubuntu/apps/aphrody/current
ExecStart=/home/ubuntu/apps/aphrody/current/bin/aphrody-site --root /home/ubuntu/apps/aphrody/current --bind 0.0.0.0:80
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/apps/aphrody
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
