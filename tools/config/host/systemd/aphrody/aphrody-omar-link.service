# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Post Omar wg1 / reverse SSH tunnel transitions to the Aphrody admin channel
After=network-online.target wg-quick@wg1.service
Wants=network-online.target

[Service]
Type=oneshot
# root: `wg show` needs CAP_NET_ADMIN and the bot credential file is root-only.
WorkingDirectory=/srv/aphrody-admin
ExecStart=/usr/bin/python3 /srv/aphrody-admin/scripts/tools/omar-link-watch.py
StateDirectory=aphrody-omar-link
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
