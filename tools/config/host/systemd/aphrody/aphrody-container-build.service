# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Aphrody build service (compose profile build, aphrody-build image) on the VPS factory
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/etc/aphrody/container
Environment=APHRODY_BUILD_REPO=/srv/aphrody-build/workspaces/aphrody
ExecStart=/usr/bin/docker compose -f /etc/aphrody/container/compose.yaml --profile build up --no-build --remove-orphans
ExecStop=/usr/bin/docker compose -f /etc/aphrody/container/compose.yaml --profile build down
Restart=always
RestartSec=15
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
