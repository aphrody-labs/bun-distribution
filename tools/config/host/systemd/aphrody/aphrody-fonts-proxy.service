# SPDX-License-Identifier: Apache-2.0
# Google Fonts edge proxy behind nginx on cdn.aphrody.com (nginx/aphrody/cdn.aphrody.com.conf).
# Bun source of @aphrody/google pinned in /srv/aphrody-cdn/src (packages/google/google/src and packages/engine/core/src/server
# only, no dependency to install), a `git archive` of the revision in /srv/aphrody-cdn/src/REVISION. Upgrade with:
#   git -C /srv/aphrody-build/workspaces/aphrody archive <sha> packages/google/google/src packages/engine/core/src/server | tar -x -C /srv/aphrody-cdn/src
# The cache lives in /srv/aphrody-cdn/google.
[Unit]
Description=Aphrody Google Fonts edge proxy (cdn.aphrody.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/aphrody-cdn/src
ExecStart=/home/ubuntu/.local/bin/bun /srv/aphrody-cdn/src/packages/google/google/src/fonts-serve.ts --port 8796 --cache /srv/aphrody-cdn/google --origin https://cdn.aphrody.com
Restart=always
MemoryHigh=128M
MemoryMax=256M
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/srv/aphrody-cdn/google
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aphrody-fonts-proxy

[Install]
WantedBy=multi-user.target
