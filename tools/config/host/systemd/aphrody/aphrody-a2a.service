# SPDX-License-Identifier: Apache-2.0
# Aphrody A2A 1.0 server (`aphrody a2a serve`): agent card, /ping, /msg, JSON-RPC, HTTP+JSON and SSE over the coord
# mailbox. Catalog entry `aphrody-a2a` (tools/config/service-catalog.json), vps.
# Loopback only: 127.0.0.1:8788, never proxied by nginx, never published (the former public routes of aphrody.com stay
# retired). The agent card announces http://127.0.0.1:8788.
# The dedicated private checkout is independent of the factory and interactive clients.
# State: --coord-dir /home/ubuntu/apps/aphrody/shared/coord (mailboxes and a2a/tasks), retained across restarts.
# The owner requested persistent autonomous coding agents on 2026-10-07. The required
# root-owned environment authenticates every private route. Existing Codex authentication
# remains in its protected home; no provider credentials are copied into the checkout.
[Unit]
Description=Aphrody A2A server (aphrody a2a serve, 127.0.0.1:8788, loopback only)
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/apps/aphrody/shared/agent-workspaces/aphrody
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=CODEX_BIN=/home/ubuntu/.codex/packages/standalone/current/bin/codex
Environment=APHRODY_A2A_DEFAULT_PEER=codex
Environment="APHRODY_YOLO_TOOL_HOST=/home/ubuntu/.bun/bin/bun /home/ubuntu/apps/lab/yolo-tool-host.mjs"
Environment="APHRODY_M3_TOOL_HOST=/home/ubuntu/.bun/bin/bun /home/ubuntu/apps/lab/m3-tool-host.mjs"
UnsetEnvironment=APHRODY_A2A_DRY_RUN A2A_SOCKET
Environment=RUST_LOG=aphrody_a2a_coord=info
EnvironmentFile=/etc/aphrody/aphrody-a2a.env
ExecStart=/home/ubuntu/.local/bin/aphrody a2a serve --bind 127.0.0.1:8788 --coord-dir /home/ubuntu/apps/aphrody/shared/coord
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

MemoryAccounting=true
MemoryHigh=2G
MemoryMax=4G
TasksMax=256
LimitNOFILE=16384
CPUWeight=50
Nice=5

# Sandbox, on top of the run-as-ubuntu, sandbox-base, sandbox-kernel, net-inet-only and syscall-service drop-ins.
# Map only the native binary, existing Codex home and selected Aphrody state.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/ubuntu/.local/bin/aphrody /home/ubuntu/.local/bin/aphrody-mcp /home/ubuntu/.ssh /home/ubuntu/.bun/bin/bun
BindPaths=/home/ubuntu/.codex /home/ubuntu/.aphrody
ReadWritePaths=/home/ubuntu/apps/aphrody/shared/agent-workspaces/aphrody /home/ubuntu/apps/aphrody/shared/coord /home/ubuntu/.codex /home/ubuntu/.aphrody
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/var/lib/lxd -/run/user
ProtectProc=invisible
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# The canonical MCP child uses V8's protection-key syscalls for browser tools.
SystemCallFilter=@pkey
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aphrody-a2a

[Install]
WantedBy=multi-user.target
