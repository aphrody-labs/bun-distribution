# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Watch Omar's PC reachability (wg1 handshake, reverse tunnel) and report changes to Discord
After=network-online.target wg-quick@wg1.service
Wants=network-online.target

[Service]
Type=oneshot
# Root for `wg show`; writes only its state directory.
ExecStart=/usr/local/libexec/aphrody-omar-watch
StateDirectory=aphrody-omar-watch
StateDirectoryMode=0700
TimeoutStartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
