# SPDX-License-Identifier: Apache-2.0
# Synchronisation propriétaire <-> Omar via Discord (hub vps) : un passage = message d'état épinglé édité en place,
# événements, rapports reçus, accusés ✅, dépôt sortant. Code : scripts/tools/infra/discord-sync/ (déployé dans
# ~/apps/discord-sync). Jetons : /etc/aphrody-discord.env (lu par systemd, jamais affiché). Remplace
# aphrody-omar-watch. Timer : aphrody-discord-sync.timer (chaque minute). Documentation : docs/operations/infra/DISCORD-SYNC.md
[Unit]
Description=Aphrody <-> Omar synchronisation through Discord (one pass)
After=network-online.target wg-quick@wg1.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
EnvironmentFile=/etc/aphrody-discord.env
Environment=APHRODY_SYNC_CONFIG=/home/ubuntu/apps/discord-sync/discord-sync.json
StateDirectory=aphrody-discord-sync
StateDirectoryMode=0700
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/apps/discord-sync/scripts/tools/infra/discord-sync/cli.ts tick
TimeoutStartSec=55
SyslogIdentifier=aphrody-discord-sync
# `wg show` (sans clé privée) exige CAP_NET_ADMIN ; rien d'autre.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
Nice=10
