# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Aphrody source-grounded Shenron Discord debates
After=network-online.target aphrody-llama-gemma4.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/aphrody-lab/state/debate
ExecStart=/home/ubuntu/.bun/bin/bun /srv/aphrody-lab/debate.mjs --policy /srv/aphrody-lab/debate-policy.json --env-file /etc/aphrody-discord.env --state /srv/aphrody-lab/state/debate/state.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/aphrody-lab/state/debate
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
