# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron local multilingual E5 embeddings on DBFR
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/home/ubuntu/.local/bin/aphrody-embed serve --host 127.0.0.1 --port 8085 --threads 4 --model-dir /home/ubuntu/apps/shenron/shared/models/intfloat--multilingual-e5-small
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=1G
MemoryMax=2G
CPUWeight=50

[Install]
WantedBy=multi-user.target
