# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Verified backups of Shenron container-owned PostgreSQL, Redis and SQLite
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/aphrody-infra/backup-shenron-container.py
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
# Each verified snapshot is about 1 GiB; keep the two newest.
ExecStartPost=/bin/sh -c 'ls -1d /home/ubuntu/apps/shenron/shared/backups/container/2*/ | sort -r | tail -n +2 | xargs -r rm -rf --'
StandardOutput=journal
StandardError=journal
