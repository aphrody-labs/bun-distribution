# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Sealed acquired manga handoff to publication owner
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/candidate-template.json

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock --nonblock --no-fork --conflict-exit-code 75 /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/handoff-export/transfer.flock /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/handoff-runtime/manga-pool-handoff export /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-pool/handoff-config.json
SuccessExitStatus=75
TimeoutStartSec=15min
UMask=0077
Nice=10
CPUQuota=50%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=journal
StandardError=journal
