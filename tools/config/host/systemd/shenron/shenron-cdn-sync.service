# shenron-cdn-sync — mirrors the public Shenron media of the vps itself into /home/ubuntu/apps/shenron-cdn-src, then
# publishes the served CDN root /home/ubuntu/apps/shenron-cdn with scripts/release/cdn-optimize.ts:
# lossless, verified recompression (jpegtran, oxipng/zopflipng, gifsicle, cwebp lossless,
# ffmpeg faststart), brotli/gzip siblings for text and hardlinked duplicates. The mirror is
# never modified, so rsync's size/mtime checks stay exact; the optimizer manifest
# (/home/ubuntu/apps/shenron-cdn-state/manifest.sqlite) keeps hourly runs incremental.
#
# Since 2026-10-06 the media live on the vps (/home/ubuntu/apps/shenron/shared: site/wiki 20 GiB, bot/assets
# 11 GiB, site/public-extra); dbfr no longer holds these media, so the former WireGuard pull
# (key shenron_cdn_pull, rrsync -ro on dbfr) is retired: every rsync is local.
#
# Scope: wiki media, bot assets and generated public files only. Never databases
# (shared/bot/data), caches, logs or secrets. Deletions in the source are mirrored, at most 2000
# per tree and run, so an emptied or unmounted source cannot wipe the CDN; the optimizer refuses
# an empty mirror and caps its own deletions the same way.
# The public/ of the active release (/home/ubuntu/apps/shenron/current/apps/site/public, which holds
# /.well-known/agent-card.json) is seeded into the mirror on every run, additive (no delete), so a
# release republishes its static files within the hour; a deploy may start this unit right away.
#
# Install (vps), from the Aphrody checkout:
#   sudo install -d -o ubuntu -g ubuntu -m 755 /home/ubuntu/apps/shenron-cdn /home/ubuntu/apps/shenron-cdn-src /home/ubuntu/apps/shenron-cdn-state
#   tools: tools/config/host/toolchain.json hostTools.vps (apt + cargo-binstall oxipng)
#   bun build --compile --target=bun-linux-x64 scripts/release/cdn-optimize.ts --outfile ~/.local/bin/aphrody-cdn-optimize
#   bun packages/engine/core/src/host/cli.ts compose-unit shenron-cdn-sync.service | sudo tee /etc/systemd/system/shenron-cdn-sync.service >/dev/null
#   bun packages/engine/core/src/host/cli.ts compose-unit shenron-cdn-sync.timer | sudo tee /etc/systemd/system/shenron-cdn-sync.timer >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now shenron-cdn-sync.timer
# Rollback: disable the timer; both trees only hold copies (the served one can be rebuilt with
# `cp -al /home/ubuntu/apps/shenron-cdn-src/. /home/ubuntu/apps/shenron-cdn/`).
[Unit]
Description=Shenron CDN: mirror the public media of the vps, publish the optimized tree

[Service]
Type=oneshot
Environment=PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --delete-after --max-delete=2000 --delay-updates --partial-dir=.rsync-partial --info=stats1 /home/ubuntu/apps/shenron/shared/site/wiki/ /home/ubuntu/apps/shenron-cdn-src/wiki/
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --delete-after --max-delete=2000 --delay-updates --partial-dir=.rsync-partial --info=stats1 /home/ubuntu/apps/shenron/shared/bot/assets/ /home/ubuntu/apps/shenron-cdn-src/assets/
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --delete-after --max-delete=2000 --delay-updates --partial-dir=.rsync-partial --info=stats1 /home/ubuntu/apps/shenron/shared/site/public-extra/ /home/ubuntu/apps/shenron-cdn-src/site-extra/
ExecStart=/usr/bin/rsync -rlt --safe-links --chmod=D755,F644 --info=stats1 /home/ubuntu/apps/shenron/current/apps/site/public/ /home/ubuntu/apps/shenron-cdn-src/site/
ExecStart=/home/ubuntu/.local/bin/aphrody-cdn-optimize --src /home/ubuntu/apps/shenron-cdn-src --out /home/ubuntu/apps/shenron-cdn --state /home/ubuntu/apps/shenron-cdn-state/manifest.sqlite --report /home/ubuntu/apps/shenron-cdn-state/last-report.json --max-delete 2000
# The first optimization recompresses ~31 GiB; later runs only touch changed files.
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=idle
ReadWritePaths=/home/ubuntu/apps/shenron-cdn /home/ubuntu/apps/shenron-cdn-src /home/ubuntu/apps/shenron-cdn-state
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-cdn-sync
