# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Renew scoped Shenron R2 S3 credential
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
Group=root
UMask=0077
LoadCredential=api-token:/etc/aphrody/cloudflare/api-token
Environment=CLOUDFLARE_API_TOKEN_FILE=/run/credentials/shenron-cloudflare-s3-renew.service/api-token
ExecStart=/home/ubuntu/.local/share/aphrody/cloudflare-cli/runtime/bun /etc/aphrody/cloudflare/cli/s3-profile.ts renew --manifest /home/ubuntu/.config/aphrody/cloudflare/manifest.json --profile /etc/aphrody/cloudflare/shenron-s3.json --apply
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/aphrody/cloudflare
