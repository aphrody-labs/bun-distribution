# Code from the single checkout ~/src/aphrody, dumps under the app data tree ~/apps/shenron/data.
[Unit]
Description=Daily logical backup of Shenron PostgreSQL data on DBFR
After=postgresql@18-main.service
Wants=postgresql@18-main.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/apps/shenron/current
Environment=SHENRON_ROOT=/home/ubuntu/apps/shenron/current
Environment=SHENRON_PG_BACKUP_DIR=/home/ubuntu/apps/shenron/data/backups/shenron-pg
Environment=SHENRON_PG_BACKUP_RETENTION_DAYS=14
ExecStartPre=+/bin/mkdir -p /home/ubuntu/apps/shenron/data/backups/shenron-pg
ExecStart=/bin/bash /home/ubuntu/src/aphrody/scripts/tools/infra/backup-shenron-pg.sh

Nice=10
IOSchedulingClass=idle
ReadWritePaths=/home/ubuntu/apps/shenron/data/backups/shenron-pg

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shenron-pg-backup
