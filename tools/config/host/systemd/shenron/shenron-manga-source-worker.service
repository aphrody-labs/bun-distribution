# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron persistent recursive manga source collection on the factory
Wants=network-online.target
After=network-online.target aphrody-mullvad-netns.service
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-worker
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock --nonblock --no-fork --conflict-exit-code 75 /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-worker/worker.flock /home/ubuntu/.local/bin/bun /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-worker/bin/worker.ts --config /home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-worker/worker.config.json --apply --locked
NetworkNamespacePath=/run/netns/mullvad
BindReadOnlyPaths=/etc/netns/mullvad/resolv.conf:/etc/resolv.conf
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=75
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.aphrody/profiles/dbfr/jobs/manga-source-worker
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
CPUWeight=10
CPUQuota=20%
IOWeight=10
Nice=15
TasksMax=128
LimitNOFILE=4096
UMask=0077

[Install]
WantedBy=multi-user.target
