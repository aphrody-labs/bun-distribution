# Retired 2026-09-25: nie-site was removed from vps (tools/config/service-catalog.json status:retired; docs/PLAN.md). Kept as a redeploy template for the Aphrody convergence plan (superproject docs/architecture/APHRODY-CONVERGENCE.md).
# nie-site — nie backend on 127.0.0.1:8085 (API /api/v1, raw VFS /f and /b, /healthz),
# published only through `nie.aphrody.com` (nginx/nie/aphrody-nie-cdn.conf).
#
# Ownership: this unit lives in yolo tools/config/host (moved from nie `deploy/systemd/` on
# 2026-09-23). nie owns the binary (`crates/tools/nie-site`), its build and verification;
# aphrody-infra owns the unit, the vhost, activation, backups and host ops. nie's
# `scripts/deploy-target.ts` and `scripts/release-all.ts` install/compare this file from
# `${YOLO_ROOT:-~/yolo}/tools/config/host/systemd/nie/`.
#
# Paths: nie has no immutable release plane yet, so the unit still runs the checkout's
# `target/release/nie-site` under NIE_REPO_ROOT. Override NIE_REPO_ROOT / NIE_GAME_DIR in
# `/etc/nie/nie.env` (non-secret; NIE_RAW_VFS_TOKEN, when set, is the only secret there).
#
# Install (production act, follow the aphrody-infra deploy runbook):
#   bun $YOLO_ROOT/packages/core/src/host/cli.ts compose-unit nie-site.service | sudo tee /etc/systemd/system/nie-site.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now nie-site
#   curl -s http://127.0.0.1:8085/healthz | jq .etat        # "ok"
#
# Rollback: restore the previous unit from git and `daemon-reload`; for routing, revert
# `nginx/nie/aphrody-nie-cdn.conf`, then `nginx -t` and reload. Never repoint to :8083
# (aphrody-site), which serves no nie route. Port map: tools/config/service-catalog.json.

[Unit]
Description=nie-site — nie (bundle nie-web, /api/v1, espaces VFS /f et /b, proxy nie-model-serve)
Documentation=https://nie.aphrody.com/docs/stack/web-platform
After=network.target
# Le proxy /assets dégrade proprement quand l'amont est absent (502/504) : la dépendance est
# souhaitée, pas requise — nie-site doit pouvoir démarrer et répondre /healthz sans lui.
Wants=nie-model-serve.service
After=nie-model-serve.service

[Service]
Type=simple
WorkingDirectory=/
ExecStart=/bin/sh -c 'exec "$NIE_REPO_ROOT/target/release/nie-site" \
    --listen 127.0.0.1:8085 \
    --db ${NIE_REPO_ROOT}/var/mirror.sqlite \
    --upstream http://127.0.0.1:8792 \
    --bundle-dir ${NIE_REPO_ROOT}/apps/nie-web/dist \
    --origin https://nie.aphrody.com'

# Le VFS se monte en tâche de fond : le processus écoute et répond /healthz immédiatement,
# et /f + /b passent de 503 à 200 quand l'index des ~255 000 entrées est construit.
#
# ── LE JEU, PAS LE DÉPÔT (corrigé 2026-09-19) ──────────────────────────────
# Cette ligne a désigné `/home/ubuntu/nie` depuis la création de l'unité. Le
# dépôt ne contient AUCUN CPK — `data/` est gitignore par obligation légale —
# et le VFS s'y rabattait sur un dump : `/healthz` annonçait alors
# `vfs_entrees: 156873` et `vfs_cpks: 0`, contre les ~255 000 que le
# commentaire ci-dessus décrit déjà comme la cible.
#
# L'effet mesuré était un ÉCRAN NOIR sur tout le site, jamais une erreur : les
# `.objbin` des calques de menu ne vivent que dans les CPK, donc
# `/api/v1/menu/layout/<ecran>` répondait 200 avec 100 % de ses calques
# manquants. `chara_edit_menu` 13 déclarés / 13 manquants / 0 sprite,
# `chara_bank_menu` 34 / 34 / 0, `main_menu` 13 / 13 / 0. La même instance
# lancée sur l'install Steam donne 13 / 0 / 13, 34 / 9 / 25 et 13 / 1 / 12.
# Un layout qui n'a rien à dessiner rend une page vide, pas un 500 — d'où des
# mois possibles sans que rien ne soit en échec.
#
# Même racine que `--game-dir` de `nie-model-serve`, qui lui l'a toujours eue.
# Override NIE_REPO_ROOT in /etc/nie/nie.env on hosts that use another checkout.
Environment=NIE_REPO_ROOT=/home/ubuntu/nie
Environment=NIE_GAME_DIR=/home/ubuntu/.local/share/Steam/iecode/inazuma
EnvironmentFile=-/etc/nie/nie.env
Environment=RUST_LOG=info
# nie-formats CPK cache budget (crate default 16 GiB). 6 GiB here and 4 GiB in
# nie-model-serve.service: 10 GiB of CPK cache on the host. Both values are the ones the
# running processes carry (measured 2026-09-25 in /proc/<pid>/environ; /etc/nie/nie.env does
# not override them). The budget stays under MemoryHigh=8G with room for the rest of the
# process; nie-site only reads files and assembles nothing.
Environment=NIE_CPK_CACHE_BUDGET_GIB=6

Restart=always
RestartSec=5s
# La vitrine et ses espaces VFS restent prioritaires face aux décodages et tâches
# IA/batch en cas de contention. Poids relatifs, sans quota ni réservation rigide.
CPUWeight=1000
IOWeight=1000
# Plafond mémoire : au-delà, systemd tue le service plutôt que de laisser earlyoom choisir
# une victime au hasard sur une machine qui porte 18 autres services.
MemoryMax=10G
MemoryHigh=8G
LimitNOFILE=16384

# Durcissement : le service ne fait que LIRE des fichiers et parler à 127.0.0.1.
PrivateDevices=true
ProtectHome=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
# Aucun chemin en écriture : nie-site n'écrit rien sur disque (le cache est en mémoire).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
