{
  "upstreams": [],
  "servers": [
    {
      "server_names": [],
      "listen_ports": [
        "127.0.0.1:80",
        "10.200.77.10:80"
      ],
      "custom_directives": [
        "allow 127.0.0.1",
        "allow 10.200.77.1",
        "allow 10.200.77.4",
        "deny all",
        "client_max_body_size 32m"
      ],
      "locations": [
        {
          "path": "/",
          "proxy_pass": "http://127.0.0.1:8090",
          "proxy_http_version": "1.1",
          "headers": [
            [
              "Host",
              "$host"
            ],
            [
              "X-Forwarded-Proto",
              "$scheme"
            ],
            [
              "Upgrade",
              "$http_upgrade"
            ],
            [
              "Connection",
              "$connection_upgrade"
            ]
          ],
          "custom_directives": [
            "proxy_read_timeout 3600s"
          ]
        },
        {
          "path": "/llama/",
          "proxy_pass": "http://127.0.0.1:8081/",
          "proxy_http_version": "1.1",
          "custom_directives": [
            "proxy_buffering off",
            "proxy_read_timeout 600s"
          ]
        },
        {
          "path": "/desktop/",
          "custom_directives": [
            "return 302 http://10.200.77.10:8795/"
          ]
        },
        {
          "proxy_http_version": "1.1",
          "headers": [
            [
              "Authorization",
              "$http_authorization"
            ],
            [
              "Host",
              "$host"
            ]
          ],
          "proxy_pass": "http://127.0.0.1:8081/v1/",
          "custom_directives": [
            "proxy_buffering off",
            "proxy_read_timeout 600s"
          ],
          "path": "/v1/"
        },
        {
          "proxy_http_version": "1.1",
          "headers": [
            [
              "Authorization",
              "$http_authorization"
            ],
            [
              "Host",
              "$host"
            ],
            [
              "Upgrade",
              "$http_upgrade"
            ],
            [
              "Connection",
              "$connection_upgrade"
            ]
          ],
          "proxy_pass": "http://127.0.0.1:8793",
          "custom_directives": [
            "proxy_buffering off",
            "proxy_read_timeout 3600s"
          ],
          "path": "/mcp/"
        },
        {
          "proxy_http_version": "1.1",
          "headers": [
            [
              "Authorization",
              "$http_authorization"
            ],
            [
              "Host",
              "$host"
            ],
            [
              "Upgrade",
              "$http_upgrade"
            ],
            [
              "Connection",
              "$connection_upgrade"
            ]
          ],
          "proxy_pass": "http://127.0.0.1:8788/",
          "custom_directives": [
            "proxy_buffering off",
            "proxy_read_timeout 3600s"
          ],
          "path": "/a2a/"
        },
        {
          "proxy_http_version": "1.1",
          "headers": [
            [
              "Host",
              "$http_host"
            ],
            [
              "Upgrade",
              "$http_upgrade"
            ],
            [
              "Connection",
              "$connection_upgrade"
            ]
          ],
          "proxy_pass": "http://127.0.0.1:8796/events",
          "custom_directives": [
            "proxy_buffering off",
            "proxy_read_timeout 3600s"
          ],
          "path": "/system-stream/"
        },
        {
          "headers": [
            [
              "Host",
              "$http_host"
            ]
          ],
          "proxy_pass": "http://127.0.0.1:8796/snapshot",
          "custom_directives": [
            "proxy_buffering off",
            "add_header Cache-Control no-store"
          ],
          "path": "/system-snapshot/"
        }
      ]
    }
  ]
}
