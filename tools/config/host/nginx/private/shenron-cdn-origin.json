{
  "schemaVersion": 1,
  "host": "vps",
  "service": "nginx",
  "serverName": "shenron-cdn-origin.internal",
  "address": "10.200.77.1:80",
  "allowedClients": ["10.200.77.3", "127.0.0.1"],
  "source": "tools/config/host/nginx/private/shenron-cdn-origin.conf",
  "destination": "/etc/nginx/conf.d/shenron-cdn-origin.conf",
  "publicRoot": "/home/ubuntu/apps/shenron-cdn",
  "protectedStores": false,
  "methods": ["GET", "HEAD"],
  "publicPrefixes": ["/assets/manga/", "/assets/ext/", "/assets/dragonballcn/", "/wiki/databooks/", "/banners/", "/_next/static/"],
  "consumer": "dbfr gateway fallback after local public disk and R2 Worker",
  "activation": "nginx -t then systemctl reload nginx"
}
