# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Private native Infra forwards to the DBFR sync backends
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aphro/aphrody
Environment=PATH=/home/aphro/.local/bin:/home/aphro/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/aphro/.local/bin/aphrody infra ssh tunnel --catalog /home/aphro/aphrody/tools/config/host/agent-sync-tunnels.json --services shenron-compute,shenron-embed --offset 10000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
