{
  "$comment": "SSH build context defaults. Override with --config or VPS_CARGO_CONFIG and --host or VPS_CARGO_HOST. Local checkout paths resolve from this worktree. Primary factory is vps. Owner directive 2026-10-09 (\"exploite nos deux VPS pour build et prod\") restores dbfr as a bounded secondary host (production: Postgres, Redis, nginx, Shenron containers): `--host dbfr`, or `--host auto` when the vps heavy lock is busy; 3 jobs at most, nice 10, sccache 8G, no desktop libraries. Existing remote -wsl names are retained store/cache identifiers; no protected data is moved.",
  "schemaVersion": 1,
  "host": "vps",
  "controlPath": "~/.ssh/cm/vps-cargo",
  "localSession": "vps-tunnel",
  "remoteSession": "vps-cargo",
  "remoteWorkspace": "/srv/aphrody-build/workspaces/aphrody-wsl",
  "remoteSeed": "/srv/aphrody-build/workspaces/aphrody",
  "remoteTargetDir": "/srv/aphrody-build/cache/cargo/aphrody-wsl",
  "remoteLockDir": "/srv/aphrody-build/locks",
  "remoteHeavyLock": "/srv/aphrody-build/locks/heavy.lock",
  "remoteLogDir": "/srv/aphrody-build/artifacts/wsl",
  "remoteEnv": {
    "APHRODY_BUILD_HOST": "vps",
    "CARGO_INCREMENTAL": "0",
    "CARGO_NET_GIT_FETCH_WITH_CLI": "true",
    "SCCACHE_DIR": "/srv/aphrody-build/cache/sccache",
    "BUN_INSTALL_CACHE_DIR": "/srv/aphrody-build/cache/bun",
    "CEF_PATH": "/srv/aphrody-build/cache/cef"
  },
  "jobs": 6,
  "desktopSysCrates": ["gdk4-sys", "gtk4-sys"],
  "forwards": {
    "remote": [
      {
        "bind": "127.0.0.1:19418",
        "to": "127.0.0.1:9418",
        "purpose": "Factory fetches the selected worktree snapshot through the reverse Git forward; no WSL dependency."
      }
    ],
    "local": []
  },
  "gitDaemon": {
    "listen": "127.0.0.1",
    "port": 9418,
    "basePath": "",
    "repository": ""
  },
  "snapshotRef": "refs/workspace/snapshot",
  "repositories": {
    "vu": {
      "root": "../vu",
      "remoteWorkspace": "/srv/aphrody-build/workspaces/vu-wsl",
      "remoteTargetDir": "/srv/aphrody-build/cache/cargo/vu-wsl",
      "snapshotRef": "refs/vu/snapshot",
      "cargoSerial": "/srv/aphrody-build/workspaces/aphrody-wsl/scripts/build/rust/cargo-serial.sh"
    },
    "shenron": {
      "root": "../shenron",
      "remoteWorkspace": "/srv/aphrody-build/workspaces/shenron-wsl",
      "remoteSeed": "",
      "remoteTargetDir": "/srv/aphrody-build/cache/cargo/shenron-wsl",
      "snapshotRef": "refs/shenron/snapshot",
      "cargoSerial": "/srv/aphrody-build/workspaces/aphrody-wsl/scripts/build/rust/cargo-serial.sh"
    },
    "shenron-release": {
      "root": "../shenron",
      "remoteWorkspace": "/srv/aphrody-build/workspaces/shenron-wsl",
      "remoteSeed": "",
      "remoteTargetDir": "/srv/aphrody-build/cache/cargo/shenron-wsl",
      "snapshotRef": "refs/shenron/snapshot",
      "cargoSerial": "/srv/aphrody-build/workspaces/aphrody-wsl/scripts/build/rust/cargo-serial.sh"
    },
    "shenron-omar": {
      "root": "../shenron",
      "remoteWorkspace": "/srv/aphrody-build/workspaces/shenron-wsl",
      "remoteSeed": "",
      "remoteTargetDir": "/srv/aphrody-build/cache/cargo/shenron-wsl",
      "snapshotRef": "refs/shenron/snapshot",
      "cargoSerial": "/srv/aphrody-build/workspaces/aphrody-wsl/scripts/build/rust/cargo-serial.sh"
    }
  },
  "refuseSnapshotPaths": [
    "(^|/)\\.env(\\..*)?$",
    "\\.(pem|key|p12|pfx)$",
    "(^|/)id_(rsa|ed25519|ecdsa)(\\.pub)?$",
    "(^|/)credentials(\\.json)?$",
    "(^|/)secrets?\\.(json|toml|ya?ml)$"
  ],
  "hosts": {
    "dbfr": {
      "host": "dbfr",
      "controlPath": "~/.ssh/cm/dbfr-cargo",
      "localSession": "dbfr-tunnel",
      "remoteSession": "dbfr-cargo",
      "remoteWorkspace": "/home/ubuntu/aphrody-build/workspaces/aphrody-wsl",
      "remoteSeed": "",
      "remoteTargetDir": "/home/ubuntu/aphrody-build/cache/cargo/aphrody-wsl",
      "remoteLockDir": "/home/ubuntu/aphrody-build/locks",
      "remoteHeavyLock": "/home/ubuntu/aphrody-build/locks/heavy.lock",
      "remoteLogDir": "/home/ubuntu/aphrody-build/artifacts/wsl",
      "desktopLibraries": false,
      "jobs": 3,
      "maxJobs": 3,
      "remoteEnv": {
        "SCCACHE_DIR": "/home/ubuntu/aphrody-build/cache/sccache",
        "BUN_INSTALL_CACHE_DIR": "/home/ubuntu/aphrody-build/cache/bun",
        "SCCACHE_CACHE_SIZE": "8G",
        "APHRODY_BUILD_HOST": "dbfr",
        "CEF_PATH": ""
      }
    }
  }
}
