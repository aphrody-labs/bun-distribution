[Unit]
Description=Forward loopback Google US SOCKS to its private namespace
Requires=aphrody-google-us-loopback.socket aphrody-google-us-socks.service
After=aphrody-google-us-loopback.socket aphrody-google-us-socks.service
PartOf=aphrody-google-us-netns.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 10.200.2.2:1081
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=32M
TasksMax=16
