# SPDX-License-Identifier: Apache-2.0
Host bun-forge
    HostName gitea
    Port 22
    User git
    HostKeyAlias bun-forge
    IdentityFile /run/aphrody/git-ssh/identity
    IdentitiesOnly yes
    BatchMode yes
    ConnectTimeout 15
    ConnectionAttempts 1
    StrictHostKeyChecking yes
    HostKeyAlgorithms ssh-ed25519
    UserKnownHostsFile /run/aphrody/git-ssh/known_hosts
    GlobalKnownHostsFile /dev/null
    UpdateHostKeys no
