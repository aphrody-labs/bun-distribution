# Public runtime contract. No token, JSON key, cookie or API key belongs here.
APHRODY_HOME=~/.aphrody
GOOGLE_CLOUD_PROJECT=aphrody
GCLOUD_PROJECT=aphrody
CLOUDSDK_CORE_PROJECT=aphrody
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
APHRODY_GCP_AUTH=adc-or-secret-manager
APHRODY_GCP_SECRET_PREFIX=aphrody/
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=aphrody-bot@aphrody.iam.gserviceaccount.com

# Leave unset: Google libraries resolve ADC from the native local store.
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
