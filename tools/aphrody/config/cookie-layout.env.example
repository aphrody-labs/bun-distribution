# Sanitized contract only. Never put cookie values in this file.
# Each host owns an independent browser session and must authenticate locally.
APHRODY_HOME_WINDOWS=%USERPROFILE%\\.aphrody
APHRODY_HOME_POSIX=$HOME/.aphrody
BXC_COOKIES_DIR_WINDOWS=%USERPROFILE%\\.aphrody\\cookies
BXC_COOKIES_DIR_WSL=$HOME/.aphrody/cookies
BXC_COOKIES_DIR_VPS=$HOME/.aphrody/cookies

# Home agents consume the directory contract, not individual cookie files.
APHRODY_COOKIE_STORE=bxc
APHRODY_COOKIE_POLICY=host-local-owner-only
