# Render the unit name with systemd-escape --path --suffix=mount
# for /home/ubuntu/build/apps/gitea/native-storage before installation.
[Unit]
Description=Aphrody Gitea native repository storage
Before=docker.service
RequiresMountsFor=/home/ubuntu/forge-storage/aphrody-labs-native

[Mount]
What=/home/ubuntu/forge-storage/aphrody-labs-native
Where=/home/ubuntu/build/apps/gitea/native-storage
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
