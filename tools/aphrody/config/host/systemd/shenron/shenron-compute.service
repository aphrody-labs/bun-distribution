# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron private Aphrody MCP and RAG compute bridge on DBFR
Requires=docker.service
After=docker.service network-online.target shenron-embed.service
Wants=network-online.target shenron-embed.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/shenron/shared/agent-home
Environment=APHRODY_HOME=/home/ubuntu/apps/shenron/shared/agent-home
Environment=HOME=/home/ubuntu
EnvironmentFile=/etc/aphrody/shenron-compute.env
ExecStart=/home/ubuntu/.local/bin/aphrody-mcp http --bind 127.0.0.1:8789
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/apps/shenron/shared/agent-home
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=2G
MemoryMax=3G
CPUWeight=50

[Install]
WantedBy=multi-user.target
