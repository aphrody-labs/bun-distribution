# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Shenron Cloudflare read-only reconciliation
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
WorkingDirectory=/home/ubuntu/.local/share/aphrody/cloudflare-cli/orchestration
Environment=CLOUDFLARE_OPS_STATE=/home/ubuntu/.local/state/aphrody/cloudflare
ExecStart=/home/ubuntu/.local/share/aphrody/cloudflare-cli/runtime/bun cloudflare-ops.ts reconcile --manifest /home/ubuntu/.config/aphrody/cloudflare/manifest.json
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.local/state/aphrody/cloudflare
[Install]
WantedBy=multi-user.target

