# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Renew scoped Shenron R2 S3 credential
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
Group=root
UMask=0077
LoadCredential=api-token:/etc/aphrody/cloudflare/api-token
Environment=CLOUDFLARE_API_TOKEN_FILE=/run/credentials/shenron-cloudflare-s3-renew.service/api-token
# Shenron issuer 59c80cf0d67c44837483623eff15be7e56b2afb3; SHA256 310007a22600a8a803e6b071b06dd71c90236e51cc3625934df9d6d240c9ade2.
ExecStart=/home/ubuntu/.local/share/aphrody/cloudflare-cli/runtime/bun /etc/aphrody/cloudflare/cli/s3-profile.ts renew --manifest /home/ubuntu/.config/aphrody/cloudflare/manifest.json --profile /etc/aphrody/cloudflare/shenron-s3.json --consumer-data-root /home/ubuntu/apps/shenron/shared/bot/data/source-pipeline --consumer-directory /home/ubuntu/apps/shenron/shared/bot/data/source-pipeline/credentials --consumer-uid 1000 --consumer-gid 1000 --apply
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/aphrody/cloudflare
ReadWritePaths=/home/ubuntu/apps/shenron/shared/bot/data/source-pipeline/credentials
