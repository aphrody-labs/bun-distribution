# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Six-hour private wiki proposal inventory and bounded transport recovery

[Timer]
OnBootSec=5min
OnUnitInactiveSec=6h
AccuracySec=1min
RandomizedDelaySec=120s
Persistent=true
Unit=shenron-wiki-proposals.service

[Install]
WantedBy=timers.target
