# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Private Bun JSON and GraphQL projections of the official Shenron timeline
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.aphrody/workspaces/dbfr/private/web
ExecStart=/home/ubuntu/.bun/bin/bun /home/ubuntu/.local/lib/aphrody/shenron/workspace.mjs timeline serve --output /home/ubuntu/.aphrody/workspaces/dbfr/private/web/timeline --port 8813
Restart=on-failure
RestartSec=10s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
