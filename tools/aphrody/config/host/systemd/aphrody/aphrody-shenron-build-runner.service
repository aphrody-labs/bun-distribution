[Unit]
Description=Aphrody VPS build factory runner for private Shenron releases
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/home/ubuntu/build/runners/shenron/.runner

[Service]
Type=simple
User=ubuntu
Group=aphrody
SupplementaryGroups=docker
WorkingDirectory=/home/ubuntu/build/runners/shenron
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/build/runners/shenron/run.sh
Restart=always
RestartSec=15
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
