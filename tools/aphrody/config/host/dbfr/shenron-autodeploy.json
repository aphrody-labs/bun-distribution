{
  "schemaVersion": 1,
  "repository": "aphrody-labs/shenron",
  "branch": "main",
  "checkout": "/home/ubuntu/src/shenron",
  "runtimeDirectory": "/home/ubuntu/.config/shenron-autodeploy",
  "production": {
    "host": "dbfr",
    "syncUnit": "shenron-main-sync.service",
    "syncTimer": "shenron-main-sync.timer",
    "intervalSeconds": 120,
    "releaseRoot": "/home/ubuntu/apps/shenron",
    "services": ["site", "bot", "gateway"],
    "healthUrl": "https://dragonballfr.com/api/health"
  },
  "factory": {
    "host": "vps",
    "deployUnit": "shenron-main-deploy.service",
    "deployTimer": "shenron-main-deploy.timer",
    "intervalSeconds": 300,
    "worktree": "/home/ubuntu/build/transient/shenron-autodeploy",
    "lock": "/home/ubuntu/build/locks/heavy.lock"
  },
  "policy": {
    "sync": "clean-main-fast-forward-only",
    "release": "qualified-immutable-image",
    "retainTransferArchives": false,
    "retainSuccessfulRollbackReceipts": false,
    "preserveProtectedStores": true
  },
  "retiredDbfrContainers": [
    "aphrody-prod",
    "aphrody-shenron-compute-1",
    "aphrody-mcp-http-1",
    "aphrody-jobs-worker-1",
    "aphrody-shenron-embed-1",
    "aphrody-downloads-1",
    "aphrody-bun-prod-1",
    "aphrody-bun-m3-qualification-m3-renderer-1",
    "aphrody-bun-m3-qualification-aphrody-site-1"
  ],
  "retiredDbfrUnits": [
    "aphrody-discord-ai-lab.service",
    "aphrody-discord-debate.service",
    "shenron-timeline-refresh.service",
    "shenron-timeline-refresh.timer"
  ],
  "retiredFactoryUserTimers": ["aphrody-deploy.timer"]
}
