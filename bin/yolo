#!/usr/bin/env bash
set -e
# `yolo mcp` skips the CLI dispatcher: its static imports cost ~7 ms of the ~22 ms startup.
if [ "${1:-}" = "mcp" ] && [ $# -eq 1 ]; then
  exec bun run "$(dirname "$0")/../packages/engine/yolo/src/mcp.ts"
fi
exec bun run "$(dirname "$0")/../packages/engine/yolo/src/index.ts" "$@"
