{
  "extends": [
    "./tsconfig.json",
    "@aphrody/m3-config/tsconfig.build.json"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "wrappers/**/*.ts",
    "transitions/**/*.ts",
    "transitions/**/*.tsx",
    "adaptive/**/*.ts",
    "state/**/*.ts",
    "adapters/**/*.ts",
    "data/**/*.ts",
    "data/**/*.tsx",
    "material-web-shims.d.ts"
  ],
  "exclude": [
    "node_modules",
    "generate.ts",
    "dist"
  ]
}
