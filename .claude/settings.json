{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Preparing the Aphrody cloud environment"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/dev/cloud-ssh.sh\"",
            "timeout": 30,
            "statusMessage": "SSH hosts"
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/dev/session-start.ts\"",
            "timeout": 30,
            "statusMessage": "Resuming open work"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@claude-plugins-official": true
  }
}
