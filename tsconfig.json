{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["@aphrody/bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/workspace/src/**/*.ts",
    "apps/desktop/**/*.ts",
    "scripts/**/*.ts",
    "packages/video/src/**/*.ts"
  ],
  "exclude": ["node_modules", "toolchains", "apps/desktop/dist", "apps/desktop/src-tauri"]
}
